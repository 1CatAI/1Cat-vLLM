+                i += 1
+                continue
+            if in_str and ord(c) < 0x20:
+                out.append(_esc_map.get(c, "\\u%04x" % ord(c)))
+                i += 1
+                continue
+            out.append(c)
+            i += 1
+        return "".join(out)
