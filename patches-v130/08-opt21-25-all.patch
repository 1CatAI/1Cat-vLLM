+            _pc = find_tool_properties(
+                self.tools, self.current_function_name or "",
+            )
+            _ps = _pc.get(partial_name, {})
+            _pt = extract_types_from_schema(_ps)
+            if _pt and "string" not in _pt:
+                return None
+
