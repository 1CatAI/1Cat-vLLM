+def test_uncanonicalized_format_keeps_original_projection_dispatch():
+    class Projection:
+        def __init__(self, source, kernel, offset):
+            self.source_type = source
+            self.kernel = kernel
+            self.offset = offset
+
+        def __call__(self, x):
+            return x + self.offset
