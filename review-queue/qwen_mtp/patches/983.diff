+            u,
+            kcache,
+            G,
+            q,
+            k,
+            v,
+            a,
+            b,
+            A_log,
+            dt_bias,
+            ids,
+            masks,
+            pending,
+            cu,
+            zero,
+            u,
+            kcache,
+            G,
+            K**-0.5,
+            3,
