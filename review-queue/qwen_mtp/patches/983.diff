+                k[region].view(8, H, K),
+                v[region].view(8, HV, V),
+                a[region],
+                b[region],
+                A_log,
+                dt_bias,
+                active[slot],
+                K**-0.5,
+            )
+            refs.append(ref.reshape(8, 1536))
+            active[slot] = states[accepted[j] - 1]
+        # Same factor tensors are legal here: previous acceptance is zero,
