+    )
+    zero = torch.zeros(8, device="cuda", dtype=torch.int32)
+    A_log = torch.randn(HV, device="cuda") * 0.1 - 2
+    dt_bias = torch.randn(HV, device="cuda", dtype=torch.float16) * 0.1
+    for step in range(3):
