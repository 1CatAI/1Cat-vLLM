+        x = tl.reshape(
+            tl.permute(
+                tl.reshape(x, (BLOCK_M, BLOCK_K // 16, 2, 2, 2, 2)),
+                (0, 4, 1, 2, 3, 5),
+            ),
+            (BLOCK_M, BLOCK_K),
+        )
