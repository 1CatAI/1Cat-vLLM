+        x,
+        fn,
+        partials,
+        partial_sqrsum,
+        num_tokens,
+        N=n,
+        K=k,
+        K_PER_SPLIT=k // _TC_PRENORM_SPLITS,
+        BLOCK_M=_TC_PRENORM_BLOCK_M,
+        BLOCK_N=_TC_PRENORM_BLOCK_N,
+        BLOCK_K=_TC_PRENORM_BLOCK_K,
+        K_BLOCKS_PER_STEP=_TC_PRENORM_K_BLOCKS_PER_STEP,
+        num_warps=_TC_PRENORM_WARPS,
+    )
