+    tl.store(
+        y_ptr + slot[:, None].to(tl.int64) * y_stride + columns[None, :],
+        _lanes_to_columns(acc, BLOCK_M, BLOCK_N).to(tl.float16),
+        mask=row_ok[:, None],
+    )
+
