+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+#include <torch/extension.h>
+#include <c10/cuda/CUDAGuard.h>
+#include <c10/cuda/CUDAException.h>
+#include <c10/cuda/CUDAStream.h>
+#include <cuda_runtime.h>
+
+void planned_raw(const uint4*, uint4*, const std::vector<int64_t>&, int*, int,
+                 int, int, int, int, cudaStream_t);
+struct Scope {
+  int old;
+  explicit Scope(int d) {
+    C10_CUDA_CHECK(cudaGetDevice(&old));
+    C10_CUDA_CHECK(cudaSetDevice(d));
+  }
+  ~Scope() { cudaSetDevice(old); }
+};
+std::tuple<int64_t, pybind11::bytes> allocate(int device, int64_t bytes) {
+  TORCH_CHECK(bytes > 0 && bytes <= 1024LL * 1024 * 1024);
+  Scope scope(device);
+  void* ptr;
+  C10_CUDA_CHECK(cudaMalloc(&ptr, bytes));
+  C10_CUDA_CHECK(cudaMemset(ptr, 0xff, bytes));
+  cudaIpcMemHandle_t handle;
+  C10_CUDA_CHECK(cudaIpcGetMemHandle(&handle, ptr));
+  return {(int64_t)ptr, pybind11::bytes((char*)&handle, sizeof(handle))};
+}
+int64_t open_handle(int device, pybind11::bytes value) {
+  Scope scope(device);
+  std::string raw = value;
+  TORCH_CHECK(raw.size() == sizeof(cudaIpcMemHandle_t));
+  cudaIpcMemHandle_t handle;
+  memcpy(&handle, raw.data(), sizeof(handle));
+  void* ptr;
+  C10_CUDA_CHECK(
+      cudaIpcOpenMemHandle(&ptr, handle, cudaIpcMemLazyEnablePeerAccess));
+  return (int64_t)ptr;
+}
+void release(int device, int64_t ptr, bool imported) {
+  Scope scope(device);
+  if (imported)
+    C10_CUDA_CHECK(cudaIpcCloseMemHandle((void*)ptr));
+  else
+    C10_CUDA_CHECK(cudaFree((void*)ptr));
+}
+void enable_peer(int device, int target) {
+  Scope scope(device);
+  auto status = cudaDeviceEnablePeerAccess(target, 0);
+  if (status == cudaErrorPeerAccessAlreadyEnabled) {
+    cudaGetLastError();
+    return;
+  }
+  C10_CUDA_CHECK(status);
+}
+void reset(int device, int64_t ptr, int64_t bytes) {
+  Scope scope(device);
+  C10_CUDA_CHECK(cudaMemset((void*)ptr, 0xff, bytes));
+}
+
+class Engine {
+  int device, candidate, threads, blocks, capacity;
+  std::vector<int> owned, devices;
+  std::vector<std::vector<int64_t>> pointers;
+  std::vector<torch::Tensor> flags;
+  std::vector<cudaStream_t> streams;
+  std::vector<cudaEvent_t> done;
+  cudaEvent_t ready = nullptr;
+
+ public:
+  Engine(int device_, std::vector<int> owned_, std::vector<int> devices_,
+         std::vector<std::vector<int64_t>> pointers_,
+         std::vector<torch::Tensor> flags_, int candidate_, int threads_,
+         int blocks_, int capacity_)
+      : device(device_),
+        candidate(candidate_),
+        threads(threads_),
+        blocks(blocks_),
+        capacity(capacity_),
+        owned(owned_),
+        devices(devices_),
+        pointers(pointers_),
+        flags(flags_) {
+    TORCH_CHECK(!owned.empty() && owned.size() == pointers.size() &&
+                owned.size() == flags.size());
+    TORCH_CHECK((threads == 64 || threads == 128 || threads == 256) &&
+                blocks >= 1 && blocks <= 32 && capacity > 0 &&
+                capacity % 16 == 0);
+    Scope scope(device);
+    C10_CUDA_CHECK(cudaEventCreateWithFlags(&ready, cudaEventDisableTiming));
+    for (size_t i = 0; i < owned.size(); ++i) {
+      int node = owned[i];
+      TORCH_CHECK(node >= 0 && node < (int)devices.size() &&
+                  pointers[i].size() == devices.size());
+      TORCH_CHECK(flags[i].is_cuda() &&
+                  flags[i].get_device() == devices[node] &&
+                  flags[i].scalar_type() == at::kInt &&
+                  flags[i].is_contiguous() && flags[i].numel() >= blocks);
+      Scope other(devices[node]);
+      cudaStream_t stream = nullptr;
+      cudaEvent_t event = nullptr;
+      if (devices[node] != device) {
+        C10_CUDA_CHECK(
+            cudaStreamCreateWithFlags(&stream, cudaStreamNonBlocking));
+        C10_CUDA_CHECK(
+            cudaEventCreateWithFlags(&event, cudaEventDisableTiming));
+      }
+      streams.push_back(stream);
+      done.push_back(event);
+    }
+  }
+  void run(torch::Tensor x, torch::Tensor out) {
+    TORCH_CHECK(x.is_cuda() && x.get_device() == device &&
+                out.device() == x.device() && x.scalar_type() == at::kHalf &&
+                out.scalar_type() == at::kHalf);
+    TORCH_CHECK(x.is_contiguous() && out.is_contiguous() &&
+                x.nbytes() == out.nbytes() && x.nbytes() > 0 &&
+                x.nbytes() <= capacity && x.nbytes() % 16 == 0);
+    TORCH_CHECK((uintptr_t)x.data_ptr() % 16 == 0 &&
+                (uintptr_t)out.data_ptr() % 16 == 0);
+    Scope scope(device);
+    auto main = c10::cuda::getCurrentCUDAStream(device).stream();
+    bool helpers = owned.size() > 1;
+    if (helpers) C10_CUDA_CHECK(cudaEventRecord(ready, main));
+    for (size_t i = 0; i < owned.size(); ++i) {
+      bool helper = devices[owned[i]] != device;
+      Scope other(devices[owned[i]]);
+      auto stream = helper ? streams[i] : main;
+      if (helper) C10_CUDA_CHECK(cudaStreamWaitEvent(stream, ready, 0));
+      planned_raw(helper ? nullptr : (const uint4*)x.data_ptr(),
+                  helper ? nullptr : (uint4*)out.data_ptr(), pointers[i],
+                  (int*)flags[i].data_ptr(), candidate, owned[i], threads,
+                  blocks, x.nbytes() / 16, stream);
+      C10_CUDA_KERNEL_LAUNCH_CHECK();
+      if (helper) C10_CUDA_CHECK(cudaEventRecord(done[i], stream));
+    }
+    if (helpers)
+      for (auto event : done)
+        if (event) C10_CUDA_CHECK(cudaStreamWaitEvent(main, event, 0));
+  }
+  void close() {
+    if (!ready) return;
+    Scope scope(device);
+    C10_CUDA_CHECK(cudaEventDestroy(ready));
+    ready = nullptr;
+    for (size_t i = 0; i < owned.size(); ++i)
+      if (streams[i]) {
+        Scope other(devices[owned[i]]);
+        C10_CUDA_CHECK(cudaStreamDestroy(streams[i]));
+        C10_CUDA_CHECK(cudaEventDestroy(done[i]));
+        streams[i] = nullptr;
+      }
+  }
+  ~Engine() {
+    try {
+      close();
+    } catch (...) {
+    }
+  }
+};
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+  m.def("allocate", &allocate);
+  m.def("open_handle", &open_handle);
+  m.def("release", &release);
+  m.def("enable_peer", &enable_peer);
+  m.def("reset", &reset);
+  pybind11::class_<Engine>(m, "Engine", pybind11::module_local())
+      .def(pybind11::init<int, std::vector<int>, std::vector<int>,
+                          std::vector<std::vector<int64_t>>,
+                          std::vector<torch::Tensor>, int, int, int, int>())
+      .def("run", &Engine::run)
+      .def("close", &Engine::close);
+}
diff --git a/vllm/distributed/device_communicators/topology_all_reduce/planner_probe.py b/vllm/distributed/device_communicators/topology_all_reduce/planner_probe.py
new file mode 100644
index 0000000000..65da068528
--- /dev/null
+++ b/vllm/distributed/device_communicators/topology_all_reduce/planner_probe.py
@@ -0,0 +1,171 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+"""Driver-only topology discovery for the general planner; no CUDA contexts."""
+
+import subprocess
+
+import regex as re
+
+from .collective_planner import Topology, from_probe
+
+
+def matrix(text):
+    text = re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", text)
+    rows = {}
+    header = None
+    for line in text.splitlines():
+        fields = line.split()
+        if not fields:
+            continue
+        gpu = [int(v[3:]) for v in fields if re.fullmatch(r"GPU\d+", v)]
+        if len(gpu) > 1 or len(gpu) == 1 and len(fields) == 1:
+            header = gpu
+            continue
+        if re.fullmatch(r"GPU\d+", fields[0]) and len(fields) > 1:
+            rows[int(fields[0][3:])] = fields[1:]
+    nodes = header or list(rows)
+    if not 1 <= len(nodes) <= 64 or set(nodes) != set(rows):
+        raise ValueError("Unknown/truncated physical GPU matrix")
+    if any(len(rows[node]) < len(nodes) for node in nodes):
+        raise ValueError("Truncated GPU row")
+    return nodes, {(a, b): rows[a][j] for a in nodes for j, b in enumerate(nodes)}
+
+
+def from_text(topology, read, write, hardware="", profiles=None):
+    nodes, labels = matrix(topology)
+    rnodes, reads = matrix(read)
+    wnodes, writes = matrix(write)
+    if nodes != rnodes or nodes != wnodes:
+        raise ValueError("Driver matrices disagree")
+    normalized = "\t" + "\t".join(f"GPU{i}" for i in range(len(nodes))) + "\n"
+    normalized += "\n".join(
+        "GPU" + str(i) + "\t" + "\t".join(labels[a, b] for b in nodes)
+        for i, a in enumerate(nodes)
+    )
+    record = dict(
+        topology=normalized,
+        peer_read=[[reads[a, b] for b in nodes] for a in nodes],
+        peer_write=[[writes[a, b] for b in nodes] for a in nodes],
+    )
+    converted = None
+    if profiles:
+        converted = dict(
+            profiles,
+            edges=[
+                dict(e, source=nodes.index(e["source"]), dest=nodes.index(e["dest"]))
+                for e in profiles.get("edges", [])
+                if e["source"] in nodes and e["dest"] in nodes
+            ],
+        )
+    base = from_probe(record, converted, identity=dict(hardware=hardware))
+    edges = [
+        dict(e, source=nodes[e["source"]], dest=nodes[e["dest"]]) for e in base.edges
+    ]
+    # Initial PCIe throughput follows negotiated generation/width, rather than
+    # carrying an x8 Gen3 estimate onto every other machine.
+    rates = {
+        1: 250.0,
+        2: 500.0,
+        3: 984.6153846,
+        4: 1969.230769,
+        5: 3938.461538,
+        6: 7562.5,
+    }
+    ports = {}
+    for line in hardware.splitlines():
+        fields = [v.strip() for v in line.split(",")]
+        try:
+            if len(fields) >= 6:
+                ports[int(fields[0])] = rates[int(fields[-2])] * int(fields[-1]) * 0.74
+        except (ValueError, KeyError):
+            continue
+    overrides = {(e["source"], e["dest"]): e for e in (profiles or {}).get("edges", [])}
+    for edge in edges:
+        a, b = edge["source"], edge["dest"]
+        if (
+            not edge["transport"].startswith("NV")
+            and a in ports
+            and b in ports
+            and "bytes_per_us" not in overrides.get((a, b), {})
+        ):
+            edge["bytes_per_us"] = min(ports[a], ports[b])
+    for i, node in enumerate(nodes):
+        for key in (f"pcie-tx-{i}", f"pcie-rx-{i}"):
+            if (
+                node in ports
+                and key in base.resources
+                and key not in (profiles or {}).get("resources", {})
+            ):
+                base.resources[key]["bytes_per_us"] = ports[node]
+    return Topology(
+        nodes,
+        edges,
+        base.resources,
+        dict(base.identity, driver_topology=topology, peer_read=read, peer_write=write),
+    )
+
+
+def discover(profiles=None):
+    def query(*args):
+        return subprocess.check_output(["nvidia-smi", *args], text=True, timeout=15)
+
+    return from_text(
+        query("topo", "-m"),
+        query("topo", "-p2p", "r"),
+        query("topo", "-p2p", "w"),
+        query(
+            "--query-gpu=index,uuid,pci.bus_id,driver_version,pcie.link.gen.current,pcie.link.width.current",
+            "--format=csv,noheader",
+        ),
+        profiles,
+    )
+
+
+def refresh(previous):
+    """Reprobe before using a cached decision; discard stale physical profiles."""
+    live = discover()
+    if previous is None:
+        return live
+    same_hardware = previous.identity.get("hardware") == live.identity["hardware"]
+    explicit_unbound = (
+        not previous.identity.get("hardware")
+        and previous.identity.get("cost_origin") != "explicit-initial-estimates"
+    )
+    if live.labels == previous.labels and (same_hardware or explicit_unbound):
+        # Preserve explicit current-link costs/capacity models, but incorporate
+        # fresh driver graph and hardware identity in the selection key.
+        identity = dict(previous.identity, **live.identity)
+        identity["cost_origin"] = previous.identity.get(
+            "cost_origin", live.identity["cost_origin"]
+        )
+        return Topology(live.nodes, previous.edges, previous.resources, identity)
+    return live
+
+
+def visible_devices():
+    """Map actual CUDA ordinals by UUID, including reordered UUID environments."""
+    import torch
+
+    raw = subprocess.check_output(
+        ["nvidia-smi", "--query-gpu=index,uuid", "--format=csv,noheader"],
+        text=True,
+        timeout=15,
+    )
+    by_uuid = {
+        uuid.strip().lower().removeprefix("gpu-"): int(index)
+        for index, uuid in (line.split(",", 1) for line in raw.splitlines())
+    }
+    result = []
+    for logical in range(torch.accelerator.device_count()):
+        uuid = (
+            str(torch.cuda.get_device_properties(logical).uuid)
+            .lower()
+            .removeprefix("gpu-")
+        )
+        if uuid not in by_uuid:
+            raise ValueError(
+                "CUDA UUID does not map to a physical GPU; MIG requires its own backend"
+            )
+        result.append(by_uuid[uuid])
+    return result
