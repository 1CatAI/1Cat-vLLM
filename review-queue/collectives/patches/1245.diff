+def table(nodes, diagonal, off):
+    return (
+        "\t"
+        + "\t".join("GPU" + str(n) for n in nodes)
+        + "\n"
+        + "\n".join(
+            "GPU"
+            + str(a)
+            + "\t"
+            + "\t".join(diagonal if a == b else off for b in nodes)
+            for a in nodes
+        )
+    )
