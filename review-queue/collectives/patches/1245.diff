+
+class ProbeTests(unittest.TestCase):
+    def test_nonconsecutive_ids_and_more_than_eight_cards(self):
+        for nodes in ([0, 3, 11], list(range(12))):
+            topo = from_text(
+                table(nodes, "X", "NV2"),
+                table(nodes, "X", "OK"),
+                table(nodes, "X", "OK"),
