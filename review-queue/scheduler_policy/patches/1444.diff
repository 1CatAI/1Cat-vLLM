+    def _get_retention_seconds(self) -> float:
+        """Retention for warm blocks at the current pressure, in seconds.
+
+        Lower pressure retains longer; at >= 80% this returns 0, meaning
+        reclaim immediately.
+        Same accounting as `get_usage`: allocated plus warm both count as used.
+        """
+        total = self.num_gpu_blocks - 1  # exclude the null block
+        free = self.free_block_queue.num_free_blocks
+        warm = len(self.warm_blocks)
+        allocated = max(total - free - warm, 0)
+        usage = (allocated + warm) / max(total, 1)
+
+        for threshold, retention in self._retention_tiers:
+            if usage < threshold:
+                return float(retention)
+        return 0.0
