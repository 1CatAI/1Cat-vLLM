+    )
+    assert (
+        qsa_ops.qsa_dcp_grouped_page4_config_reason(
+            sharded=True,
+            query_heads=heads,
+            kv_heads=1,
+            head_dim=256,
+            dtype=torch.float16,
+            kv_cache_dtype=cache,
+            selection_width=2051,
+            max_rows=8192,
+        )
