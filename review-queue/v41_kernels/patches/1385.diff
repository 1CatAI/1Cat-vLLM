+    else if (gtype == 17)
+      V41K_GUD(17);
+    else
+      V41K_GUD(29);
+#undef V41K_GUD
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+    return;
+  }
+#define V41K_GUF(T)                                                          \
+  v41k_gate_up_fast_launch<T>(grid, i8(hq), hd.data_ptr<float>(), i8(xq),    \
+                              xd.data_ptr<float>(), prob.data_ptr<float>(),  \
+                              gate.data_ptr<uint8_t>(), up.data_ptr<uint8_t>(), \
+                              int(gate.size(2)), b, pl, stream)
