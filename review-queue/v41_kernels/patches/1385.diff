+// Host shim: runs CUDA kernel source as one std::thread per CUDA thread.
+// CTAs run one at a time, so `__shared__` = function-local static.
+#pragma once
+#include <atomic>
+#include <barrier>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
