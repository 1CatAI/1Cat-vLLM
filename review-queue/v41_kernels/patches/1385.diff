@@ -0,0 +1,240 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""GPU check for VLLM_V41_PLAN_FUSE (one GPU, synthetic inputs).
+
+Today:    q8_aligned  -> gate_up7  (gate_up7 launches moe_plan, then gate/up)
+Fused:    q8_plan     -> gate_up7p (q8_plan builds the plan in grid row 0)
+
+1. Bit equality, M = 1..6 (6 routes per row): the whole 512-int plan buffer
+   (both prefilled with the same garbage, so untouched entries count too),
+   xq/xd, and the gate/up outputs hq/hd. Route mixes: random experts from
+   pools of 6..384 (many repeats across rows), dropped routes (id -1, as the
+   expert prune or a truncated verify position writes them), one expert in
+   every row, and all routes dropped.
+2. Time per layer inside a CUDA graph (``--reps`` layers per replay) for
+   q8 + gate/up both ways, and the q8 launch alone both ways.
+
+Synthetic data only. Needs a v41k.so built from this tree (q8_plan and
+gate_up7p); pass it with --lib or VLLM_V41K_LIB. Exit status 1 on any
+difference.
+
+    python benchmarks/deepseek_v41/plan_fuse_check.py --lib /path/v41k.so
+"""
+
+import argparse
+import json
+import os
+import sys
+
+import torch
+
+E, ROWS, K_DIM, TOP_K = 384, 576, 5120, 6
+# bytes per 256-weight block: IQ2_XXS 66, IQ2_XS 74, IQ1_M 56
+BLOCK_BYTES = {16: 66, 17: 74, 29: 56}
+
+
+def _library(path):
+    if not path:
+        here = os.path.dirname(os.path.abspath(__file__))
+        path = os.path.join(here, "v41k", "build", "v41k.so")
+    torch.ops.load_library(path)
+    for op in ("q8_aligned", "gate_up7", "q8_plan", "gate_up7p", "table"):
+        if not hasattr(torch.ops.v41k, op):
+            sys.exit(f"{path} has no v41k.{op}; rebuild it from this tree")
+    return path
+
+
+def _ids(m, trial, g, dev):
+    routes = m * TOP_K
+    kind = trial % 6
+    if kind == 4:  # one expert in every row
+        ids = torch.arange(TOP_K, device=dev).repeat(m) + 7
+    elif kind == 5 and trial % 12 == 11:  # everything dropped
+        return torch.full((routes,), -1, dtype=torch.int32, device=dev)
+    else:
+        pool = (6, 8, 12, 24, 96, E)[(trial // 6) % 6]
+        perm = torch.randperm(E, device=dev, generator=g)[:pool]
+        ids = torch.stack(
+            [
+                perm[torch.randperm(pool, device=dev, generator=g)[:TOP_K]]
+                for _ in range(m)
+            ]
+        ).flatten()
+    ids = ids.to(torch.int32)
+    if kind in (1, 3, 5):  # drop the lowest-weight routes of some rows
+        view = ids.view(m, TOP_K)
+        for r in range(m):
+            keep = int(torch.randint(1, TOP_K + 1, (1,), device=dev, generator=g))
+            view[r, keep:] = -1
+    return ids.contiguous()
+
+
+def _weights(gtype, g, dev):
+    stride = K_DIM // 256 * BLOCK_BYTES[gtype]
+
+    # Bytes 0..59: every fp16 scale these bytes can form is finite and below 1.
+    def one():
+        return torch.randint(
+            0, 60, (E, ROWS, stride), dtype=torch.uint8, device=dev, generator=g
+        )
+
+    return one(), one()
+
+
+class Layer:
+    def __init__(self, m, ids, x, prob, gate, up, gtype, book, garbage):
+        dev = x.device
+        routes = m * TOP_K
+        self.args = (ids, prob, gate, up, gtype, book)
+        self.x = x
+        self.xq = torch.zeros((m, 160, 32), dtype=torch.int8, device=dev)
+        self.xd = torch.zeros((m, 160), dtype=torch.float32, device=dev)
+        self.hq = torch.zeros((routes, 18, 32), dtype=torch.int8, device=dev)
+        self.hd = torch.zeros((routes, 18), dtype=torch.float32, device=dev)
+        self.plan = garbage.clone()
+
+    def today(self):
+        ids, prob, gate, up, gtype, book = self.args
+        torch.ops.v41k.q8_aligned(self.xq, self.xd, self.x)
+        torch.ops.v41k.gate_up7(
+            self.xq,
+            self.xd,
+            self.hq,
+            self.hd,
+            ids,
+            prob,
+            gate,
+            up,
+            gtype,
+            book,
+            self.plan,
+        )
+
+    def fused(self):
+        ids, prob, gate, up, gtype, book = self.args
+        torch.ops.v41k.q8_plan(self.xq, self.xd, self.x, ids, self.plan)
+        torch.ops.v41k.gate_up7p(
+            self.xq,
+            self.xd,
+            self.hq,
+            self.hd,
+            ids,
+            prob,
+            gate,
+            up,
+            gtype,
+            book,
+            self.plan,
+        )
+
+    def q8_today(self):
+        torch.ops.v41k.q8_aligned(self.xq, self.xd, self.x)
+
+    def q8_fused(self):
+        ids = self.args[0]
+        torch.ops.v41k.q8_plan(self.xq, self.xd, self.x, ids, self.plan)
+
+
+def _same(a, b):
+    if a.dtype == torch.float32:
+        a, b = a.view(torch.int32), b.view(torch.int32)
+    return torch.equal(a, b)
+
+
+def _graph_us(fn, reps):
+    fn()
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        for _ in range(reps):
+            fn()
+    graph.replay()
+    torch.cuda.synchronize()
+    start, end = torch.cuda.Event(True), torch.cuda.Event(True)
+    best = float("inf")
+    for _ in range(5):
+        start.record()
+        graph.replay()
+        end.record()
+        torch.cuda.synchronize()
+        best = min(best, start.elapsed_time(end) * 1000.0 / reps)
+    return best
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--lib", default=os.environ.get("VLLM_V41K_LIB", ""))
+    ap.add_argument("--gtype", type=int, default=16, choices=sorted(BLOCK_BYTES))
+    ap.add_argument("--trials", type=int, default=300)
+    ap.add_argument("--reps", type=int, default=100)
+    ap.add_argument("--seed", type=int, default=0)
+    ap.add_argument("--no-time", action="store_true", help="bit checks only")
+    args = ap.parse_args()
+    lib = _library(args.lib)
+    dev = torch.device("cuda")
+    g = torch.Generator(device=dev).manual_seed(args.seed)
+    gate, up = _weights(args.gtype, g, dev)
+    book = torch.ops.v41k.table(args.gtype, dev)
+    report = {"lib": os.path.basename(lib), "gtype": args.gtype, "mismatch": {}}
+    report["us"] = {}
+    bad = 0
+    for m in range(1, 7):
+        miss = {"plan": 0, "xq_xd": 0, "hq_hd": 0}
+        finite = 0
+        for trial in range(args.trials):
+            ids = _ids(m, trial, g, dev)
+            x = torch.randn(m, K_DIM, device=dev, generator=g).half()
+            prob = torch.rand(m, TOP_K, device=dev, generator=g)
+            garbage = torch.randint(
+                -(2**31),
+                2**31 - 1,
+                (512,),
+                dtype=torch.int32,
+                device=dev,
+                generator=g,
+            )
+            a = Layer(m, ids, x, prob, gate, up, args.gtype, book, garbage)
+            b = Layer(m, ids, x, prob, gate, up, args.gtype, book, garbage)
+            a.today()
+            b.fused()
+            miss["plan"] += int(not _same(a.plan, b.plan))
+            miss["xq_xd"] += int(not (_same(a.xq, b.xq) and _same(a.xd, b.xd)))
+            miss["hq_hd"] += int(not (_same(a.hq, b.hq) and _same(a.hd, b.hd)))
+            finite += int(torch.isfinite(a.hd).all())
+        bad += sum(miss.values())
+        # Synthetic weights keep every fp16 scale finite, so a non-finite hd is a
+        # kernel fault; gate it separately (it is a count of good trials).
+        bad += int(finite != args.trials)
+        report["mismatch"][f"M{m}"] = dict(miss, hd_all_finite_trials=finite)
+        if args.no_time:
+            continue
+        ids = _ids(m, 0, g, dev)
+        x = torch.randn(m, K_DIM, device=dev, generator=g).half()
+        prob = torch.rand(m, TOP_K, device=dev, generator=g)
+        lay = Layer(
+            m,
+            ids,
+            x,
+            prob,
+            gate,
+            up,
+            args.gtype,
+            book,
+            torch.zeros(512, dtype=torch.int32, device=dev),
+        )
+        us = {
+            "q8_aligned+gate_up7": _graph_us(lay.today, args.reps),
+            "q8_plan+gate_up7p": _graph_us(lay.fused, args.reps),
+            "q8_aligned": _graph_us(lay.q8_today, args.reps),
+            "q8_plan": _graph_us(lay.q8_fused, args.reps),
+        }
+        us["saved_per_layer"] = us["q8_aligned+gate_up7"] - us["q8_plan+gate_up7p"]
+        report["us"][f"M{m}"] = {k: round(v, 2) for k, v in us.items()}
+    report["trials_per_m"] = args.trials
+    report["ok"] = bad == 0
+    print(json.dumps(report, indent=1))
+    return 0 if bad == 0 else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/benchmarks/deepseek_v41/v41k/emu/dectest.cpp b/benchmarks/deepseek_v41/v41k/emu/dectest.cpp
new file mode 100644
index 0000000000..318a14f67a
--- /dev/null
+++ b/benchmarks/deepseek_v41/v41k/emu/dectest.cpp
@@ -0,0 +1,128 @@
+// Exhaustive decode check: old Group3<T> (verbatim, shared byte codebook) vs the
+// new PRMT-selector decode (dec16/dec17/dec29 over the replicated fast table).
+// Build as emu.cpp (same flags), run with no arguments; exit 1 on a mismatch.
+#include "shim.h"
+#include <cstdio>
+#include <random>
+#include "src/turbomind/kernels/gemm/lattice_codebooks.h"
+#define __CUDACC__ 1
+#include "v41k_fast.cuh"
+#include "old_extract.inc"
+
+template <class F> void run_serial(int grid, int block, F f) {
+  blockDim.x = block; gridDim.x = grid;
+  for (int b = 0; b < grid; ++b) for (int t = 0; t < block; ++t) { blockIdx.x = b; threadIdx.x = t; f(); }
+}
+template <int T> std::vector<uint32_t> old_book() {
+  const int words = turbomind::gemm::LatticeCodebook<T>::kBytes / 4;
+  std::vector<uint32_t> b(words);
+  run_serial((words + 255) / 256, 256, [&] { v41k::build_table<T>(b.data(), words); });
+  return b;
+}
+template <int T> std::vector<uint32_t> smem_book() {  // fast table, then fill_book's layout
+  using FB = v41k_fast::FastBook<T>;
+  std::vector<uint32_t> g(FB::kWords), s(FB::kSmemWords);
+  run_serial((FB::kWords + 255) / 256, 256, [&] { v41k_fast::build_fast_table<T>(g.data()); });
+  for (int i = 0; i < FB::kSmemWords; ++i) {
+    int src = i;
+    if constexpr (T != 29) src = i < FB::kSignBase ? i / FB::kGridR : FB::kGrid + (i - FB::kSignBase) / FB::kSignR;
+    s[i] = g[src];
+  }
+  return s;
+}
+
+template <int T>
+long check(const uint8_t* blk, int sub, int lane, const uint32_t* ob, const uint32_t* sb, long& n) {
+  uint32_t masks[16];
+  for (int i = 0; i < 16; ++i) masks[i] = sign_mask(i);
+  const v41k::Group3<T> g(blk, sub, ob, masks);
+  uint32_t w[8];
+  int m0, m1;
+  float d;
+  if constexpr (T == 29) {
+    uint32_t qs, s01, s23;
+    uint16_t qh;
+    std::memcpy(&qs, blk + 4 * sub, 4);
+    std::memcpy(&qh, blk + 32 + 2 * sub, 2);
+    std::memcpy(&s01, blk + 48, 4);
+    std::memcpy(&s23, blk + 52, 4);
+    v41k_fast::dec29(qs, qh, s01, s23, sub, sb, w, m0, m1);
+    d = __half2float(__ushort_as_half(v41k_fast::iq1m_d_bits(s01, s23)));
+  } else {
+    uint32_t w0, w1;
+    uint16_t dh;
+    std::memcpy(&w0, blk + 2 + 8 * sub, 4);
+    std::memcpy(&w1, blk + 6 + 8 * sub, 4);
+    std::memcpy(&dh, blk, 2);
+    const uint32_t lg = uint32_t(lane) * 4, ls = uint32_t(lane & 15) * 4;
+    if constexpr (T == 16) v41k_fast::dec16(w0, w1, sb, lg, ls, w, m0, m1);
+    else v41k_fast::dec17(w0, w1, blk[66 + sub], sb, ls, w, m0, m1);
+    d = __half2float(__ushort_as_half(dh));
+  }
+  ++n;
+  long bad = 0;
+  for (int i = 0; i < 8; ++i) bad += w[i] != g.w[i];
+  bad += m0 != g.m0 || m1 != g.m1;
+  uint32_t a, b;
+  std::memcpy(&a, &d, 4);
+  std::memcpy(&b, &g.d, 4);
+  bad += a != b;
+  return bad;
+}
+
+template <int T> long run(std::mt19937& rng, long& n) {
+  constexpr int BB = T == 16 ? 66 : T == 17 ? 74 : 56;
+  const auto ob = old_book<T>();
+  const auto sb = smem_book<T>();
+  alignas(16) uint8_t blk[BB + 16];
+  long bad = 0;
+  const int codes = T == 16 ? 32768 : T == 17 ? 65536 : 4096;
+  for (int sub = 0; sub < 8; ++sub)
+    for (int i = 0; i < codes; ++i) {
+      for (auto& x : blk) x = uint8_t(rng());
+      // every octet position o sees every code as i runs (different offsets per o)
+      for (int o = 0; o < 4; ++o) {
+        const int c = (i + o * 7919) % codes;
+        if constexpr (T == 16) {
+          blk[2 + 8 * sub + o] = uint8_t(c & 255);
+          uint32_t meta;
+          std::memcpy(&meta, blk + 6 + 8 * sub, 4);
+          meta = (meta & ~(127u << (7 * o))) | (uint32_t(c >> 8) << (7 * o));
+          if (o == 3) meta = (meta & 0x0fffffffu) | (uint32_t(i & 15) << 28);
+          std::memcpy(blk + 6 + 8 * sub, &meta, 4);
+        } else if constexpr (T == 17) {
+          const uint16_t c16 = uint16_t(c);
+          std::memcpy(blk + 2 + 8 * sub + 2 * o, &c16, 2);
+          blk[66 + sub] = uint8_t(i & 255);
+        } else {
+          blk[4 * sub + o] = uint8_t(c & 255);
+          uint16_t qh;
+          std::memcpy(&qh, blk + 32 + 2 * sub, 2);
+          qh = uint16_t((qh & ~(15u << (4 * o))) | (uint32_t(c >> 8) << (4 * o)));
+          std::memcpy(blk + 32 + 2 * sub, &qh, 2);
+        }
+      }
+      bad += check<T>(blk, sub, int(rng() & 31), ob.data(), sb.data(), n);
+    }
+  if constexpr (T == 29)  // scale fields: every 16-bit value of each scale word, every sub
+    for (int word = 0; word < 4; ++word)
+      for (int v = 0; v < 65536; ++v) {
+        for (auto& x : blk) x = uint8_t(rng());
+        const uint16_t vv = uint16_t(v);
+        std::memcpy(blk + 48 + 2 * word, &vv, 2);
+        bad += check<T>(blk, v & 7, 0, ob.data(), sb.data(), n);
+      }
+  return bad;
+}
+
+int main() {
+  std::mt19937 rng(12345);
+  long total = 0;
+  for (int T : {16, 17, 29}) {
+    long n = 0;
+    const long bad = T == 16 ? run<16>(rng, n) : T == 17 ? run<17>(rng, n) : run<29>(rng, n);
+    std::printf("type %d: %ld sub-block decodes, %ld mismatching fields\n", T, n, bad);
+    total += bad;
+  }
+  return total ? 1 : 0;
+}
diff --git a/benchmarks/deepseek_v41/v41k/emu/diet_dectest.cpp b/benchmarks/deepseek_v41/v41k/emu/diet_dectest.cpp
new file mode 100644
index 0000000000..badc340ce7
--- /dev/null
+++ b/benchmarks/deepseek_v41/v41k/emu/diet_dectest.cpp
@@ -0,0 +1,103 @@
+// Single-threaded CPU check of the EXPERT_DIET decode pieces (v41k_diet.cuh)
+// against the EXPERT_FAST ones they replace (v41k_fast.cuh): exact integer
+// equality of every word / multiplier / scale and bitwise equality of the
+// float dot. No codebook needed (any table works: both index the same one).
+// From the repository root:
+//   g++ -std=c++20 -O2 -ffp-contract=off -Icsrc/sm70_turbomind/lmdeploy \
+//     -Ibenchmarks/deepseek_v41/v41k \
+//     -o /tmp/diet_dectest benchmarks/deepseek_v41/v41k/emu/diet_dectest.cpp
+//   /tmp/diet_dectest        (a few seconds; exit 1 on a mismatch)
+#include "shim.h"
+#include <cstdio>
+#include <random>
+#include "src/turbomind/kernels/gemm/lattice_codebooks.h"
+#define __CUDACC__ 1
+#define V41K_HOST_EMU 1
+#include "old_extract.inc"
+#include "v41k_fast.cuh"
+#include "v41k_diet.cuh"
+
+static long g_bad = 0;
+#define CHECK(c)                                                    \
+  do {                                                              \
+    if (!(c) && g_bad++ < 10) std::printf("FAIL %s:%d %s\n", __FILE__, __LINE__, #c); \
+  } while (0)
+
+int main() {
+  std::mt19937_64 rng(20261103);
+  // A random 4096-word IQ1_M selector table (dec29 and the diet lookup read
+  // the same words, so equality over a random table covers every index).
+  std::vector<uint32_t> book29(v41k_fast::FastBook<29>::kSmemWords);
+  for (auto& w : book29) w = uint32_t(rng());
+  long n = 0;
+
+  // d29_bits == iq1m_d_bits: a bit permutation; random + all single bits.
+  for (int i = 0; i < 4000000; ++i) {
+    const uint32_t a = uint32_t(rng()), b = uint32_t(rng());
+    CHECK((v41k_diet::d29_bits(a, b) & 0xFFFFu) == v41k_fast::iq1m_d_bits(a, b));
+    ++n;
+  }
+  for (int bit = 0; bit < 64; ++bit) {
+    const uint64_t x = uint64_t(1) << bit;
+    const uint32_t a = uint32_t(x), b = uint32_t(x >> 32);
+    CHECK((v41k_diet::d29_bits(a, b) & 0xFFFFu) == v41k_fast::iq1m_d_bits(a, b));
+    ++n;
+  }
+
+  // idx29 + dec29_words + m29 == dec29: every qh (16 bits) x random qs, all 8
+  // sub-blocks, random scale words.
+  for (uint32_t qh = 0; qh < 65536; ++qh)
+    for (int r = 0; r < 8; ++r) {
+      const uint32_t qs = uint32_t(rng()), s01 = uint32_t(rng()), s23 = uint32_t(rng());
+      const int sub = r;
+      uint32_t w0[8], w1[8];
+      int a0, a1, b0, b1;
+      v41k_fast::dec29(qs, qh, s01, s23, sub, book29.data(), w0, a0, a1);
+      uint32_t ia, ib;
+      v41k_diet::idx29(qs, qh, ia, ib);
+      v41k_diet::dec29_words(ia, ib, book29.data(), w1);
+      const uint32_t sh = uint32_t(((sub >> 1) & 1) * 16 + (sub & 1) * 6);
+      v41k_diet::m29(s01, s23, sub >= 4, sh, 1u, b0, b1);
+      for (int i = 0; i < 8; ++i) CHECK(w0[i] == w1[i]);
+      CHECK(a0 == b0);
+      CHECK(a1 == b1);
+      ++n;
+    }
+
+  // dot<false> == fast_dot always; dot<true> == fast_dot when m0 == m1 (the
+  // IQ2_XXS case), over random words / activations / scales / accumulators,
+  // including the extremes of the int8 ranges and the multiplier range 1..31.
+  for (int i = 0; i < 3000000; ++i) {
+    uint32_t w[8];
+    int q[8];
+    for (int j = 0; j < 8; ++j) {
+      w[j] = uint32_t(rng());
+      q[j] = int(uint32_t(rng()));
+      if (i % 7 == 0) {  // extremes
+        w[j] = (i & 8) ? 0x81818181u : 0x7F7F7F7Fu;
+        q[j] = (i & 16) ? int(0x80808080u) : 0x7F7F7F7F;
+      }
+    }
+    const int m0 = 1 + 2 * int(rng() % 16), m1 = 1 + 2 * int(rng() % 16);
+    float d, xd, acc;
+    const uint32_t bd = uint32_t(rng()), bx = uint32_t(rng()), ba = uint32_t(rng());
+    // finite, varied magnitudes: fp16-range d, small xd, any accumulator
+    d = float(int32_t(bd % 131072) - 65536) * 1e-5f;
+    xd = float(bx % 100000) * 9e-8f + 1e-4f;
+    acc = float(int32_t(ba % 2000001) - 1000000) * 1e-3f;
+    const float f0 = v41k_fast::fast_dot(w, q, d, xd, m0, m1, acc);
+    const float g0 = v41k_diet::dot<false>(w, q, d, xd, m0, m1, acc);
+    const float f1 = v41k_fast::fast_dot(w, q, d, xd, m0, m0, acc);
+    const float g1 = v41k_diet::dot<true>(w, q, d, xd, m0, m0, acc);
+    uint32_t u0, v0, u1, v1;
+    std::memcpy(&u0, &f0, 4);
+    std::memcpy(&v0, &g0, 4);
+    std::memcpy(&u1, &f1, 4);
+    std::memcpy(&v1, &g1, 4);
+    CHECK(u0 == v0);
+    CHECK(u1 == v1);
+    ++n;
+  }
+  std::printf("diet decode: %ld cases, %ld mismatches\n", n, g_bad);
+  return g_bad ? 1 : 0;
+}
diff --git a/benchmarks/deepseek_v41/v41k/emu/emu.cpp b/benchmarks/deepseek_v41/v41k/emu/emu.cpp
new file mode 100644
index 0000000000..394f9666d7
--- /dev/null
+++ b/benchmarks/deepseek_v41/v41k/emu/emu.cpp
@@ -0,0 +1,296 @@
+// CPU emulation, bitwise, on synthetic weights / route mixes: old
+// down_rows<T, NW, 8> vs new v41k_fast::down_rows_fast<T, M>, and old
+// gate_up_em5<T> (plan mode) vs new v41k_fast::gate_up_fast<T> (the old kernels
+// verbatim from the base commit, see extract_old.py / old_extract.inc).
+// Host-only (no GPU): each CUDA thread is a std::thread, CTAs run in shuffled
+// order, outputs are NaN-poisoned, the plan tail is stale garbage, and routes
+// no plan member names carry NaN hd scales. From the repository root:
+//   g++ -std=c++20 -O2 -ffp-contract=off -pthread \
+//     -Icsrc/sm70_turbomind/lmdeploy -Ibenchmarks/deepseek_v41/v41k \
+//     -o /tmp/emu benchmarks/deepseek_v41/v41k/emu/emu.cpp
+//   /tmp/emu <type 16|17|29> <m_lo> <m_hi> <kinds mask, 63 = all> <seed> [gu]
+// (gu: gate_up_em5 vs gate_up_fast; default: down_rows vs down_rows_fast)
+// prints one line per case and "... type T: N failing cases" (exit 1 if N > 0).
+#include "shim.h"
+#include <algorithm>
+#include <cstdio>
+#include <random>
+#include "src/turbomind/kernels/gemm/lattice_codebooks.h"
+#define __CUDACC__ 1
+#include "old_extract.inc"
+#include "v41k_fast_gu.cuh"
+
+constexpr int E = 64, RL = 1280;
+
+template <class F> void run_serial(int grid, int block, F f) {
+  blockDim.x = block; gridDim.x = grid;
+  for (int b = 0; b < grid; ++b) for (int t = 0; t < block; ++t) { blockIdx.x = b; threadIdx.x = t; f(); }
+}
+template <int T> std::vector<uint32_t> old_book() {
+  const int words = turbomind::gemm::LatticeCodebook<T>::kBytes / 4;
+  std::vector<uint32_t> b(words);
+  run_serial((words + 255) / 256, 256, [&] { v41k::build_table<T>(b.data(), words); });
+  return b;
+}
+template <int T> std::vector<uint32_t> fast_book() {
+  const int words = v41k_fast::FastBook<T>::kWords;
+  std::vector<uint32_t> b(words);
+  run_serial((words + 255) / 256, 256, [&] { v41k_fast::build_fast_table<T>(b.data()); });
+  return b;
+}
+
+std::vector<int> make_ids(int m, int kind, std::mt19937& rng) {
+  std::vector<int> ids(m * 6);
+  auto rnd = [&](int n) { return int(rng() % n); };
+  for (int k = 0; k < m; ++k) {
+    std::vector<int> row;
+    if (kind == 0) {  // distinct per row, random across rows
+      while ((int)row.size() < 6) { int e = rnd(E); if (std::find(row.begin(), row.end(), e) == row.end()) row.push_back(e); }
+    } else if (kind == 1) {  // pool of 8, distinct per row, drop a tail
+      while ((int)row.size() < 6) { int e = rnd(8) + 3; if (std::find(row.begin(), row.end(), e) == row.end()) row.push_back(e); }
+      for (int i = 6 - rnd(4); i < 6; ++i) row[i] = -1;
+    } else if (kind == 2) {  // pool of 3 with repeats inside a row (cnt caps at 6)
+      for (int i = 0; i < 6; ++i) row.push_back(rnd(3) + 20);
+    } else if (kind == 3) {  // one expert in every row
+      row.push_back(7);
+      while ((int)row.size() < 6) { int e = rnd(E); if (std::find(row.begin(), row.end(), e) == row.end()) row.push_back(e); }
+      std::shuffle(row.begin(), row.end(), rng);
+    } else if (kind == 4) {  // all dropped
+      row.assign(6, -1);
+    } else {  // pool of 12, some drops anywhere
+      while ((int)row.size() < 6) { int e = rnd(12) + 30; if (std::find(row.begin(), row.end(), e) == row.end()) row.push_back(e); }
+      for (int i = 0; i < 6; ++i) if (rnd(4) == 0) row[i] = -1;
+    }
+    for (int i = 0; i < 6; ++i) ids[k * 6 + i] = row[i];
+  }
+  return ids;
+}
+// moe_plan semantics (first-occurrence order, routes ascending, cnt capped at 6);
+// entries it does not write keep stale garbage.
+void make_plan(const std::vector<int>& ids, std::vector<int>& plan) {
+  std::vector<int> ex;
+  for (int r = 0; r < (int)ids.size(); ++r) {
+    const int e = ids[r];
+    if (e < 0) continue;
+    int u = int(std::find(ex.begin(), ex.end(), e) - ex.begin());
+    if (u == (int)ex.size()) { ex.push_back(e); plan[37 + u] = 0; }
+    plan[1 + u] = e;
+    int c = 0;
+    for (int q = 0; q < r; ++q) c += ids[q] == e;
+    if (c < 6) plan[73 + 6 * u + c] = r;
+    int cnt = 0;
+    for (int q = 0; q < (int)ids.size(); ++q) cnt += ids[q] == e;
+    plan[37 + u] = std::min(cnt, 6);
+  }
+  plan[0] = (int)ex.size();
+}
+
+template <int T> void fill_weights(std::vector<uint8_t>& w, int bb, std::mt19937& rng) {
+  for (auto& x : w) x = uint8_t(rng());
+  const size_t blocks = (w.size() - 64) / bb;
+  for (size_t b = 0; b < blocks; ++b) {
+    uint8_t* p = w.data() + b * bb;
+    const uint16_t dbits = uint16_t(0x1000 + rng() % 0x1800);  // ~2^-11 .. 2^-4, positive
+    if constexpr (T == 29) {
+      uint16_t s[4];
+      std::memcpy(s, p + 48, 8);
+      for (int i = 0; i < 4; ++i) s[i] = uint16_t((s[i] & 0x0fff) | (((dbits >> (4 * i)) & 15) << 12));
+      std::memcpy(p + 48, s, 8);
+    } else {
+      std::memcpy(p, &dbits, 2);
+    }
+  }
+}
+
+template <int T>
+int run_case(int m, int kind, int classes, uint64_t seed, const std::vector<uint32_t>& ob,
+             const std::vector<uint32_t>& fb, const std::vector<uint8_t>& down, bool verbose) {
+  constexpr int bb = T == 16 ? 66 : T == 17 ? 74 : 56;
+  std::mt19937 rng(seed);
+  const int routes = 6 * m, rs = (routes * 648 + 255) / 256 * 256;
+  const int rank = int(rng() % 4), row_base = rank * RL;
+  std::vector<int> ids = make_ids(m, kind, rng);
+  std::vector<int> plan(512);
+  for (auto& x : plan) x = 0x40000000 + int(rng() % 1000);  // stale garbage
+  make_plan(ids, plan);
+  std::vector<uint8_t> gathered(4 * rs);
+  for (int r = 0; r < 4; ++r) {
+    uint8_t* slot = gathered.data() + r * rs;
+    for (int i = 0; i < routes * 576; ++i) slot[i] = uint8_t(int8_t(int(rng() % 255) - 127));
+    float* hd = reinterpret_cast<float*>(slot + routes * 576);
+    for (int i = 0; i < routes * 18; ++i) hd[i] = 0.001f + float(rng() % 100000) * 5e-7f;
+  }
+  {  // routes no plan member names (dropped, or past the cnt cap): NaN scales
+    std::vector<char> used(routes, 0);
+    for (int u = 0; u < plan[0]; ++u)
+      for (int c = 0; c < plan[37 + u]; ++c) used[plan[73 + 6 * u + c]] = 1;
+    for (int r = 0; r < 4; ++r) {
+      float* hd = reinterpret_cast<float*>(gathered.data() + r * rs + routes * 576);
+      for (int q = 0; q < routes; ++q)
+        if (!used[q])
+          for (int i = 0; i < 18; ++i) hd[q * 18 + i] = __builtin_nanf("");
+    }
+  }
+  std::vector<half> o_old(m * 5120), o_new(m * 5120), o_dirty(m * 5120);
+  for (auto& h : o_old) h.x = 0x7e00;
+  for (auto& h : o_new) h.x = 0x7e00;
+  std::vector<int> ord_old(RL / 4), ord_new(RL / 16);
+  for (int i = 0; i < (int)ord_old.size(); ++i) ord_old[i] = i;
+  for (int i = 0; i < (int)ord_new.size(); ++i) ord_new[i] = i;
+  std::shuffle(ord_new.begin(), ord_new.end(), rng);
+  const int row_stride = 9 * bb;
+  auto old_k = [&] {
+    if (classes == 8)
+      v41k::down_rows<T, 8, 8>((half*)o_old.data(), gathered.data(), rs, down.data(), row_stride, RL, row_base,
+                               ob.data(), routes, 6, m, 4, plan.data());
+    else
+      v41k::down_rows<T, 4, 8>((half*)o_old.data(), gathered.data(), rs, down.data(), row_stride, RL, row_base,
+                               ob.data(), routes, 6, m, 4, plan.data());
+  };
+  emu_launch(RL / 4, 32 * classes, old_k, ord_old);
+  auto new_k = [&](half* out, const int* pl) {
+    switch (m) {
+#define C(M) case M: v41k_fast::down_rows_fast<T, M>(out, gathered.data(), down.data(), row_stride, RL, row_base, fb.data(), classes, pl); break;
+      C(1) C(2) C(3) C(4) C(5) C(6)
+#undef C
+    }
+  };
+  // Dirty the static "shared memory" with a different plan first.
+  {
+    std::vector<int> ids2 = make_ids(m, 0, rng), plan2 = plan;
+    make_plan(ids2, plan2);
+    emu_launch(RL / 16, 512, [&] { new_k(o_dirty.data(), plan2.data()); }, ord_new);
+  }
+  emu_launch(RL / 16, 512, [&] { new_k(o_new.data(), plan.data()); }, ord_new);
+  int bad = 0, nan = 0, nz = 0;
+  for (int i = 0; i < m * 5120; ++i) {
+    if (o_old[i].x != o_new[i].x) {
+      if (bad < 5 && verbose)
+        std::printf("  mismatch k=%d n=%d old=%04x new=%04x\n", i / 5120, i % 5120, o_old[i].x, o_new[i].x);
+      ++bad;
+    }
+    nan += (o_new[i].x & 0x7c00) == 0x7c00;
+    nz += o_new[i].x != 0;
+  }
+  std::printf("T=%d M=%d kind=%d classes=%d rank=%d nu=%d: mismatches=%d nan=%d nonzero=%d\n", T, m, kind,
+              classes, rank, plan[0], bad, nan, nz);
+  return bad + nan;
+}
+
+// gate/up: old gate_up_em5<T> (plan mode, grid 18 x routes) vs the persistent
+// gate_up_fast<T> on grids of 80, 13 and 3 CTAs; hq / hd prefilled with
+// garbage / NaN, compared whole (entries no member writes must stay as they
+// were in both).
+template <int T>
+int run_case_gu(int m, int kind, uint64_t seed, const std::vector<uint32_t>& ob,
+                const std::vector<uint32_t>& fb, const std::vector<uint8_t>& gate,
+                const std::vector<uint8_t>& up, bool verbose) {
+  constexpr int bb = T == 16 ? 66 : T == 17 ? 74 : 56;
+  std::mt19937 rng(seed);
+  const int routes = 6 * m, row_stride = 20 * bb;
+  std::vector<int> ids = make_ids(m, kind, rng);
+  std::vector<int> plan(512);
+  for (auto& x : plan) x = 0x40000000 + int(rng() % 1000);  // stale garbage
+  make_plan(ids, plan);
+  std::vector<int8_t> xq(m * 160 * 32);
+  std::vector<float> xd(m * 160), prob(routes);
+  for (auto& v : xq) v = int8_t(int(rng() % 255) - 127);
+  for (auto& v : xd) v = 0.001f + float(rng() % 100000) * 9e-8f;
+  for (auto& v : prob) v = float(rng() % 100000) * 1e-5f;
+  const int grids[3] = {80, 13, 3};
+  std::vector<int8_t> hq0(routes * 18 * 32);
+  for (auto& v : hq0) v = int8_t(rng());
+  std::vector<float> hd0(routes * 18, __builtin_nanf(""));
+  std::vector<int8_t> hq_old = hq0;
+  std::vector<float> hd_old = hd0;
+  std::vector<int> ord_old(18 * routes);
+  for (int i = 0; i < (int)ord_old.size(); ++i) ord_old[i] = i;
+  std::shuffle(ord_old.begin(), ord_old.end(), rng);
+  emu_launch2(18, routes, 512, [&] {
+    v41k::gate_up_em5<T>(hq_old.data(), hd_old.data(), xq.data(), xd.data(), ids.data(), prob.data(),
+                         gate.data(), up.data(), row_stride, ob.data(), routes, 6, plan.data());
+  }, ord_old);
+  int fails = 0;
+  for (int g : grids) {
+    std::vector<int8_t> hq_new = hq0;
+    std::vector<float> hd_new = hd0;
+    std::vector<int> ord(g);
+    for (int i = 0; i < g; ++i) ord[i] = i;
+    std::shuffle(ord.begin(), ord.end(), rng);
+    {  // dirty the static "shared memory" with a different plan first
+      std::vector<int> ids2 = make_ids(m, 0, rng), plan2 = plan;
+      make_plan(ids2, plan2);
+      std::vector<int8_t> hq2 = hq0;
+      std::vector<float> hd2 = hd0;
+      emu_launch(g, 512, [&] {
+        v41k_fast::gate_up_fast<T>(hq2.data(), hd2.data(), xq.data(), xd.data(), prob.data(), gate.data(),
+                                   up.data(), row_stride, fb.data(), plan2.data());
+      }, ord);
+    }
+    emu_launch(g, 512, [&] {
+      v41k_fast::gate_up_fast<T>(hq_new.data(), hd_new.data(), xq.data(), xd.data(), prob.data(), gate.data(),
+                                 up.data(), row_stride, fb.data(), plan.data());
+    }, ord);
+    int bad = 0, written = 0, clamp = 0;
+    for (int i = 0; i < routes * 18; ++i) {
+      uint32_t a, b;
+      std::memcpy(&a, &hd_old[i], 4);
+      std::memcpy(&b, &hd_new[i], 4);
+      bad += a != b;
+      written += !std::isnan(hd_old[i]);
+      clamp += !std::isnan(hd_old[i]) && hd_old[i] > 9.9f / 127.f;
+      for (int j = 0; j < 32; ++j) bad += hq_old[i * 32 + j] != hq_new[i * 32 + j];
+    }
+    if (verbose)
+      std::printf("GU T=%d M=%d kind=%d grid=%d nu=%d: mismatches=%d groups_written=%d big=%d\n", T, m, kind, g,
+                  plan[0], bad, written, clamp);
+    fails += bad != 0;
+  }
+  return fails;
+}
+
+template <int T> int run_type_gu(uint64_t seed, int kinds_mask, int m_lo, int m_hi) {
+  constexpr int bb = T == 16 ? 66 : T == 17 ? 74 : 56;
+  std::mt19937 rng(seed);
+  std::vector<uint8_t> gate(size_t(E) * 576 * 20 * bb + 64), up(gate.size());
+  fill_weights<T>(gate, bb, rng);
+  fill_weights<T>(up, bb, rng);
+  const auto ob = old_book<T>();
+  const auto fb = fast_book<T>();
+  int fails = 0;
+  for (int m = m_lo; m <= m_hi; ++m)
+    for (int kind = 0; kind < 6; ++kind)
+      if (kinds_mask >> kind & 1) fails += run_case_gu<T>(m, kind, seed * 1000 + m * 10 + kind, ob, fb, gate, up, true) != 0;
+  return fails;
+}
+
+template <int T> int run_type(uint64_t seed, int kinds_mask, int m_lo, int m_hi) {
+  constexpr int bb = T == 16 ? 66 : T == 17 ? 74 : 56;
+  std::mt19937 rng(seed);
+  std::vector<uint8_t> down(size_t(E) * RL * 9 * bb + 64);
+  fill_weights<T>(down, bb, rng);
+  const auto ob = old_book<T>();
+  const auto fb = fast_book<T>();
+  int fails = 0;
+  for (int m = m_lo; m <= m_hi; ++m)
+    for (int kind = 0; kind < 6; ++kind)
+      if (kinds_mask >> kind & 1)
+        fails += run_case<T>(m, kind, (m + kind) % 2 ? 8 : 4, seed * 1000 + m * 10 + kind, ob, fb, down, true) != 0;
+  return fails;
+}
+
+int main(int argc, char** argv) {
+  const int type = argc > 1 ? std::atoi(argv[1]) : 29;
+  const int m_lo = argc > 2 ? std::atoi(argv[2]) : 1, m_hi = argc > 3 ? std::atoi(argv[3]) : 6;
+  const int kinds = argc > 4 ? std::atoi(argv[4]) : 63;
+  const uint64_t seed = argc > 5 ? std::atoll(argv[5]) : 1;
+  const bool gu = argc > 6 && std::strcmp(argv[6], "gu") == 0;
+  int fails = gu ? (type == 16 ? run_type_gu<16>(seed, kinds, m_lo, m_hi)
+                    : type == 17 ? run_type_gu<17>(seed, kinds, m_lo, m_hi)
+                                 : run_type_gu<29>(seed, kinds, m_lo, m_hi))
+                 : (type == 16 ? run_type<16>(seed, kinds, m_lo, m_hi)
+                    : type == 17 ? run_type<17>(seed, kinds, m_lo, m_hi)
+                                 : run_type<29>(seed, kinds, m_lo, m_hi));
+  std::printf("%s type %d: %d failing cases\n", gu ? "gate/up" : "down", type, fails);
+  return fails ? 1 : 0;
+}
diff --git a/benchmarks/deepseek_v41/v41k/emu/extract_old.py b/benchmarks/deepseek_v41/v41k/emu/extract_old.py
new file mode 100644
index 0000000000..18921122e6
--- /dev/null
+++ b/benchmarks/deepseek_v41/v41k/emu/extract_old.py
@@ -0,0 +1,90 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Write old_extract.inc: the old v41k kernels the emulator compares against.
+
+Cuts line ranges out of v41k.cu at a base commit (default 8a7bd7b, the
+EXPERT_FAST branch point), checks each range's first line, and applies the
+marked edits that make the host build follow the old SASS: Group3::apply
+returns d * xd * S, and each accumulation is FFMA(that, 0.125, acc).
+
+    python benchmarks/deepseek_v41/v41k/emu/extract_old.py [base]
+"""
+
+import os
+import subprocess
+import sys
+
+BASE = sys.argv[1] if len(sys.argv) > 1 else "8a7bd7b"
+HERE = os.path.dirname(os.path.abspath(__file__))
+SRC = "benchmarks/deepseek_v41/v41k/v41k.cu"
+# (first, last, first line starts with)
+RANGES = [
+    (19, 36, "template <int Type>"),  # block_bytes, build_table
+    (565, 578, "__device__ __forceinline__ void ld3("),  # ld3, ld16
+    (583, 672, "template <int Type>"),  # Group3, book_words
+    (674, 686, "__device__ __forceinline__ int find_distinct("),
+    (1264, 1288, "__device__ __forceinline__ void load_q8("),  # + q8_warp_aligned
+    (1290, 1392, "#ifndef V41K_GU_MINB"),  # gate_up_em5
+    (1657, 1750, "// Row-split down (G3)"),  # down_rows
+]
+EDITS = [
+    (
+        "    return d * xd * float(s0 * m0 + s1 * m1) * 0.125f;",
+        (
+            "    return d * xd * float(s0 * m0 + s1 * m1);  // EDIT 1: the x0.125 is"
+            " the FFMA below (old SASS)"
+        ),
+    ),
+    (
+        "        gs[c] += dg.apply(q, d);",
+        (
+            "        gs[c] = __builtin_fmaf(dg.apply(q, d), 0.125f, gs[c]);  // EDIT 2:"
+            " FFMA(x, 0.125, acc) as in the old SASS"
+        ),
+    ),
+    (
+        "        us[c] += du.apply(q, d);",
+        "        us[c] = __builtin_fmaf(du.apply(q, d), 0.125f, us[c]);  // EDIT 3",
+    ),
+    (
+        "            dot[c] += w.apply(qv, d);",
+        (
+            "            dot[c] = __builtin_fmaf(w.apply(qv, d), 0.125f, dot[c]);"
+            "  // EDIT 4: FFMA(x, 0.125, dot) as in the old SASS"
+        ),
+    ),
+]
+
+
+def main():
+    root = subprocess.run(
+        ["git", "-C", HERE, "rev-parse", "--show-toplevel"],
+        check=True,
+        capture_output=True,
+        text=True,
+    ).stdout.strip()
+    lines = subprocess.run(
+        ["git", "-C", root, "show", f"{BASE}:{SRC}"],
+        check=True,
+        capture_output=True,
+        text=True,
+    ).stdout.split("\n")
+    out = [f"// Extracted verbatim from v41k.cu (base {BASE}) by extract_old.py;"]
+    out.append("// the marked EDIT lines are the only changes.")
+    out.append("namespace v41k {")
+    for first, last, head in RANGES:
+        chunk = lines[first - 1 : last]
+        assert chunk[0].startswith(head), (first, chunk[0])
+        out += chunk
+    out.append("}  // namespace v41k")
+    text = "\n".join(out) + "\n"
+    for old, new in EDITS:
+        assert text.count(old) == 1, old
+        text = text.replace(old, new)
+    with open(os.path.join(HERE, "old_extract.inc"), "w") as f:
+        f.write(text)
+    print("wrote", os.path.join(HERE, "old_extract.inc"))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/benchmarks/deepseek_v41/v41k/emu/old_extract.inc b/benchmarks/deepseek_v41/v41k/emu/old_extract.inc
new file mode 100644
index 0000000000..a4ec63d6a6
--- /dev/null
+++ b/benchmarks/deepseek_v41/v41k/emu/old_extract.inc
@@ -0,0 +1,361 @@
+// Extracted verbatim from v41k.cu (base 8a7bd7b) by extract_old.py;
+// the marked EDIT lines are the only changes.
+namespace v41k {
+template <int Type>
+constexpr int block_bytes() {
+  return Type == 16 ? 66 : Type == 17 ? 74 : 56;
+}
+
+template <int Type>
+__global__ void build_table(uint32_t* out, int words) {
+  using Book = turbomind::gemm::LatticeCodebook<Type>;
+  const int i = blockIdx.x * blockDim.x + threadIdx.x;
+  if (i >= words) return;
+  uint32_t word = Book::word(i) ^ 0x80808080U;
+  if constexpr (Type == 29) {
+    word = __vadd4(word, word);
+    word = __vadd4(word, word);
+    word = __vadd4(word, word);
+  }
+  out[i] = word;
+}
+__device__ __forceinline__ void ld3(const uint8_t* p, uint32_t& w0,
+                                    uint32_t& w1) {
+  // 8 bytes at any 2-byte-aligned address: three aligned words + funnel shifts.
+  const uintptr_t a = reinterpret_cast<uintptr_t>(p);
+  const uint32_t* q = reinterpret_cast<const uint32_t*>(a & ~uintptr_t(3));
+  const uint32_t sh = (a & 3) * 8;
+  const uint32_t x0 = __ldg(q), x1 = __ldg(q + 1), x2 = __ldg(q + 2);
+  w0 = __funnelshift_r(x0, x1, sh);
+  w1 = __funnelshift_r(x1, x2, sh);
+}
+__device__ __forceinline__ uint32_t ld16(const uint8_t* p) {
+  return *reinterpret_cast<const uint16_t*>(p);
+}
+
+template <int Type>
+// Codebook entries as one 64-bit LDS; sign masks computed (PRMT), not looked
+// up.
+#ifndef V41K_SMEM_MASKS
+  #define V41K_MASK(n) sign_mask(n)
+#else
+  #define V41K_MASK(n) masks[n]
+#endif
+struct Group3 {
+  uint32_t w[8];
+  float d;
+  int m0, m1;
+  __device__ __forceinline__ Group3(const uint8_t* row, int group,
+                                    const uint32_t* book,
+                                    const uint32_t* masks) {
+    const uint8_t* b = row + (group >> 3) * block_bytes<Type>();
+    const int sub = group & 7;
+    if constexpr (Type == 29) {
+      const uint32_t qs = __ldg(reinterpret_cast<const uint32_t*>(b + 4 * sub));
+      const uint32_t qh = ld16(b + 32 + 2 * sub);
+      const uint2 sc = __ldg(reinterpret_cast<const uint2*>(b + 48));
+#pragma unroll
+      for (int octet = 0; octet < 4; ++octet) {
+        const int high = (qh >> (4 * octet)) & 15;
+        const int index = ((qs >> (8 * octet)) & 255) | ((high & 7) << 8);
+        const uint32_t bias = (high >> 3) ? 0xffffffffU : 0x01010101U;
+        const uint2 e = reinterpret_cast<const uint2*>(book)[index];
+        w[2 * octet] = __vadd4(e.x, bias);
+        w[2 * octet + 1] = __vadd4(e.y, bias);
+      }
+      const uint32_t s01 = sc.x, s23 = sc.y;
+      const uint16_t bits =
+          ((s01 & 0xffff) >> 12) | (((s01 >> 16) >> 8) & 0xf0) |
+          (((s23 & 0xffff) >> 4) & 0xf00) | ((s23 >> 16) & 0xf000);
+      d = __half2float(__ushort_as_half(bits));
+      const uint64_t all = (uint64_t(s23) << 32) | s01;
+      const int f = sub * 2;
+      // scales[f/4] >> 3*(f%4) on 16-bit lanes
+      m0 = 2 * ((all >> (16 * (f / 4) + 3 * (f % 4))) & 7) + 1;
+      m1 = 2 * ((all >> (16 * ((f + 1) / 4) + 3 * ((f + 1) % 4))) & 7) + 1;
+    } else {
+      uint32_t w0, w1;
+      ld3(b + 2 + 8 * sub, w0, w1);
+      d = __half2float(__ushort_as_half(ld16(b)));
+      if constexpr (Type == 16) {
+        const uint32_t meta = w1;
+#pragma unroll
+        for (int octet = 0; octet < 4; ++octet) {
+          const int index = (w0 >> (8 * octet)) & 255;
+          int signs = (meta >> (7 * octet)) & 127;
+          signs |= (__popc(signs) & 1) << 7;
+          const uint32_t lo = V41K_MASK(signs & 15), hi = V41K_MASK(signs >> 4);
+          const uint2 e = reinterpret_cast<const uint2*>(book)[index];
+          w[2 * octet] = __vsub4(e.x ^ lo, lo);
+          w[2 * octet + 1] = __vsub4(e.y ^ hi, hi);
+        }
+        m0 = m1 = 1 + 2 * (meta >> 28);
+      } else {
+#pragma unroll
+        for (int octet = 0; octet < 4; ++octet) {
+          const uint32_t code =
+              ((octet < 2 ? w0 : w1) >> (16 * (octet & 1))) & 0xffff;
+          const int index = code & 511;
+          int signs = code >> 9;
+          signs |= (__popc(signs) & 1) << 7;
+          const uint32_t lo = V41K_MASK(signs & 15), hi = V41K_MASK(signs >> 4);
+          const uint2 e = reinterpret_cast<const uint2*>(book)[index];
+          w[2 * octet] = __vsub4(e.x ^ lo, lo);
+          w[2 * octet + 1] = __vsub4(e.y ^ hi, hi);
+        }
+        const int sc = b[66 + sub];
+        m0 = 1 + 2 * (sc & 15);
+        m1 = 1 + 2 * (sc >> 4);
+      }
+    }
+  }
+  __device__ __forceinline__ float apply(const int* qs, float xd) const {
+    int s0 = 0, s1 = 0;
+#pragma unroll
+    for (int i = 0; i < 4; ++i) s0 = __dp4a(int(w[i]), qs[i], s0);
+#pragma unroll
+    for (int i = 4; i < 8; ++i) s1 = __dp4a(int(w[i]), qs[i], s1);
+    return d * xd * float(s0 * m0 + s1 * m1);  // EDIT 1: the x0.125 is the FFMA below (old SASS)
+  }
+};
+
+template <int Type>
+constexpr int book_words() {
+  return turbomind::gemm::LatticeCodebook<Type>::kBytes / 4;
+}
+__device__ __forceinline__ int find_distinct(const int* ids, int routes,
+                                             int u) {
+  int e = -1, distinct = 0;
+  for (int r = 0; r < routes && e < 0; ++r) {
+    bool seen = false;
+    for (int q = 0; q < r; ++q) seen |= ids[q] == ids[r];
+    if (!seen) {
+      if (distinct == u) e = ids[r];
+      ++distinct;
+    }
+  }
+  return e;
+}
+__device__ __forceinline__ void load_q8(const int8_t* qs, const float* ds,
+                                        int64_t idx, int (&q)[8], float& d) {
+  const int4* p = reinterpret_cast<const int4*>(qs + idx * 32);
+  const int4 a = __ldg(p), b = __ldg(p + 1);
+  q[0] = a.x;
+  q[1] = a.y;
+  q[2] = a.z;
+  q[3] = a.w;
+  q[4] = b.x;
+  q[5] = b.y;
+  q[6] = b.z;
+  q[7] = b.w;
+  d = __ldg(ds + idx);
+}
+
+__device__ __forceinline__ void q8_warp_aligned(int8_t* qs, float* ds,
+                                                int64_t idx, float value) {
+  const int lane = threadIdx.x % 32;
+  float m = fabsf(value);
+#pragma unroll
+  for (int o = 16; o; o >>= 1) m = fmaxf(m, __shfl_xor_sync(0xffffffffU, m, o));
+  const float d = m / 127.f;
+  qs[idx * 32 + lane] = m == 0.f ? 0 : int8_t(roundf(value / d));
+  if (!lane) ds[idx] = __half2float(__float2half_rn(d));
+}
+#ifndef V41K_GU_MINB
+  #define V41K_GU_MINB 2
+#endif
+template <int Type>
+__global__ void __launch_bounds__(512, V41K_GU_MINB)
+    gate_up_em5(int8_t* __restrict__ hq, float* __restrict__ hd,
+                const int8_t* __restrict__ xq, const float* __restrict__ xd,
+                const int* ids, const float* __restrict__ prob,
+                const uint8_t* __restrict__ gate,
+                const uint8_t* __restrict__ up, int row_stride,
+                const uint32_t* __restrict__ gbook, int routes, int top_k,
+                const int* __restrict__ plan) {
+  constexpr int GROUPS = 160, BW = book_words<Type>();
+  __shared__ __align__(16) uint32_t book[BW];
+  __shared__ int s_expert, s_cnt, s_route[6], s_tok[6];
+  __shared__ uint32_t masks[16];
+  __shared__ float red[6][2][32];
+  const int t = threadIdx.x, warp = t / 32, lane = t % 32;
+  if (plan != nullptr) {
+    // per-layer plan: [0] distinct count, [1+u] expert, [37+u] routes,
+    // [73+6u+c] route
+    const int u = blockIdx.y;
+    if (u >= __ldg(plan)) return;
+    for (int i = t; i < BW; i += blockDim.x) book[i] = __ldg(gbook + i);
+    if (t < 16) masks[t] = sign_mask(t);
+    if (t < 6) {
+      const int cnt = __ldg(plan + 37 + u);
+      const int r = t < cnt ? __ldg(plan + 73 + 6 * u + t) : 0;
+      s_route[t] = r;
+      s_tok[t] = r / top_k;
+      if (t == 0) {
+        s_expert = __ldg(plan + 1 + u);
+        s_cnt = cnt;
+      }
+    }
+  } else if (t == 0) {
+    const int e = find_distinct(ids, routes, blockIdx.y);
+    int cnt = 0;
+    if (e >= 0)
+      for (int r = 0; r < routes; ++r)
+        if (ids[r] == e && cnt < 6) {
+          s_route[cnt] = r;
+          s_tok[cnt] = r / top_k;
+          ++cnt;
+        }
+    s_expert = e;
+    s_cnt = cnt;
+  }
+  __syncthreads();
+  const int e = s_expert, cnt = s_cnt;
+  if (plan == nullptr) {
+    if (e < 0) return;
+    for (int i = t; i < BW; i += blockDim.x) book[i] = __ldg(gbook + i);
+    if (t < 16) masks[t] = sign_mask(t);
+    __syncthreads();
+  }
+  const int lrow = warp * 2 + lane / 16;
+  const int row = blockIdx.x * 32 + lrow;
+  const uint8_t* g = gate + (int64_t(e) * 576 + row) * row_stride;
+  const uint8_t* u = up + (int64_t(e) * 576 + row) * row_stride;
+  int tok[6];
+#pragma unroll
+  for (int c = 0; c < 6; ++c) tok[c] = c < cnt ? s_tok[c] : 0;
+  float gs[6] = {}, us[6] = {};
+#pragma unroll kGuUnroll
+  for (int group = lane % 16; group < GROUPS; group += 16) {
+    const Group3<Type> dg(g, group, book, masks);
+    const Group3<Type> du(u, group, book, masks);
+#pragma unroll
+    for (int c = 0; c < 6; ++c)
+      if (c < cnt) {
+        int q[8];
+        float d;
+        load_q8(xq, xd, int64_t(tok[c]) * GROUPS + group, q, d);
+        gs[c] = __builtin_fmaf(dg.apply(q, d), 0.125f, gs[c]);  // EDIT 2: FFMA(x, 0.125, acc) as in the old SASS
+        us[c] = __builtin_fmaf(du.apply(q, d), 0.125f, us[c]);  // EDIT 3
+      }
+  }
+#pragma unroll
+  for (int c = 0; c < 6; ++c) {
+#pragma unroll
+    for (int o = 8; o; o >>= 1) {
+      gs[c] += __shfl_xor_sync(0xffffffffU, gs[c], o);
+      us[c] += __shfl_xor_sync(0xffffffffU, us[c], o);
+    }
+    if (c < cnt && lane % 16 == 0) {
+      red[c][0][lrow] = gs[c];
+      red[c][1][lrow] = us[c];
+    }
+  }
+  __syncthreads();
+  if (warp < cnt) {
+    const int route = s_route[warp];
+    float g16 = __half2float(__float2half_rn(red[warp][0][lane]));
+    float u16 = __half2float(__float2half_rn(red[warp][1][lane]));
+    g16 = g16 > 10.f ? 10.f : g16;
+    u16 = u16 > 10.f ? 10.f : (u16 < -10.f ? -10.f : u16);
+    const float act = __fdiv_rn(g16, __fadd_rn(1.f, expf(-g16)));
+    const float value = __half2float(
+        __float2half_rn(__fmul_rn(__fmul_rn(act, u16), prob[route])));
+    q8_warp_aligned(hq, hd, int64_t(route) * 18 + blockIdx.x, value);
+  }
+}
+// Row-split down (G3): each rank owns 1280 output rows of every expert with the
+// full K = 2304 (72 Q8 groups). The routed Q8 inputs of all four ranks are
+// gathered rank-major: rank r's block holds hq [routes, 18, 32] then hd
+// [routes, 18] at `rank_stride` bytes. Only rows [row_base, row_base + rows)
+// of out are written; the caller zeroes the rest before the TP all-reduce.
+template <int Type, int NW, int SUB>
+__global__ void __launch_bounds__(32 * NW, 8 / NW * 4)
+    down_rows(half* __restrict__ out, const uint8_t* __restrict__ gathered,
+              int64_t rank_stride, const uint8_t* __restrict__ down,
+              int row_stride, int rows_local, int row_base,
+              const uint32_t* __restrict__ gbook, int routes, int top_k,
+              int tokens, int rows_per_cta, const int* __restrict__ plan) {
+  constexpr int LG = 18, GROUPS = 72, N = 5120, BW = book_words<Type>(),
+                RT = 32 / SUB;
+  __shared__ __align__(16) uint32_t book[BW];
+  __shared__ int distinct_e[36], s_nu, member_route[36][6], member_cnt[36];
+  __shared__ uint32_t masks[16];
+  __shared__ float part[NW][8][6];
+  const int t = threadIdx.x, lane = t % 32, warp = t / 32;
+  for (int i = t; i < BW; i += blockDim.x) book[i] = __ldg(gbook + i);
+  if (t < 16) masks[t] = sign_mask(t);
+  for (int i = t; i < 36 + 36 + 216; i += blockDim.x) {
+    if (i < 36)
+      distinct_e[i] = __ldg(plan + 1 + i);
+    else if (i < 72)
+      member_cnt[i - 36] = __ldg(plan + 1 + i);
+    else
+      member_route[(i - 72) / 6][(i - 72) % 6] = __ldg(plan + 1 + i);
+  }
+  if (t == 0) s_nu = __ldg(plan);
+  __syncthreads();
+  const int nu = s_nu;
+  const int lrow = lane / SUB, sub = lane % SUB;
+  const int64_t q_bytes = int64_t(routes) * LG * 32;
+  for (int tile = 0; tile < rows_per_cta / RT; ++tile) {
+    const int row0 = (blockIdx.x * rows_per_cta / RT + tile) * RT;
+    const int row = row0 + lrow;
+    float acc[6] = {};
+    for (int q = warp; q < nu; q += NW) {
+      const int e = distinct_e[q], cnt = member_cnt[q];
+      const uint8_t* base = down + (int64_t(e) * rows_local + row) * row_stride;
+      int rt[6];
+#pragma unroll
+      for (int c = 0; c < 6; ++c) rt[c] = c < cnt ? member_route[q][c] : 0;
+      float dot[6] = {};
+      for (int g = sub; g < GROUPS; g += SUB) {
+        const Group3<Type> w(base, g, book, masks);
+        const uint8_t* rank_base = gathered + (g / LG) * rank_stride;
+        const int8_t* hq = reinterpret_cast<const int8_t*>(rank_base);
+        const float* hd = reinterpret_cast<const float*>(rank_base + q_bytes);
+        const int gl = g % LG;
+#pragma unroll
+        for (int c = 0; c < 6; ++c)
+          if (c < cnt) {
+            int qv[8];
+            float d;
+            load_q8(hq, hd, int64_t(rt[c]) * LG + gl, qv, d);
+            dot[c] = __builtin_fmaf(w.apply(qv, d), 0.125f, dot[c]);  // EDIT 4: FFMA(x, 0.125, dot) as in the old SASS
+          }
+      }
+#pragma unroll
+      for (int c = 0; c < 6; ++c) {
+#pragma unroll
+        for (int o = 1; o < SUB; o <<= 1)
+          dot[c] += __shfl_xor_sync(0xffffffffU, dot[c], o);
+      }
+#pragma unroll
+      for (int c = 0; c < 6; ++c)
+        if (c < cnt) {
+          const int token = rt[c] / top_k;
+          const float v = __half2float(__float2half_rn(dot[c]));
+#pragma unroll
+          for (int k = 0; k < 6; ++k)
+            if (k == token) acc[k] += v;
+        }
+    }
+    __syncthreads();
+    if (sub == 0)
+#pragma unroll
+      for (int k = 0; k < 6; ++k) part[warp][lrow][k] = acc[k];
+    __syncthreads();
+    if (t < RT * tokens) {
+      const int r = t / tokens, k = t % tokens;
+      float v = 0.f;
+#pragma unroll
+      for (int w8 = 0; w8 < NW; ++w8) v += part[w8][r][k];
+      out[k * N + row_base + row0 + r] = __float2half_rn(v);
+#pragma unroll
+      for (int o = 0; o < 4; ++o)
+        if (o * rows_local != row_base)
+          out[k * N + o * rows_local + row0 + r] = __float2half_rn(0.f);
+    }
+  }
+}
