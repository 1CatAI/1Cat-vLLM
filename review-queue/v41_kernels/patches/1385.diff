+#if defined(__CUDACC__)
+
+template <int Type>
+__global__ void build_fast_table(uint32_t* __restrict__ out) {
+  const int i = blockIdx.x * blockDim.x + threadIdx.x;
+  if (i >= FastBook<Type>::kWords) return;
+  out[i] = fast_word<Type>(i, [](int k) -> int {
+    return turbomind::gemm::LatticeCodebook<Type>::value(k);
+  });
+}
+
+// Global table -> replicated shared table.
+template <int Type>
+__device__ __forceinline__ void fill_book(uint32_t* book,
+                                          const uint32_t* __restrict__ g,
+                                          int t, int nt) {
+  using FB = FastBook<Type>;
+  for (int i = t; i < FB::kSmemWords; i += nt) {
+    int src = i;
+    if constexpr (Type != 29)
+      src = i < FB::kSignBase ? i / FB::kGridR
+                              : FB::kGrid + (i - FB::kSignBase) / FB::kSignR;
+    book[i] = __ldg(g + src);
+  }
+}
+
+__device__ __forceinline__ uint32_t ldg16(const uint8_t* p) {
+  return __ldg(reinterpret_cast<const unsigned short*>(p));
+}
+
+// Weight loads. Weights are read once per layer; the activations are re-read
+// by every unit of their expert (down) or token (gate/up). L1::evict_first
+// still allocates the weight lines (the fields of one block share sectors)
+// but makes them the first victims, so they do not push the activations out
+// of L1. Non-volatile asm: ptxas schedules these like __ldg.
+__device__ __forceinline__ uint32_t ldw32(const void* p) {
+#if defined(__CUDA_ARCH__)
+  uint32_t v;
+  asm("ld.global.nc.L1::evict_first.u32 %0, [%1];" : "=r"(v) : "l"(p));
+  return v;
+#else
+  return *static_cast<const uint32_t*>(p);
+#endif
+}
+__device__ __forceinline__ uint32_t ldw16(const void* p) {
+#if defined(__CUDA_ARCH__)
+  unsigned short v;
+  asm("ld.global.nc.L1::evict_first.u16 %0, [%1];" : "=h"(v) : "l"(p));
+  return v;
+#else
+  return *static_cast<const unsigned short*>(p);
+#endif
+}
+__device__ __forceinline__ uint32_t ldw8(const void* p) {
+#if defined(__CUDA_ARCH__)
+  unsigned short v;
+  asm("ld.global.nc.L1::evict_first.u8 %0, [%1];" : "=h"(v) : "l"(p));
+  return v;
+#else
+  return *static_cast<const uint8_t*>(p);
+#endif
+}
+__device__ __forceinline__ uint2 ldw64(const void* p) {
+#if defined(__CUDA_ARCH__)
+  uint2 v;
+  asm("ld.global.nc.L1::evict_first.v2.u32 {%0, %1}, [%2];"
+      : "=r"(v.x), "=r"(v.y)
+      : "l"(p));
+  return v;
+#else
+  return *static_cast<const uint2*>(p);
+#endif
+}
+
+// Prefetch the line holding p into L1 (CCTL.E.PF1 on sm_70): no register,
+// no wait. Activations are prefetched one unit ahead so their loads hit L1
+// instead of exposing L2 / DRAM latency at every K block.
+__device__ __forceinline__ void prefetch_l1(const void* p) {
+#if defined(__CUDA_ARCH__)
+  asm volatile("prefetch.global.L1 [%0];" ::"l"(p));
+#else
+  (void)p;
+#endif
+}
+
+// Raw fields of the 9 K blocks of one (row, sub) of a 2304-wide down row,
+// loaded block by block so the next unit's loads can replace the current
+// unit's as soon as each block is decoded. Ptr holds the per-row base
+// pointers, so every block load is [base + immediate]; pin() makes them
+// opaque so ptxas keeps them in registers instead of rebuilding them from
+// the row offset at every block.
+template <class T>
+__device__ __forceinline__ void pin_ptr(T*& p) {
+#if defined(__CUDA_ARCH__)
+  asm volatile("" : "+l"(p));
+#endif
+}
+template <int Type>
+struct DnRaw;
+template <int BB>  // IQ2_XXS (66) / IQ2_XS (74): 8 sub-block bytes at 2 + 8 s
+struct DnPtrIQ2 {
+  const uint8_t* row;
+  const uint32_t *pe, *po;  // word-aligned sub-block base, even / odd blocks
+  uint32_t a;               // byte misalignment of block 0's sub-block
+  __device__ __forceinline__ DnPtrIQ2(const uint8_t* r, int sub) : row(r) {
+    const uintptr_t x = reinterpret_cast<uintptr_t>(r + 2 + 8 * sub);
+    pe = reinterpret_cast<const uint32_t*>(x & ~uintptr_t(3));
+    po = reinterpret_cast<const uint32_t*>((x + BB) & ~uintptr_t(3));
+    a = uint32_t(x) & 3;
+  }
+  // 8 bytes of block j as three aligned words; BB j = 2 j (mod 4).
+  __device__ __forceinline__ const uint32_t* words(int j) const {
+    return (j & 1 ? po : pe) + (BB / 2) * (j >> 1);
+  }
+  __device__ __forceinline__ void pin() {
+    pin_ptr(row);
+    pin_ptr(pe);
+    pin_ptr(po);
+  }
+};
+template <>
+struct DnRaw<16> {
+  using Ptr = DnPtrIQ2<66>;
+  uint32_t x[9][3], dh[9], a;
+  __device__ __forceinline__ void set(const Ptr& p) { a = p.a; }
+  __device__ __forceinline__ void load(int j, const Ptr& p) {
+    const uint32_t* q = p.words(j);
+    x[j][0] = ldw32(q);
+    x[j][1] = ldw32(q + 1);
+    x[j][2] = ldw32(q + 2);
+    dh[j] = ldw16(p.row + 66 * j);
+  }
+  __device__ __forceinline__ void decode(int j, const uint32_t* book,
+                                         uint32_t lg, uint32_t ls, int,
+                                         uint32_t (&w)[8], float& d, int& m0,
+                                         int& m1) const {
+    const uint32_t sh = ((a + 2 * j) & 3) * 8;
+    const uint32_t w0 = __funnelshift_r(x[j][0], x[j][1], sh);
+    const uint32_t w1 = __funnelshift_r(x[j][1], x[j][2], sh);
+    dec16(w0, w1, book, lg, ls, w, m0, m1);
+    d = __half2float(__ushort_as_half((unsigned short)dh[j]));
+  }
+};
+template <>
+struct DnRaw<17> {
+  struct Ptr : DnPtrIQ2<74> {
+    const uint8_t* scp;  // scale byte of sub-block s of block 0
+    __device__ __forceinline__ Ptr(const uint8_t* r, int sub)
+        : DnPtrIQ2<74>(r, sub), scp(r + 66 + sub) {}
+    __device__ __forceinline__ void pin() {
+      DnPtrIQ2<74>::pin();
+      pin_ptr(scp);
+    }
+  };
+  uint32_t x[9][3], dh[9], sc[9], a;
+  __device__ __forceinline__ void set(const Ptr& p) { a = p.a; }
+  __device__ __forceinline__ void load(int j, const Ptr& p) {
+    const uint32_t* q = p.words(j);
+    x[j][0] = ldw32(q);
+    x[j][1] = ldw32(q + 1);
+    x[j][2] = ldw32(q + 2);
+    dh[j] = ldw16(p.row + 74 * j);
+    sc[j] = ldw8(p.scp + 74 * j);
+  }
+  __device__ __forceinline__ void decode(int j, const uint32_t* book,
+                                         uint32_t, uint32_t ls, int,
+                                         uint32_t (&w)[8], float& d, int& m0,
+                                         int& m1) const {
+    const uint32_t sh = ((a + 2 * j) & 3) * 8;
+    const uint32_t w0 = __funnelshift_r(x[j][0], x[j][1], sh);
+    const uint32_t w1 = __funnelshift_r(x[j][1], x[j][2], sh);
+    dec17(w0, w1, sc[j], book, ls, w, m0, m1);
+    d = __half2float(__ushort_as_half((unsigned short)dh[j]));
+  }
+};
+template <>
+struct DnRaw<29> {
+  struct Ptr {
+    const uint8_t *row, *qsp, *qhp;
+    __device__ __forceinline__ Ptr(const uint8_t* r, int sub)
+        : row(r), qsp(r + 4 * sub), qhp(r + 32 + 2 * sub) {}
+    __device__ __forceinline__ void pin() {
+      pin_ptr(row);
+      pin_ptr(qsp);
+      pin_ptr(qhp);
+    }
+  };
+  uint32_t qs[9], qh[9], s01[9], s23[9];
+  __device__ __forceinline__ void set(const Ptr&) {}
+  __device__ __forceinline__ void load(int j, const Ptr& p) {
+    qs[j] = ldw32(p.qsp + 56 * j);
+    qh[j] = ldw16(p.qhp + 56 * j);
+    const uint2 sc = ldw64(p.row + 56 * j + 48);
+    s01[j] = sc.x;
+    s23[j] = sc.y;
+  }
+  __device__ __forceinline__ void decode(int j, const uint32_t* book, uint32_t,
+                                         uint32_t, int sub, uint32_t (&w)[8],
+                                         float& d, int& m0, int& m1) const {
+    dec29(qs[j], qh[j], s01[j], s23[j], sub, book, w, m0, m1);
+    d = __half2float(__ushort_as_half(iq1m_d_bits(s01[j], s23[j])));
+  }
+};
+
+__device__ __forceinline__ void load_act(const uint8_t* pq, const float* px,
+                                         int (&q)[8], float& d) {
+  const int4* p = reinterpret_cast<const int4*>(pq);
+  const int4 a = __ldg(p), b = __ldg(p + 1);
+  q[0] = a.x;
+  q[1] = a.y;
+  q[2] = a.z;
+  q[3] = a.w;
+  q[4] = b.x;
+  q[5] = b.y;
+  q[6] = b.z;
+  q[7] = b.w;
+  d = __ldg(px);
+}
+
+// Gathered activations of group g = sub + 8 j (K block j of a lane): rank
+// block g / 18, group g % 18. With the rank stride RS a compile-time constant
+// the offsets from the per-route base (gathered + rt * 576 + 32 sub for hq,
+// gathered + QB + rt * 72 + 4 sub for hd) are immediates, except for j = 2, 4,
+// 6, where lanes with sub >= j fall in the next rank block.
+__device__ __forceinline__ int act_rank(int j, int sub) {
+  constexpr int lo[9] = {0, 0, 0, 1, 1, 2, 2, 3, 3};
+  return lo[j] + int((j == 2 || j == 4 || j == 6) && sub >= j);
+}
+
+// Activations of route rt (hq 576 B and hd 72 B in each of the 4 rank slots)
+// into L1, one line per lane: lane = slot * 8 + k, k = 0..4 the hq lines from
+// its first byte, 5 its last byte, 6 / 7 the first / last hd byte. Every
+// address is inside the route's own bytes.
+template <int RS, int QB>
+__device__ __forceinline__ void dn_prefetch_route(const uint8_t* gathered,
+                                                  int rt, int lane) {
+  const int k = lane & 7;
+  const int off = k < 5    ? rt * 576 + 128 * k
+                  : k == 5 ? rt * 576 + 575
+                           : QB + rt * 72 + (k == 6 ? 0 : 71);
+  prefetch_l1(gathered + (lane >> 3) * RS + off);
+}
+
+// Row-split down, same contract as down_rows (see v41k.cu) for M tokens x
+// top-6 routes: rows [row_base, row_base + rows_local) of out are written,
+// the other ranks' rows zeroed. 16 rows per CTA (grid = rows_local / 16 = 80,
+// one per SM), 16 warps. A unit is (distinct expert q, 4-row slab): one warp,
+// lane = (row r = lane / 8, sub s = lane % 8), K block j = 0..8 -> group
+// s + 8 j. Each block is decoded once; member 0 of the expert always runs,
+// members 1..5 behind a warp-uniform early exit. Units are claimed
+// dynamically one ahead, and the next unit's raw blocks are loaded into the
+// registers of the current unit's blocks right after each is decoded; the
+// next unit's member activations are prefetched into L1 when it is claimed
+// (each route belongs to one expert, so they are never already there).
+constexpr int kDnRows = 16, kDnWarps = 16;
+
+template <int Type, int M>
+__global__ void __launch_bounds__(32 * kDnWarps, 1)
+    down_rows_fast(half* __restrict__ out, const uint8_t* __restrict__ gathered,
+                   const uint8_t* __restrict__ down, int row_stride,
+                   int rows_local, int row_base,
+                   const uint32_t* __restrict__ fbook, int classes,
+                   const int* __restrict__ plan) {
+  using FB = FastBook<Type>;
+  constexpr int LG = 18, N = 5120, TOP_K = 6, ROUTES = M * TOP_K;
+  constexpr int RS = (ROUTES * 648 + 255) / 256 * 256, QB = ROUTES * 576;
+  __shared__ __align__(16) uint32_t book[FB::kSmemWords];
+  __shared__ int s_e[36], s_cnt[36], s_route[36][6], s_key[36], s_nu, s_next;
+  __shared__ half s_v[36][kDnRows];
+  const int t = threadIdx.x, lane = t & 31, warp = t >> 5;
+  const int r4 = lane >> 3, sub = lane & 7;
+  const int row0 = blockIdx.x * kDnRows;
+
+  if (t < 36) {
+    s_e[t] = __ldg(plan + 1 + t);
+    s_cnt[t] = __ldg(plan + 37 + t);
+    s_key[t] = -1;
+  } else if (t >= 64 && t < 64 + 216) {
+    s_route[(t - 64) / 6][(t - 64) % 6] = __ldg(plan + 73 + (t - 64));
+  } else if (t == 40) {
+    s_nu = __ldg(plan);
+    s_next = kDnWarps;
+  }
+  // First unit's weights in flight while the table is built.
+  const int units = 4 * __ldg(plan);
+  int u = warp;
+  DnRaw<Type> raw;
+  using Ptr = typename DnRaw<Type>::Ptr;
+  if (u < units) {
+    const int q0 = u >> 2, c0 = __ldg(plan + 37 + q0);
+#pragma unroll
+    for (int c = 0; c < 6; ++c) {
+      if (c >= c0) break;
+      dn_prefetch_route<RS, QB>(gathered, __ldg(plan + 73 + 6 * q0 + c), lane);
+    }
+    const Ptr p0(down + (int64_t(__ldg(plan + 1 + (u >> 2))) * rows_local +
+                         row0 + (u & 3) * 4 + r4) *
+                            row_stride,
+                 sub);
+    raw.set(p0);
+#pragma unroll
+    for (int j = 0; j < 9; ++j) raw.load(j, p0);
+  }
+  // Lane byte offsets into the replicated tables, kept in registers (opaque
+  // to the compiler, which would otherwise re-mask the lane per lookup).
+  uint32_t lg = uint32_t(lane) * 4, ls = uint32_t(lane & 15) * 4;
+#if defined(__CUDA_ARCH__)
+  asm volatile("" : "+r"(lg), "+r"(ls));
+#endif
+  fill_book<Type>(book, fbook, t, 32 * kDnWarps);
+  __syncthreads();
+  const int nu = s_nu;
+  if (warp == kDnWarps - 1) {
+    // Old accumulation order of token k: class q % classes, then q, then c.
+    for (int i = lane; i < 216; i += 32) {
+      const int q = i / 6, c = i % 6;
+      if (q < nu && c < s_cnt[q])
+        s_key[s_route[q][c]] = (q % classes) << 16 | q << 3 | c;
+    }
+  }
+  const uint8_t* const gq = gathered + 32 * sub;
+  const float* const gd = reinterpret_cast<const float*>(gathered + QB) + sub;
+  while (u < units) {
+    int nxt = 0;
+    if (lane == 0) nxt = atomicAdd(&s_next, 1);
+    nxt = __shfl_sync(0xffffffffU, nxt, 0);
+    const bool more = nxt < units;
+    if (more) {
+      const int qn = nxt >> 2, cn = s_cnt[qn];
+#pragma unroll
+      for (int c = 0; c < 6; ++c) {
+        if (c >= cn) break;
+        dn_prefetch_route<RS, QB>(gathered, s_route[qn][c], lane);
+      }
+    }
+    Ptr np(down + (more ? (int64_t(s_e[nxt >> 2]) * rows_local + row0 +
+                           (nxt & 3) * 4 + r4) *
+                              row_stride
+                        : 0),
+           sub);
+    np.pin();
+    const int q = u >> 2, slab = u & 3, cnt = s_cnt[q];
+    int rt[6];
+#pragma unroll
+    for (int c = 0; c < 6; ++c) rt[c] = s_route[q][c];
+    const uint8_t* const pq0 = gq + rt[0] * (LG * 32);
+    const float* const pd0 = gd + rt[0] * LG;
+    float p[6] = {0.f, 0.f, 0.f, 0.f, 0.f, 0.f};
+#pragma unroll
+    for (int j = 0; j < 9; ++j) {
+      uint32_t w[8];
+      float d;
+      int m0, m1;
+      raw.decode(j, book, lg, ls, sub, w, d, m0, m1);
+      if (more) raw.load(j, np);
+      const int rank = act_rank(j, sub);  // (sub + 8 j) / 18
+      const int qo = 256 * j + rank * (RS - LG * 32);
+      const int dof = 8 * j + rank * ((RS - LG * 4) / 4);
+      {
+        int qv[8];
+        float xd;
+        load_act(pq0 + qo, pd0 + dof, qv, xd);
+        p[0] = fast_dot(w, qv, d, xd, m0, m1, p[0]);
+      }
+#pragma unroll
+      for (int c = 1; c < 6; ++c) {
+        if (c >= cnt) break;
+        int qv[8];
+        float xd;
+        load_act(gq + rt[c] * (LG * 32) + qo, gd + rt[c] * LG + dof, qv, xd);
+        p[c] = fast_dot(w, qv, d, xd, m0, m1, p[c]);
+      }
+    }
+#pragma unroll
+    for (int c = 0; c < 6; ++c) {
+      if (c >= cnt) break;
+      p[c] += __shfl_xor_sync(0xffffffffU, p[c], 1);
+      p[c] += __shfl_xor_sync(0xffffffffU, p[c], 2);
+      p[c] += __shfl_xor_sync(0xffffffffU, p[c], 4);
+      if (sub == 0) s_v[rt[c]][slab * 4 + r4] = __float2half_rn(p[c]);
+    }
+    if (more) raw.set(np);
+    u = nxt;
+  }
+  __syncthreads();
+  if (t < kDnRows * M) {
+    const int k = t / kDnRows, rl = t % kDnRows;
+    int key[TOP_K];
+#pragma unroll
+    for (int i = 0; i < TOP_K; ++i) key[i] = s_key[k * TOP_K + i];
+    float total = 0.f, acc = 0.f;
+    int last = -1, cls = -1;
+#pragma unroll
+    for (int n = 0; n < TOP_K; ++n) {
+      int best = 0x7fffffff, bi = 0;
+#pragma unroll
+      for (int i = 0; i < TOP_K; ++i)
+        if (key[i] > last && key[i] < best) {
+          best = key[i];
+          bi = i;
+        }
+      if (best != 0x7fffffff) {
+        last = best;
+        if ((best >> 16) != cls) {
+          if (cls >= 0) total += acc;
+          acc = 0.f;
+          cls = best >> 16;
+        }
+        acc += __half2float(s_v[k * TOP_K + bi][rl]);
+      }
+    }
+    if (cls >= 0) total += acc;
+    out[k * N + row_base + row0 + rl] = __float2half_rn(total);
+#pragma unroll
+    for (int o = 0; o < 4; ++o)
+      if (o * rows_local != row_base)
+        out[k * N + o * rows_local + row0 + rl] = __float2half_rn(0.f);
+  }
+}
+
+#endif  // __CUDACC__
+}  // namespace v41k_fast
diff --git a/benchmarks/deepseek_v41/v41k/v41k_fast_gu.cuh b/benchmarks/deepseek_v41/v41k/v41k_fast_gu.cuh
new file mode 100644
index 0000000000..fd21e0df24
--- /dev/null
+++ b/benchmarks/deepseek_v41/v41k/v41k_fast_gu.cuh
@@ -0,0 +1,296 @@
+// EXPERT_FAST gate/up (VLLM_V41_EXPERT_FAST=1): gate_up_fast<Type>, a
+// bit-identical replacement for v41k::gate_up_em5<Type> in plan mode (the
+// kernel gate_up7 and gate_up7p launch).
+//
+// Same 512 threads per (expert, 32-row slab) and the same thread -> work map:
+// row = slab * 32 + warp * 2 + lane / 16, lane l = lane % 16 takes groups l +
+// 16 i (i = 0..9) of the 160 K groups, block (l / 8) + 2 i, sub-block l % 8.
+// The grid is persistent (one CTA per SM walks the 18 nu units) instead of
+// one CTA per unit. Per member c the gate
+// and up partials are the same serial chain FFMA(FMUL(FMUL(d, xd), I2F(s0 m0
+// + s1 m1)), 0.125, acc) from +0 over i, the same xor 8, 4, 2, 1 butterfly,
+// and the epilogue (half rounding, clamp 10, silu with expf, x up x prob,
+// half rounding, q8_warp_aligned) is the old code. Only the decode differs:
+// PRMT selectors over the bank-replicated fast table (v41k_fast.cuh, proved
+// equal to Group3 for every code), filled once per CTA while the first
+// weights are in flight, and weights loaded two steps ahead. Memory hints
+// that do not touch values: weights are loaded L1::evict_first and the next
+// unit's member activations are prefetched into L1, so activation loads hit
+// L1 instead of exposing L2 latency at every step (the limit measured on
+// down_rows_fast before the same change).
+//
+// Included by v41k.cu after v41k::load_q8 and v41k::q8_warp_aligned.
+#pragma once
+#include "v41k_fast.cuh"
+
+#if defined(__CUDACC__)
+namespace v41k_fast {
+
+// One sub-block (32 weights) of one row for step i = block (l / 8) + 2 i.
+template <int Type>
+struct GuRaw;
+template <>
+struct GuRaw<29> {  // IQ1_M, 56-byte blocks; a step advances 112 bytes
+  struct Ptr {
+    const uint8_t *qsp, *qhp, *scp;
+    __device__ __forceinline__ Ptr(const uint8_t* blk, int sub)
+        : qsp(blk + 4 * sub), qhp(blk + 32 + 2 * sub), scp(blk + 48) {}
+    __device__ __forceinline__ void pin() {
+      pin_ptr(qsp);
+      pin_ptr(qhp);
+      pin_ptr(scp);
+    }
+  };
+  uint32_t qs, qh, s01, s23;
+  __device__ __forceinline__ void load(const Ptr& p, int i) {
+    qs = ldw32(p.qsp + 112 * i);
+    qh = ldw16(p.qhp + 112 * i);
+    const uint2 sc = ldw64(p.scp + 112 * i);
+    s01 = sc.x;
+    s23 = sc.y;
+  }
+  int sub;
+  __device__ __forceinline__ void decode(const uint32_t* book, uint32_t,
+                                         uint32_t, uint32_t, uint32_t (&w)[8],
+                                         float& d, int& m0, int& m1) const {
+    dec29(qs, qh, s01, s23, sub, book, w, m0, m1);
+    d = __half2float(__ushort_as_half(iq1m_d_bits(s01, s23)));
+  }
+};
+// IQ2_XXS / IQ2_XS: the 8 sub-block bytes at block + 2 + 8 sub as three
+// aligned words. Rows start 4-byte aligned (checked by the host) and BB = 2
+// (mod 4), so block l / 8 + 2 i starts 2 (l < 8) or 0 bytes into a word: the
+// funnel shift is 16 or 0 bits, fixed per lane.
+template <int BB>
+struct GuPtrIQ2 {
+  const uint32_t* pw;  // aligned word holding the sub-block's first byte
+  const uint8_t* dp;   // block start (fp16 d)
+  __device__ __forceinline__ GuPtrIQ2(const uint8_t* blk, int sub) : dp(blk) {
+    const uintptr_t x = reinterpret_cast<uintptr_t>(blk + 2 + 8 * sub);
+    pw = reinterpret_cast<const uint32_t*>(x & ~uintptr_t(3));
+  }
+  __device__ __forceinline__ void pin() {
+    pin_ptr(pw);
+    pin_ptr(dp);
+  }
+};
+template <>
+struct GuRaw<16> {  // IQ2_XXS, 66-byte blocks; a step advances 132 bytes
+  using Ptr = GuPtrIQ2<66>;
+  uint32_t x0, x1, x2, dh;
+  __device__ __forceinline__ void load(const Ptr& p, int i) {
+    x0 = ldw32(p.pw + 33 * i);
+    x1 = ldw32(p.pw + 33 * i + 1);
+    x2 = ldw32(p.pw + 33 * i + 2);
+    dh = ldw16(p.dp + 132 * i);
+  }
+  __device__ __forceinline__ void decode(const uint32_t* book, uint32_t lg,
+                                         uint32_t ls, uint32_t sh,
+                                         uint32_t (&w)[8], float& d, int& m0,
+                                         int& m1) const {
+    dec16(__funnelshift_r(x0, x1, sh), __funnelshift_r(x1, x2, sh), book, lg,
+          ls, w, m0, m1);
+    d = __half2float(__ushort_as_half((unsigned short)dh));
+  }
+};
+template <>
+struct GuRaw<17> {  // IQ2_XS, 74-byte blocks; a step advances 148 bytes
+  struct Ptr : GuPtrIQ2<74> {
+    const uint8_t* scp;  // scale byte of the sub-block
+    __device__ __forceinline__ Ptr(const uint8_t* blk, int sub)
+        : GuPtrIQ2<74>(blk, sub), scp(blk + 66 + sub) {}
+    __device__ __forceinline__ void pin() {
+      GuPtrIQ2<74>::pin();
+      pin_ptr(scp);
+    }
+  };
+  uint32_t x0, x1, x2, dh, sc;
+  __device__ __forceinline__ void load(const Ptr& p, int i) {
+    x0 = ldw32(p.pw + 37 * i);
+    x1 = ldw32(p.pw + 37 * i + 1);
+    x2 = ldw32(p.pw + 37 * i + 2);
+    dh = ldw16(p.dp + 148 * i);
+    sc = ldw8(p.scp + 148 * i);
+  }
+  __device__ __forceinline__ void decode(const uint32_t* book, uint32_t,
+                                         uint32_t ls, uint32_t sh,
+                                         uint32_t (&w)[8], float& d, int& m0,
+                                         int& m1) const {
+    dec17(__funnelshift_r(x0, x1, sh), __funnelshift_r(x1, x2, sh), sc, book,
+          ls, w, m0, m1);
+    d = __half2float(__ushort_as_half((unsigned short)dh));
+  }
+};
+
+// Per-unit plan entries: expert, member count, member Q8 row offsets.
+struct GuUnit {
+  int u, e, cnt, tok[6];  // tok[c] = (route / 6) * 160
+};
+__device__ __forceinline__ GuUnit gu_unit(const int* __restrict__ plan,
+                                          int unit) {
+  GuUnit g;
+  g.u = unit / 18;
+  g.e = __ldg(plan + 1 + g.u);
+  g.cnt = __ldg(plan + 37 + g.u);
+#pragma unroll
+  for (int c = 0; c < 6; ++c)
+    g.tok[c] = c < g.cnt ? __ldg(plan + 73 + 6 * g.u + c) / 6 * 160 : 0;
+  return g;
+}
+
+// Q8 activations of a unit's member tokens (xq 5120 B, xd 640 B each) into
+// L1, one line per thread: t = 47 c + k, k = 0..39 the xq lines from its first
+// byte, 40 its last byte, 41..45 the xd lines, 46 its last byte. Threads past
+// 47 cnt do nothing; every address is inside the token's own bytes.
+__device__ __forceinline__ void gu_prefetch(const GuUnit& g,
+                                            const int8_t* xq, const float* xd,
+                                            int t) {
+  const int c = t / 47, k = t - 47 * c;
+  if (c >= g.cnt) return;
+  int base = g.tok[0];  // select tok[c] without a dynamic register index
+#pragma unroll
+  for (int i = 1; i < 6; ++i) base = c == i ? g.tok[i] : base;
+  const char* q = reinterpret_cast<const char*>(xq) + int64_t(base) * 32;
+  const char* d = reinterpret_cast<const char*>(xd + base);
+  prefetch_l1(k < 40    ? q + 128 * k
+              : k == 40 ? q + 5119
+              : k < 46  ? d + 128 * (k - 41)
+                        : d + 639);
+}
+
+// Persistent: gridDim.x CTAs (one per SM) walk units = (distinct expert u,
+// 32-row slab) round-robin, unit = blockIdx.x + k gridDim.x < 18 nu. The
+// table is filled once per CTA. Weights are loaded two steps ahead (even /
+// odd raw sets); the last two steps of a unit load the next unit's first two.
+// The next unit's member activations are prefetched into L1 when the unit
+// starts, the first unit's with its first weights.
+template <int Type>
+__global__ void __launch_bounds__(512, 1)
+    gate_up_fast(int8_t* __restrict__ hq, float* __restrict__ hd,
+                 const int8_t* __restrict__ xq, const float* __restrict__ xd,
+                 const float* __restrict__ prob,
+                 const uint8_t* __restrict__ gate,
+                 const uint8_t* __restrict__ up, int row_stride,
+                 const uint32_t* __restrict__ fbook,
+                 const int* __restrict__ plan) {
+  using FB = FastBook<Type>;
+  using Raw = GuRaw<Type>;
+  using Ptr = typename Raw::Ptr;
+  constexpr int STEPS = 10, SLABS = 18;
+  __shared__ __align__(16) uint32_t book[FB::kSmemWords];
+  __shared__ float red[2][6][2][32];
+  const int t = threadIdx.x, warp = t >> 5, lane = t & 31;
+  const int units = SLABS * __ldg(plan);
+  int unit = blockIdx.x;
+  if (unit >= units) return;
+  const int l = lane & 15, sub = l & 7;
+  const int lrow = warp * 2 + lane / 16;
+  const int boff = (l >> 3) * FB::kBlock;
+  auto rows = [&](int un, int e) {
+    return (int64_t(e) * 576 + (un % SLABS) * 32 + lrow) * row_stride + boff;
+  };
+  GuUnit cur = gu_unit(plan, unit);
+  Ptr pg(gate + rows(unit, cur.e), sub), pu(up + rows(unit, cur.e), sub);
+  pg.pin();
+  pu.pin();
+  Raw ga, ua, gb, ub;  // steps 2k / 2k + 1
+  if constexpr (Type == 29) ga.sub = ua.sub = gb.sub = ub.sub = sub;
+  gu_prefetch(cur, xq, xd, t);
+  ga.load(pg, 0);  // in flight while the table is filled
+  ua.load(pu, 0);
+  gb.load(pg, 1);
+  ub.load(pu, 1);
+  uint32_t lg = uint32_t(lane) * 4, ls = uint32_t(lane & 15) * 4;
+  uint32_t sh = l < 8 ? 16 : 0;
+#if defined(__CUDA_ARCH__)
+  asm volatile("" : "+r"(lg), "+r"(ls), "+r"(sh));
+#endif
+  fill_book<Type>(book, fbook, t, 512);
+  __syncthreads();
+  int buf = 0;
+  while (true) {
+    const int nunit = unit + int(gridDim.x);
+    const bool more = nunit < units;
+    const GuUnit nxt = more ? gu_unit(plan, nunit) : cur;
+    if (more) gu_prefetch(nxt, xq, xd, t);
+    float gs[6] = {0.f, 0.f, 0.f, 0.f, 0.f, 0.f};
+    float us[6] = {0.f, 0.f, 0.f, 0.f, 0.f, 0.f};
+    auto step = [&](Raw& rg, Raw& ru, int i, int ahead) {
+      uint32_t wg[8], wu[8];
+      float dg, du;
+      int mg0, mg1, mu0, mu1;
+      rg.decode(book, lg, ls, sh, wg, dg, mg0, mg1);
+      ru.decode(book, lg, ls, sh, wu, du, mu0, mu1);
+      rg.load(pg, ahead);
+      ru.load(pu, ahead);
+      const int group = l + 16 * i;
+      {
+        int q[8];
+        float d;
+        v41k::load_q8(xq, xd, cur.tok[0] + group, q, d);
+        gs[0] = fast_dot(wg, q, dg, d, mg0, mg1, gs[0]);
+        us[0] = fast_dot(wu, q, du, d, mu0, mu1, us[0]);
+      }
+#pragma unroll
+      for (int c = 1; c < 6; ++c) {
+        if (c >= cur.cnt) break;  // block-uniform
+        int q[8];
+        float d;
+        v41k::load_q8(xq, xd, cur.tok[c] + group, q, d);
+        gs[c] = fast_dot(wg, q, dg, d, mg0, mg1, gs[c]);
+        us[c] = fast_dot(wu, q, du, d, mu0, mu1, us[c]);
+      }
+    };
+#pragma unroll 1
+    for (int k = 0; k < STEPS / 2; ++k) {
+      int ahead = 2 * k + 2;
+      if (k == STEPS / 2 - 1) {  // steps 8, 9: load the next unit's 0, 1
+        ahead = 0;
+        if (more) {
+          pg = Ptr(gate + rows(nunit, nxt.e), sub);
+          pu = Ptr(up + rows(nunit, nxt.e), sub);
+          pg.pin();
+          pu.pin();
+        }  // else: harmless reload of this unit's steps 0, 1
+      }
+      step(ga, ua, 2 * k, ahead);
+      step(gb, ub, 2 * k + 1, ahead + 1);
+    }
+#pragma unroll
+    for (int c = 0; c < 6; ++c) {
+      if (c >= cur.cnt) break;
+#pragma unroll
+      for (int o = 8; o; o >>= 1) {
+        gs[c] += __shfl_xor_sync(0xffffffffU, gs[c], o);
+        us[c] += __shfl_xor_sync(0xffffffffU, us[c], o);
+      }
+      if (lane % 16 == 0) {
+        red[buf][c][0][lrow] = gs[c];
+        red[buf][c][1][lrow] = us[c];
+      }
+    }
+    // red[buf] is rewritten two units later, after the next barrier, which
+    // every thread reaches only after this unit's epilogue.
+    __syncthreads();
+    // Epilogue: v41k::gate_up_em5's, verbatim.
+    if (warp < cur.cnt) {
+      const int route = __ldg(plan + 73 + 6 * cur.u + warp);
+      float g16 = __half2float(__float2half_rn(red[buf][warp][0][lane]));
+      float u16 = __half2float(__float2half_rn(red[buf][warp][1][lane]));
+      g16 = g16 > 10.f ? 10.f : g16;
+      u16 = u16 > 10.f ? 10.f : (u16 < -10.f ? -10.f : u16);
+      const float act = __fdiv_rn(g16, __fadd_rn(1.f, expf(-g16)));
+      const float value = __half2float(
+          __float2half_rn(__fmul_rn(__fmul_rn(act, u16), prob[route])));
+      v41k::q8_warp_aligned(hq, hd, int64_t(route) * 18 + unit % SLABS,
+                            value);
+    }
+    if (!more) break;
+    unit = nunit;
+    cur = nxt;
+    buf ^= 1;
+  }
+}
+
+}  // namespace v41k_fast
+#endif  // __CUDACC__
