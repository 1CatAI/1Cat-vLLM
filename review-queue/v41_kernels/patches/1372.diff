index 0000000000..c4e46f7d0f
--- /dev/null
+++ b/benchmarks/deepseek_v41/v41idx/check_v41idx.py
@@ -0,0 +1,370 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""GPU check of v41idx.index_scores_tiled (run with no serving workload).
+
+Every case runs three kernels on the same inputs and NaN-poisoned outputs:
+  v41k   torch.ops.v41k.index_scores_decode from the reference v41k.so (--v41k)
+  ref    torch.ops.v41idx.index_scores_ref (the embedded verbatim copy)
+  tiled  torch.ops.v41idx.index_scores_tiled (the new kernel)
+and requires tiled == v41k and ref == v41k BITWISE over the whole output row
+(written columns and the poison past the live end), plus a minimum number of
+written / finite values so the comparison is not of poison alone.
+
+Matrix: heads 8 (tokens 1..8) and 4 (tokens 1..16); capacities 1, 63, 64, 65,
+1000, 4097, 65536, 131072; live ends 0, 1, 31, 32, 63, 64, 65, 1000, 37500,
+75000 and the capacity, plus stale ends 64 keys beyond aligned capacity;
+ratio 1, 4, 8 (positions[-1] at
+every offset inside the ratio group); realistic keys (scale exponents near
+the observed range) and full-range keys (every scale byte, NaN/Inf scales);
+normal and extreme q / weights (+-65504, Inf, NaN); a plain output and a
+bank-like one (rows of a wider [16, width] buffer, as bank.partial[:tokens]).
+Then CUDA graphs: one capture replayed with changed positions (live ends
+5 .. capacity + 64) against eager v41k, and, in a fresh process, a capture whose
+first-ever tiled call is inside the capture (T 6 and T 8). Then timing in
+graphs (TIME lines, us per call, tiled vs reference v41k).
+
+  --quick      reduced matrix (TP4 runs); --sanitize: small grid for
+  compute-sanitizer (one capacity past 2 CTAs x SMs so the persistent loop
+  turns), no graphs, no timing; --no-time; --json PATH. Exit 0 only when every check
+  passes ("ALL OK"); any mismatch or exception -> "FAILED", exit 1.
+"""
+
+import argparse
+import json
+import os
+import subprocess
+import sys
+import time
+
+import torch
+
+POISON_BASE = 0x7E00
+
+
+def load(lib, v41k):
+    torch.ops.load_library(v41k)
+    torch.ops.load_library(lib)
+    assert hasattr(torch.ops.v41k, "index_scores_decode"), v41k
+    assert int(torch.ops.v41idx.version()) == 1, lib
+
+
+def poison(rows, width, dev):
+    p = (
+        torch.arange(rows * width, device=dev, dtype=torch.int32) & 0x1FF
+    ) | POISON_BASE
+    return p.to(torch.int16).view(torch.float16).reshape(rows, width)
+
+
+def make_keys(cap, mode, gen, dev):
+    k = torch.randint(0, 256, (cap, 68), generator=gen, dtype=torch.uint8, device="cpu")
+    if mode == "real":
+        # biased E8M0 exponents around the observed index-key range (2^-12 .. 2^4)
+        k[:, 64:] = torch.randint(115, 132, (cap, 4), generator=gen, dtype=torch.uint8)
+    else:
+        k[:, 64:] = torch.randint(0, 256, (cap, 4), generator=gen, dtype=torch.uint8)
+        if cap >= 4:
+            k[0, 64:] = 255  # NaN/Inf scale
+            k[1, 64:] = 0  # zero scale
+            k[2, 64:] = 254
+            k[3, 64:] = 1
+    return k.to(dev)
+
+
+def make_qw(rows, mode, gen, dev):
+    q = torch.randn(rows, 128, generator=gen, dtype=torch.float32)
+    w = torch.randn(rows, generator=gen, dtype=torch.float32) * 0.5
+    if mode == "extreme":
+        q[0, 0] = 65504.0
+        q[0, 1] = -65504.0
+        q[0, 5] = float("inf")
+        w[0] = 65504.0
+        if rows > 1:
+            q[1, 7] = float("nan")
+            w[1] = float("-inf")
+        if rows > 2:
+            q[2, :] = 1000.0
+            w[2] = -0.0
+        if rows > 3:
+            w[3] = float("nan")
+    return q.half().to(dev).contiguous(), w.half().to(dev).contiguous()
+
+
+def positions_for(tokens, end, ratio, off):
+    """tokens consecutive positions whose last one gives (p + 1) // ratio == end."""
+    last = ratio - 2 - off if end == 0 else end * ratio - 1 + off
+    return torch.arange(last - tokens + 1, last + 1, dtype=torch.int64).clamp_min(0)
+
+
+class Stats:
+    def __init__(self):
+        self.cases = 0
+        self.bad = []
+        self.written = 0
+        self.finite = 0
+
+    def ok(self):
+        return not self.bad
+
+
+def run_case(st, H, T, keys, q, w, pos, ratio, bank, tag):
+    dev = keys.device
+    cap = keys.shape[0]
+    width = cap + 40 if bank else cap
+    outs = {}
+    for name in ("v41k", "ref", "tiled"):
+        if bank:
+            buf = poison(16, width, dev)
+            o = buf[:T]
+        else:
+            o = poison(T, width, dev)
+        args = (o, q, w, keys, pos, H, ratio)
+        if name == "v41k":
+            torch.ops.v41k.index_scores_decode(*args)
+        elif name == "ref":
+            torch.ops.v41idx.index_scores_ref(*args)
+        else:
+            torch.ops.v41idx.index_scores_tiled(*args)
+        outs[name] = o
+    a = outs["v41k"].view(torch.int16)
+    st.cases += 1
+    for name in ("ref", "tiled"):
+        b = outs[name].view(torch.int16)
+        if not torch.equal(a, b):
+            n = int((a != b).sum().item())
+            st.bad.append(f"{tag} {name}!=v41k ({n} values)")
+    pz = poison(T, width, dev).view(torch.int16)
+    if bank and not torch.equal(outs["tiled"].view(torch.int16)[:, cap:], pz[:, cap:]):
+        st.bad.append(f"{tag} tiled wrote guard columns beyond capacity")
+    written = a != pz
+    st.written += int(written.sum().item())
+    st.finite += int((written & torch.isfinite(outs["v41k"])).sum().item())
+
+
+def matrix(st, dev, quick, sanitize, seed=517):
+    gen = torch.Generator().manual_seed(seed)
+    if sanitize:
+        # 12000 keys = 188 blocks > 2 CTAs x 80 SMs: the persistent loop runs twice
+        caps, hts = [65, 12000], [(8, 1), (8, 6), (8, 8), (4, 16)]
+    elif quick:
+        caps = [64, 65, 4097, 131072]
+        hts = [(8, t) for t in (1, 2, 6, 8)] + [(4, t) for t in (1, 6, 16)]
+    else:
+        caps = [1, 63, 64, 65, 1000, 4097, 65536, 131072]
+        hts = [(8, t) for t in range(1, 9)] + [(4, t) for t in range(1, 17)]
+    ends_all = [0, 1, 31, 32, 63, 64, 65, 1000, 37500, 75000]
+    ratios = [1, 4] if sanitize else [1, 4, 8]
+    for cap in caps:
+        for kmode in ("real", "full"):
+            keys = make_keys(cap, kmode, gen, dev)
+            ends = sorted({e for e in ends_all if e <= cap} | {cap})
+            if sanitize or quick:
+                ends = sorted({e for e in (0, 1, 63, 65, cap // 2, cap) if e <= cap})
+            # A full reference CTA ends exactly at aligned capacity; stale live
+            # positions must not make the tiled loop exceed that allocation.
+            if cap % 32 == 0:
+                ends = sorted(set(ends) | {cap + 64})
+            for H, T in hts:
+                for qmode in ("normal",) if sanitize else ("normal", "extreme"):
+                    q, w = make_qw(T * H, qmode, gen, dev)
+                    for ratio in ratios:
+                        for end in ends:
+                            if end == 0 and ratio < 2:
+                                continue
+                            offs = {0, ratio - 1} if end else {0}
+                            for off in sorted(offs):
+                                if end == 0 and off > ratio - 2:
+                                    continue
+                                pos = positions_for(T, end, ratio, off).to(dev)
+                                for bank in (True,) if sanitize else (False, True):
+                                    tag = (
+                                        f"H{H} T{T} cap{cap} {kmode}/{qmode} r{ratio} "
+                                        f"end{end}+{off} {'bank' if bank else 'plain'}"
+                                    )
+                                    run_case(
+                                        st, H, T, keys, q, w, pos, ratio, bank, tag
+                                    )
+    torch.cuda.synchronize()
+
+
+def graph_replay(st, dev):
+    """One capture, replayed with changed positions; compared with eager v41k."""
+    gen = torch.Generator().manual_seed(7)
+    H, T, cap = 8, 6, 131072
+    keys = make_keys(cap, "real", gen, dev)
+    q, w = make_qw(T * H, "normal", gen, dev)
+    pos = positions_for(T, 1, 4, 0).to(dev)
+    out = poison(T, cap + 40, dev)
+    torch.ops.v41idx.index_scores_tiled(out, q, w, keys, pos, H, 4)  # warm (eager)
+    torch.cuda.synchronize()
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g):
+        torch.ops.v41idx.index_scores_tiled(out, q, w, keys, pos, H, 4)
+    for end in (5, 64, 65, 1000, 37500, 75000, cap - 1, cap, cap + 64):
+        for off in (0, 3):
+            pos.copy_(positions_for(T, end, 4, off).to(dev))
+            out.copy_(poison(T, cap + 40, dev))
+            g.replay()
+            ref = poison(T, cap + 40, dev)
+            torch.ops.v41k.index_scores_decode(ref, q, w, keys, pos, H, 4)
+            torch.cuda.synchronize()
+            st.cases += 1
+            if not torch.equal(out.view(torch.int16), ref.view(torch.int16)):
+                st.bad.append(f"graph replay end{end}+{off}: tiled!=v41k")
+            guard = poison(T, 40, dev).view(torch.int16)
+            if not torch.equal(out.view(torch.int16)[:, cap:], guard):
+                st.bad.append(f"graph replay end{end}+{off}: guard columns changed")
+
+
+FIRST_IN_CAPTURE = r"""
+import sys, torch
+sys.path.insert(0, {here!r})
+import check_v41idx as c
+c.load({lib!r}, {v41k!r})
+dev = torch.device("cuda:0")
+torch.cuda.init()
+gen = torch.Generator().manual_seed(11)
+H, T, cap = 8, {T}, 65536
+keys = c.make_keys(cap, "real", gen, dev)
+q, w = c.make_qw(T * H, "normal", gen, dev)
+pos = c.positions_for(T, 30000, 4, 1).to(dev)
+out = c.poison(T, cap, dev)
+torch.cuda.synchronize()
+g = torch.cuda.CUDAGraph()
+with torch.cuda.graph(g):
+    torch.ops.v41idx.index_scores_tiled(out, q, w, keys, pos, H, 4)
+g.replay()
+ref = c.poison(T, cap, dev)
+torch.ops.v41k.index_scores_decode(ref, q, w, keys, pos, H, 4)
+torch.cuda.synchronize()
+print("FIRSTCAP", "OK" if torch.equal(out.view(torch.int16), ref.view(torch.int16)) else "MISMATCH")
+"""
+
+
+def first_call_in_capture(st, lib, v41k):
+    here = os.path.dirname(os.path.abspath(__file__))
+    for T in (6, 8):
+        r = subprocess.run(
+            [
+                sys.executable,
+                "-I",
+                "-c",
+                FIRST_IN_CAPTURE.format(here=here, lib=lib, v41k=v41k, T=T),
+            ],
+            capture_output=True,
+            text=True,
+        )
+        st.cases += 1
+        if r.returncode != 0 or "FIRSTCAP OK" not in r.stdout:
+            st.bad.append(
+                f"first call inside capture T{T}: rc={r.returncode} "
+                f"{(r.stdout + r.stderr)[-300:]}"
+            )
+
+
+def timing(dev, lines):
+    gen = torch.Generator().manual_seed(3)
+    H, T = 8, 6
+    for cap in (65536, 131072):
+        keys = make_keys(cap, "real", gen, dev)
+        q, w = make_qw(T * H, "normal", gen, dev)
+        for end in (1000, 10000, 37500, 75000, 131072):
+            if end > cap:
+                continue
+            pos = positions_for(T, end, 4, 0).to(dev)
+            res = {}
+            for name in ("v41k", "tiled"):
+                out = poison(T, cap, dev)
+                op = (
+                    torch.ops.v41k.index_scores_decode
+                    if name == "v41k"
+                    else torch.ops.v41idx.index_scores_tiled
+                )
+                op(out, q, w, keys, pos, H, 4)
+                torch.cuda.synchronize()
+                g = torch.cuda.CUDAGraph()
+                with torch.cuda.graph(g):
+                    for _ in range(20):
+                        op(out, q, w, keys, pos, H, 4)
+                for _ in range(5):
+                    g.replay()
+                s, e = (
+                    torch.cuda.Event(enable_timing=True),
+                    torch.cuda.Event(enable_timing=True),
+                )
+                s.record()
+                for _ in range(50):
+                    g.replay()
+                e.record()
+                torch.cuda.synchronize()
+                res[name] = s.elapsed_time(e) * 1000.0 / (50 * 20)
+            line = (
+                f"TIME H{H} T{T} cap{cap} keys{end}: v41k {res['v41k']:.1f} us "
+                f"tiled {res['tiled']:.1f} us ({res['v41k'] / res['tiled']:.2f}x)"
+            )
+            print(line, flush=True)
+            lines.append(line)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--lib", required=True, help="v41idx.so under test")
+    ap.add_argument(
+        "--v41k", required=True, help="the reference v41k.so (VLLM_V41K_LIB)"
+    )
+    ap.add_argument("--quick", action="store_true")
+    ap.add_argument("--sanitize", action="store_true")
+    ap.add_argument("--no-time", action="store_true")
+    ap.add_argument("--json")
+    a = ap.parse_args()
+    t0 = time.time()
+    load(a.lib, a.v41k)
+    dev = torch.device("cuda:0")
+    print(
+        f"DEVICE {torch.cuda.get_device_name(dev)} SMs "
+        f"{torch.cuda.get_device_properties(dev).multi_processor_count} "
+        f"grid(131072)={int(torch.ops.v41idx.grid_for(131072, 0))}",
+        flush=True,
+    )
+    st = Stats()
+    matrix(st, dev, a.quick, a.sanitize)
+    print(
+        f"MATRIX {st.cases} cases, {st.written} values written by v41k "
+        f"({st.finite} finite), {len(st.bad)} mismatched cases",
+        flush=True,
+    )
+    min_written = 2000 if a.sanitize else 100000
+    if st.written < min_written or st.finite < min_written // 2:
+        st.bad.append(f"coverage too low: written {st.written} finite {st.finite}")
+    if not a.sanitize:
+        graph_replay(st, dev)
+        first_call_in_capture(st, a.lib, a.v41k)
+        print(f"GRAPHS done, {len(st.bad)} mismatched cases so far", flush=True)
+    lines = []
+    if not (a.no_time or a.sanitize):
+        timing(dev, lines)
+    for b in st.bad[:20]:
+        print("FAIL", b)
+    ok = st.ok()
+    print(
+        ("ALL OK" if ok else "FAILED")
+        + f" ({st.cases} cases, {time.time() - t0:.0f} s)"
+    )
+    if a.json:
+        with open(a.json, "w") as f:
+            json.dump(
+                {
+                    "ok": ok,
+                    "cases": st.cases,
+                    "written": st.written,
+                    "finite": st.finite,
+                    "bad": st.bad[:200],
+                    "time": lines,
+                },
+                f,
+                indent=1,
+            )
+    sys.exit(0 if ok else 1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/benchmarks/deepseek_v41/v41idx/v41idx.cu b/benchmarks/deepseek_v41/v41idx/v41idx.cu
new file mode 100644
index 0000000000..e922ff2f41
--- /dev/null
+++ b/benchmarks/deepseek_v41/v41idx/v41idx.cu
@@ -0,0 +1,415 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+//
+// v41idx: VLLM_V41_INDEX_TILED decode index scorer for DeepSeek-V4.1 on SM70
+// Bitwise replacement of v41k::index_scores_decode on allocated live keys.
+//
+// Contract (the same as v41k::index_scores_decode, which stays the reference):
+//   q   fp16 [tokens * heads, 128]  (token-major rows), w fp16 [tokens * heads]
+//   keys uint8 [capacity, 68]: 64 B E2M1 nibbles (even element low) + 4 biased
+//        power-of-two scale exponents, one per 32 elements
+//   positions int64 [>= tokens]; end = min((last_position + 1) / ratio, capacity)
+//   out fp16, row stride out.size(1): out[t, n] for n < end only =
+//     fp16( sum_h fp16( relu( fp16( q[t,h] . k[n] ) ) * w[t,h] ) )
+//   with q . k accumulated as ONE fmaf chain over d = 0..127 in order, from
+//   0.f, the key values rounded to fp16 first, and the head sum in h order.
+//   Columns n >= end are never written.
+//
+// Why it is faster: the reference launches capacity / 32 CTAs (4096 at the
+// stage-2 capacity of 131072 rows) and each thread computes one (key, token)
+// pair with two shared-memory loads per FMA; at short context almost all CTAs
+// only read positions and exit (25.6 / 48.9 us per call MEASURED at 0 keys),
+// and at 300K keys it runs ~1.2 TFLOP/s (497 / 1061 us per call). Here:
+//   - a persistent grid (<= 2 CTAs per SM) loops over 64-key blocks of the
+//     live prefix only;
+//   - q (FP32) and w are staged once per CTA; each 64-key block is decoded
+//     once into shared memory as fp16 (exactly the reference's rounded key);
+//   - each thread owns one token x H heads x 4 keys (4 * H accumulators) and
+//     reads operands with 128-bit (q) / 64-bit (k) shared loads.
+// Every (row, key) dot product is still the same fmaf chain in the same order
+// on the same operand values, and the epilogue is the reference's, so the
+// CPU host-compiled bodies below check bitwise equality. check_v41idx.py
+// supplies GPU/reference and capture checks, which still require qualification
+// after a rebase.
+//
+// The stage/tile bodies are __host__ __device__ so that v41idx_host_test.cu
+// runs the exact kernel code on the CPU (no GPU) with the CTA schedule.
+
+#include <cstdint>
+#include <cstring>
+#include <cmath>
+#include <cuda_fp16.h>
+
+#ifndef V41IDX_HOST_TEST
+  #include <mutex>
+  #include <torch/all.h>
+  #include <ATen/cuda/CUDAContext.h>
+  #include <c10/cuda/CUDAGuard.h>
+  #include <c10/cuda/CUDAException.h>
+#endif
+
+namespace v41idx {
+
+constexpr int KB = 64;      // keys per block
+constexpr int KL = 16;      // key lanes per token (threads per token)
+constexpr int KJ = KB / KL; // keys per thread (4): kl, kl + 16, kl + 32, kl + 48
+constexpr int QS = 132;     // q row stride in floats (528 B: 16-B aligned)
+constexpr int KS = 132;     // key row stride in halves (264 B: 8-B aligned; 16
+                            // consecutive rows start on banks 0, 2, .., 30)
+constexpr int KEY_BYTES = 68;
+constexpr int MAX_ROWS = 64;
+constexpr int MAX_THREADS = 256;
+
+__host__ __device__ constexpr int smem_bytes(int rows) {
+  return rows * QS * 4 + ((rows + 3) & ~3) * 4 + KB * KS * 2;
+}
+
+__host__ __device__ inline float bits_float(uint32_t u) {
+#ifdef __CUDA_ARCH__
+  return __uint_as_float(u);
+#else
+  float f;
+  memcpy(&f, &u, 4);
+  return f;
+#endif
+}
+
+// The reference's v41k_e2m1, operation for operation.
+__host__ __device__ inline float e2m1(int code) {
+  const int m = code & 7;
+  const float mag = m < 2 ? 0.5f * m
+                          : bits_float(uint32_t(((m >> 1) + 126) << 23) |
+                                       uint32_t((m & 1) << 22));
+  return (code & 8) ? -mag : mag;
+}
+
+// q rows -> FP32 shared rows (exactly __half2float of the input), w -> ws.
+__host__ __device__ inline void stage_q(int tid, int nt, const __half* q,
+                                        const __half* w, int rows, float* qs,
+                                        float* ws) {
+  for (int i = tid; i < rows * 128; i += nt) {
+    const int r = i / 128, d = i % 128;
+    qs[r * QS + d] = __half2float(q[r * 128 + d]);
+  }
+  for (int r = tid; r < rows; r += nt) ws[r] = __half2float(w[r]);
+}
+
+// Decode keys [n0, n0 + KB) into ks (fp16), zeros past end (never read for
+// output). One item = one 4-byte word = 8 elements of one key row.
+__host__ __device__ inline void stage_keys(int tid, int nt,
+                                           const uint8_t* keys, int64_t n0,
+                                           int64_t end, __half* ks) {
+  for (int i = tid; i < KB * 16; i += nt) {
+    const int k = i / 16, wd = i % 16;
+    const int64_t n = n0 + k;
+    __half h[8];
+    if (n < end) {
+      const uint8_t* row = keys + n * KEY_BYTES;
+      uint32_t word;
+#ifdef __CUDA_ARCH__
+      word = *reinterpret_cast<const uint32_t*>(row + 4 * wd);
+#else
+      memcpy(&word, row + 4 * wd, 4);
+#endif
+      // byte b = 4 wd + c; its scale is row[64 + (2 b) / 32] = row[64 + wd / 4]
+      const float scale = bits_float(uint32_t(row[64 + wd / 4]) << 23);
+#pragma unroll
+      for (int c = 0; c < 4; ++c) {
+        const int byte = int((word >> (8 * c)) & 255u);
+        const float lo = e2m1(byte & 15) * scale;
+        const float hi = e2m1((byte >> 4) & 15) * scale;
+        h[2 * c] = __float2half_rn(lo);
+        h[2 * c + 1] = __float2half_rn(hi);
+      }
+    } else {
+#pragma unroll
+      for (int c = 0; c < 8; ++c) h[c] = __float2half_rn(0.f);
+    }
+    __half* dst = ks + k * KS + 8 * wd;
+#ifdef __CUDA_ARCH__
+    uint2 a, b;
+    memcpy(&a, h, 8);
+    memcpy(&b, h + 4, 8);
+    reinterpret_cast<uint2*>(dst)[0] = a;
+    reinterpret_cast<uint2*>(dst)[1] = b;
+#else
+    memcpy(dst, h, 16);
+#endif
+  }
+}
+
+// One thread: token t, key lane kl (keys kl + 16 j), all H heads of t.
+template <int H>
+__host__ __device__ inline void tile(int t, int kl, const float* qs,
+                                     const __half* ks, const float* ws,
+                                     int64_t n0, int64_t end, __half* out,
+                                     int64_t n_out) {
+  float acc[H][KJ];
+#pragma unroll
+  for (int h = 0; h < H; ++h)
+#pragma unroll
+    for (int j = 0; j < KJ; ++j) acc[h][j] = 0.f;
+#ifdef V41IDX_MUTANT_ORDER
+  // CPU-test mutant only: reversed d order (must be caught as a mismatch).
+  for (int d = 124; d >= 0; d -= 4) {
+#else
+  for (int d = 0; d < 128; d += 4) {
+#endif
+    float kv[KJ][4];
+#pragma unroll
+    for (int j = 0; j < KJ; ++j) {
+      const __half* kp = ks + (kl + KL * j) * KS + d;
+      __half2 a, b;
+#ifdef __CUDA_ARCH__
+      const uint2 raw = *reinterpret_cast<const uint2*>(kp);
+      memcpy(&a, &raw.x, 4);
+      memcpy(&b, &raw.y, 4);
+#else
+      memcpy(&a, kp, 4);
+      memcpy(&b, kp + 2, 4);
+#endif
+      kv[j][0] = __low2float(a);
+      kv[j][1] = __high2float(a);
+      kv[j][2] = __low2float(b);
+      kv[j][3] = __high2float(b);
+    }
+#pragma unroll
+    for (int h = 0; h < H; ++h) {
+      const float* qp = qs + (t * H + h) * QS + d;
+      float qv[4];
+#ifdef __CUDA_ARCH__
+      const float4 q4 = *reinterpret_cast<const float4*>(qp);
+      qv[0] = q4.x;
+      qv[1] = q4.y;
+      qv[2] = q4.z;
+      qv[3] = q4.w;
+#else
+      memcpy(qv, qp, 16);
+#endif
+#ifdef V41IDX_MUTANT_ORDER
+#pragma unroll
+      for (int c = 3; c >= 0; --c)
+#else
+#pragma unroll
+      for (int c = 0; c < 4; ++c)
+#endif
+#pragma unroll
+        for (int j = 0; j < KJ; ++j)
+          acc[h][j] = fmaf(qv[c], kv[j][c], acc[h][j]);
+    }
+  }
+#pragma unroll
+  for (int j = 0; j < KJ; ++j) {
+    const int64_t n = n0 + kl + KL * j;
+    if (n >= end) continue;
+    float total = 0.f;
+#pragma unroll
+    for (int h = 0; h < H; ++h) {
+      float s = __half2float(__float2half_rn(acc[h][j]));
+      s = s > 0.f ? s : 0.f;
+      total += __half2float(__float2half_rn(s * ws[t * H + h]));
+    }
+    out[int64_t(t) * n_out + n] = __float2half_rn(total);
+  }
+}
+
+// Shared host/device bound: stale positions cannot extend an allocation.
+__host__ __device__ inline int64_t live_end(int64_t position, int ratio,
+                                           int64_t capacity) {
+  const int64_t end = (position + 1) / ratio;
+  return end < capacity ? end : capacity;
+}
+
+// Shared-memory carve-up for `rows` rows.
+struct Smem {
+  float* qs;
+  float* ws;
+  __half* ks;
+};
+__host__ __device__ inline Smem carve(unsigned char* base, int rows) {
+  Smem s;
+  s.qs = reinterpret_cast<float*>(base);
+  s.ws = s.qs + rows * QS;
+  s.ks = reinterpret_cast<__half*>(s.ws + ((rows + 3) & ~3));
+  return s;
+}
+
+#ifndef V41IDX_HOST_TEST
+template <int H>
+__global__ void __launch_bounds__(MAX_THREADS)
+    index_scores_tiled(const __half* __restrict__ q,
+                       const __half* __restrict__ w,
+                       const uint8_t* __restrict__ keys,
+                       const int64_t* __restrict__ positions,
+                       __half* __restrict__ out, int tokens, int64_t n_out,
+                       int ratio, int64_t capacity) {
+  extern __shared__ __align__(16) unsigned char smem[];
+  const int64_t end = live_end(positions[tokens - 1], ratio, capacity);
+  int64_t n0 = int64_t(blockIdx.x) * KB;
+  if (n0 >= end) return;
+  const int rows = tokens * H;
+  const Smem s = carve(smem, rows);
+  const int tid = threadIdx.x, nt = blockDim.x;
+  stage_q(tid, nt, q, w, rows, s.qs, s.ws);
+  const int t = tid / KL, kl = tid % KL;
+  for (; n0 < end; n0 += int64_t(gridDim.x) * KB) {
+    stage_keys(tid, nt, keys, n0, end, s.ks);
+    __syncthreads();
+    if (t < tokens) tile<H>(t, kl, s.qs, s.ks, s.ws, n0, end, out, n_out);
+    __syncthreads();
+  }
+}
+#endif
+
+}  // namespace v41idx
+
+#ifndef V41IDX_HOST_TEST
+  #include "v41idx_ref.cuh"
+
+namespace {
+
+int sm_count(int device) {
+  static std::mutex mu;
+  static int counts[64] = {0};
+  std::lock_guard<std::mutex> lock(mu);
+  TORCH_CHECK(device >= 0 && device < 64, "v41idx: device index out of range");
+  if (counts[device] == 0) {
+    int c = 0;
+    C10_CUDA_CHECK(cudaDeviceGetAttribute(&c, cudaDevAttrMultiProcessorCount,
+                                          device));
+    counts[device] = c;
+  }
+  return counts[device];
+}
+
+template <int H>
+void allow_smem(int device) {
+  static std::mutex mu;
+  static bool done[64] = {false};
+  std::lock_guard<std::mutex> lock(mu);
+  if (!done[device]) {
+    C10_CUDA_CHECK(cudaFuncSetAttribute(
+        v41idx::index_scores_tiled<H>,
+        cudaFuncAttributeMaxDynamicSharedMemorySize,
+        v41idx::smem_bytes(v41idx::MAX_ROWS)));
+    done[device] = true;
+  }
+}
+
+void check_args(const torch::Tensor& out, const torch::Tensor& q,
+                const torch::Tensor& w, const torch::Tensor& keys,
+                const torch::Tensor& positions, int64_t heads, int64_t ratio,
+                bool tiled) {
+  const int64_t tokens = out.dim() == 2 ? out.size(0) : -1;
+  TORCH_CHECK(out.is_cuda() && q.device() == out.device() &&
+                  w.device() == out.device() &&
+                  keys.device() == out.device() &&
+                  positions.device() == out.device(),
+              "v41idx: all tensors must be on one CUDA device");
+  TORCH_CHECK(out.dim() == 2 && out.scalar_type() == torch::kHalf &&
+                  out.stride(1) == 1 && out.stride(0) == out.size(1),
+              "v41idx: out must be fp16 [tokens, n_out] with row stride n_out");
+  if (tiled)
+    TORCH_CHECK(heads == 4 || heads == 8,
+                "v41idx: tiled scorer supports 4 or 8 index heads per rank, got ",
+                heads);
+  TORCH_CHECK(heads >= 1 && tokens >= 1 && tokens * heads <= 64,
+              "v41idx: need 1 <= tokens * heads <= 64");
+  TORCH_CHECK(q.scalar_type() == torch::kHalf && q.is_contiguous() &&
+                  q.dim() == 2 && q.size(0) == tokens * heads &&
+                  q.size(1) == 128,
+              "v41idx: q must be contiguous fp16 [tokens * heads, 128]");
+  TORCH_CHECK(w.scalar_type() == torch::kHalf && w.is_contiguous() &&
+                  w.numel() == tokens * heads,
+              "v41idx: w must be contiguous fp16 [tokens * heads]");
+  TORCH_CHECK(keys.scalar_type() == torch::kUInt8 && keys.is_contiguous() &&
+                  keys.dim() == 2 && keys.size(1) == 68 && keys.size(0) > 0,
+              "v41idx: keys must be contiguous uint8 [capacity > 0, 68]");
+  TORCH_CHECK(positions.scalar_type() == torch::kInt64 &&
+                  positions.is_contiguous() && positions.numel() >= tokens,
+              "v41idx: positions must be contiguous int64 with >= tokens entries");
+  TORCH_CHECK(out.size(1) >= keys.size(0),
+              "v41idx: output width must cover key capacity");
+  TORCH_CHECK(ratio >= 1, "v41idx: ratio must be >= 1");
+}
+
+void index_scores_tiled(torch::Tensor out, torch::Tensor q, torch::Tensor w,
+                        torch::Tensor keys, torch::Tensor positions,
+                        int64_t heads, int64_t ratio) {
+  check_args(out, q, w, keys, positions, heads, ratio, true);
+  const at::cuda::OptionalCUDAGuard guard(out.device());
+  const int device = out.get_device();
+  const int tokens = int(out.size(0));
+  const int rows = tokens * int(heads);
+  const int threads = ((tokens * v41idx::KL + 31) / 32) * 32;
+  const int smem = v41idx::smem_bytes(rows);
+  const int64_t blocks = (keys.size(0) + v41idx::KB - 1) / v41idx::KB;
+  const int grid = int(std::min<int64_t>(blocks, 2 * int64_t(sm_count(device))));
+  auto stream = at::cuda::getCurrentCUDAStream();
+  const auto* qp = reinterpret_cast<const __half*>(q.data_ptr());
+  const auto* wp = reinterpret_cast<const __half*>(w.data_ptr());
+  auto* op = reinterpret_cast<__half*>(out.data_ptr());
+  if (heads == 8) {
+    allow_smem<8>(device);
+    v41idx::index_scores_tiled<8><<<grid, threads, smem, stream>>>(
+        qp, wp, keys.data_ptr<uint8_t>(), positions.data_ptr<int64_t>(), op,
+        tokens, out.size(1), int(ratio), keys.size(0));
+  } else {
+    allow_smem<4>(device);
+    v41idx::index_scores_tiled<4><<<grid, threads, smem, stream>>>(
+        qp, wp, keys.data_ptr<uint8_t>(), positions.data_ptr<int64_t>(), op,
+        tokens, out.size(1), int(ratio), keys.size(0));
+  }
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+// Public v41k reference and launch configuration for check_v41idx.py;
+// the independently loaded v41k operation is its primary reference.
+void index_scores_ref(torch::Tensor out, torch::Tensor q, torch::Tensor w,
+                      torch::Tensor keys, torch::Tensor positions,
+                      int64_t heads, int64_t ratio) {
+  check_args(out, q, w, keys, positions, heads, ratio, false);
+  const at::cuda::OptionalCUDAGuard guard(out.device());
+  const int tokens = out.size(0);
+  auto stream = at::cuda::getCurrentCUDAStream();
+  constexpr int KB = 32;
+  const int blocks = (keys.size(0) + KB - 1) / KB;
+  v41idx_ref::index_scores_decode<KB><<<blocks, 256, 0, stream>>>(
+      reinterpret_cast<const half*>(q.data_ptr()),
+      reinterpret_cast<const half*>(w.data_ptr()), keys.data_ptr<uint8_t>(),
+      positions.data_ptr<int64_t>(), reinterpret_cast<half*>(out.data_ptr()),
+      tokens, int(heads), out.size(1), int(ratio));
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+int64_t version() { return 1; }
+
+int64_t grid_for(int64_t capacity, int64_t device) {
+  const int64_t blocks = (capacity + v41idx::KB - 1) / v41idx::KB;
+  return std::min<int64_t>(blocks, 2 * int64_t(sm_count(int(device))));
+}
+
+}  // namespace
+
+TORCH_LIBRARY(v41idx, m) {
+  m.def(
+      "index_scores_tiled(Tensor(a!) out, Tensor q, Tensor w, Tensor keys, "
+      "Tensor positions, int heads, int ratio) -> ()",
+      &index_scores_tiled);
+  m.def(
+      "index_scores_ref(Tensor(a!) out, Tensor q, Tensor w, Tensor keys, "
+      "Tensor positions, int heads, int ratio) -> ()",
+      &index_scores_ref);
+  m.def("version() -> int", &version);
+  m.def("grid_for(int capacity, int device) -> int", &grid_for);
+}
+// Shape-only capture/fake implementation. The out tensor is mutated in place.
+namespace {
+void index_scores_meta(torch::Tensor out, torch::Tensor q, torch::Tensor w,
+                       torch::Tensor keys, torch::Tensor positions,
+                       int64_t heads, int64_t ratio) {}
+}
+TORCH_LIBRARY_IMPL(v41idx, Meta, m) {
+  m.impl("index_scores_tiled", &index_scores_meta);
+}
+#endif
