+    params = [p.split()[-1] for p in re.sub(r"\s+", " ", binding).split("(")[1]
+              .rstrip(") ").split(", ")]  # fmt: skip
+    assert params == names
+    assert 'm.impl("dmv13_x"' in V41K or "&v41k_dmv13_x" in V41K
+
