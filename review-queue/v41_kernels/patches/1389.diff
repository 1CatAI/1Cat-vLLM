+    def send(self, connection: socket.socket):
+        if self.control is None:
+            raise RuntimeError("Resident expert owner is closed")
+        self.data.send(connection)
+        self.control.send(connection)
+
+    def close(self):
+        if self.control is not None:
+            self.control.close()
+            self.control = None
+        self.data.close()
