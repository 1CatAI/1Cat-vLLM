+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""sm_70 compile check for the V4.1 attention PREP / POST fusions (CPU only).
+
+Compiles the old kernels and their fused replacements with
+``triton.compile(..., target=GPUTarget("cuda", 70, 32))`` (no GPU, no driver)
+and checks:
+
+* every FP32 add-reduction (``tt.reduce`` + ``arith.addf``) in a fused kernel
+  has an operand layout and axis that the replaced kernels use, so the
+  in-thread / warp-shuffle / cross-warp summation tree is the same; max
+  reductions are exact in any order and are only listed;
+* ptxas (Triton's bundled CUDA 12.x one) reports no spills.
+
+Prints one JSON report; exit 1 on any failure, 2 if this Triton cannot
+target sm_70.
+
+    CUDA_VISIBLE_DEVICES= python benchmarks/deepseek_v41/small_fuse_sm70_check.py
+"""
+
+import importlib
+import importlib.util
+import json
+import logging
+import os
+import re
+import subprocess
+import sys
+import tempfile
+import types
+from collections import Counter
+from pathlib import Path
+
+os.environ.pop("TRITON_INTERPRET", None)
+
+import triton  # noqa: E402
+import triton.language as tl  # noqa: E402
+from triton.backends.compiler import GPUTarget  # noqa: E402
+from triton.compiler import ASTSource  # noqa: E402
+
+ROOT = Path(__file__).resolve().parents[2]
+TARGET = GPUTarget("cuda", 70, 32)
+_ENV = {
+    "VLLM_V41_HC_WINDOW": "2048",
+    "VLLM_V41_HC_COLS": "32",
+    "VLLM_V41_HC_PW": "4",
+    "VLLM_V41_HC_FW": "4",
+    "VLLM_V41_HC_V3": "1",
+    "VLLM_V41_HC_V3_GROUPS": "8",
+}
+
+
+class _Envs(types.ModuleType):
+    def __getattr__(self, name):
+        if name.startswith("VLLM_"):  # the process env first, as vllm.envs
+            return os.environ.get(name, _ENV.get(name, "0"))
+        raise AttributeError(name)
+
+
+def _package(name, path=None):
+    mod = types.ModuleType(name)
+    mod.__path__ = [str(ROOT / path)] if path else []
+    sys.modules[name] = mod
+    return mod
+
+
+def load_modules():
+    # Load only the kernel modules (not vllm's or the model package's
+    # __init__), with vllm.envs / logger / triton_utils stubbed.
+    _package("vllm")
+    tu = types.ModuleType("vllm.triton_utils")
+    tu.tl, tu.triton = tl, triton
+    sys.modules[tu.__name__] = tu
+    lg = types.ModuleType("vllm.logger")
+    lg.init_logger = logging.getLogger
+    sys.modules[lg.__name__] = lg
+    envs = _Envs("vllm.envs")
+    sys.modules[envs.__name__] = envs
+    sys.modules["vllm"].envs = envs
+    _package("vllm.models", "vllm/models")
+    _package("vllm.models.deepseek_v4", "vllm/models/deepseek_v4")
+    _package("vllm.models.deepseek_v4.common", "vllm/models/deepseek_v4/common")
+    _package("vllm.models.deepseek_v4.common.ops", "vllm/models/deepseek_v4/common/ops")
+    bmm = types.ModuleType("vllm.models.deepseek_v4.common.ops.sparse_prefill_bmm")
+    bmm.attend_gathered_keys = None
+    sys.modules[bmm.__name__] = bmm
+    _package("vllm.models.deepseek_v41", "vllm/models/deepseek_v41")
+    attn, rope, norm, ops = (
+        importlib.import_module("vllm.models.deepseek_v41." + name)
+        for name in ("attn_fuse", "quant_rope", "norm", "attention_ops")
+    )
+    return attn, rope, norm, ops
+
+
+def compile_sm70(fn, types_, constexprs, num_warps=4, maxnreg=None):
+    sig, attrs = {}, {}
+    for i, name in enumerate(fn.arg_names):
+        if name in constexprs:
+            sig[name] = "constexpr"
+        else:
+            sig[name] = types_[name]
+            if types_[name].startswith("*"):
+                attrs[(i,)] = [["tt.divisibility", 16]]
+    options = {"num_warps": num_warps, "enable_fp_fusion": False}
+    if maxnreg is not None:
+        options["maxnreg"] = maxnreg
+    kernel = triton.compile(
+        ASTSource(fn=fn, signature=sig, constexprs=constexprs, attrs=attrs),
+        target=TARGET,
+        options=options,
+    )
+    ptxas = Path(triton.__file__).parent / "backends" / "nvidia" / "bin" / "ptxas"
+    with tempfile.TemporaryDirectory() as d:
+        ptx = Path(d) / "k.ptx"
+        ptx.write_text(kernel.asm["ptx"])
+        run = subprocess.run(
+            [str(ptxas), "-arch=sm_70", "-v", str(ptx), "-o", str(ptx) + ".o"],
+            capture_output=True,
+            text=True,
+        )
+    info = run.stderr + run.stdout
+    regs = re.search(r"Used (\d+) registers", info)
+    spills = re.search(r"(\d+) bytes spill stores, (\d+) bytes spill loads", info)
+    if run.returncode or regs is None or spills is None:
+        raise RuntimeError("ptxas sm_70 failed:\n" + info)
+    return {
+        "ttgir": kernel.asm["ttgir"],
+        "ptx": kernel.asm["ptx"],
+        "regs": int(regs.group(1)),
+        "spill_bytes": int(spills.group(1)) + int(spills.group(2)),
+    }
+
+
+def reductions(ttgir):
+    """Counter of (combine op, axis, operand type with layouts spelled out)."""
+    aliases = {}
+    for line in ttgir.splitlines():
+        m = re.match(r"(#\w+) = (#ttg\.\w+<.*>)$", line.strip())
+        if m:
+            aliases[m.group(1)] = m.group(2)
+    lines = ttgir.splitlines()
+    found = Counter()
+    for idx, line in enumerate(lines):
+        m = re.search(r'"tt\.reduce"\(([^)]*)\) <\{axis = (\d+) : i32\}>', line)
+        if not m:
+            continue
+        combine = typ = None
+        for nxt in lines[idx + 1 : idx + 16]:
+            if combine is None and (c := re.search(r"arith\.(\w+)", nxt)):
+                combine = c.group(1)
+            if t := re.search(r"\}\) : \((tensor<[^)]*>)\)", nxt):
+                typ = t.group(1)
+                break
+        if typ is None:
+            raise RuntimeError("cannot parse tt.reduce at TTGIR line %d" % idx)
+        for alias, layout in aliases.items():
+            typ = re.sub(re.escape(alias) + r"\b", layout, typ)
+        found[(combine, int(m.group(2)), typ)] += 1
+    return found
+
+
+def _check_adds(name, old_kernels, new, report):
+    old = Counter()
+    for kernel in old_kernels:
+        old += reductions(kernel["ttgir"])
+    adds = Counter(
+        {k: v for k, v in reductions(new["ttgir"]).items() if k[0] == "addf"}
+    )
+    known = {k for k in old if k[0] == "addf"}
+    unmatched = [k for k in adds if k not in known]
+    report[name] = {
+        "fused_regs": new["regs"],
+        "old_regs": [k["regs"] for k in old_kernels],
+        "spill_bytes": new["spill_bytes"],
+        "add_reductions": [
+            f"{v} x axis {k[1]} {k[2]}" for k, v in sorted(adds.items())
+        ],
+        "max_reductions": sum(
+            v for k, v in reductions(new["ttgir"]).items() if k[0] != "addf"
+        ),
+        "unmatched_add_layouts": [str(k) for k in unmatched],
+    }
+    return not unmatched and new["spill_bytes"] == 0
+
+
+def main():
+    attn, rope, norm, ops = load_modules()
+    p32, p16, pi64, pb = "*fp32", "*fp16", "*i64", "*i1"
+    report = {"triton": triton.__version__}
+    ok = True
+
+    # VLLM_V41_FUSE_ATTN_PREP: _rotate(q), _short_rms(kv), _rotate(kv), _qdq.
+    rot_t = dict(x=p16, positions=pi64, table=p32, out=p16, LENGTH="i32")
+    rms_t = dict(x=p16, weight=p32, out=p16)
+    qdq_t = dict(x=p16, out=p16)
+    old_rot_q = compile_sm70(
+        rope._rotate, rot_t, dict(HEADS=16, D=512, INVERSE=False, BLOCK=512)
+    )
+    old_rms = compile_sm70(norm._short_rms, rms_t, dict(H=512, EPS=1e-20, BLOCK=512))
+    old_rot_kv = compile_sm70(
+        rope._rotate, rot_t, dict(HEADS=1, D=512, INVERSE=False, BLOCK=512)
+    )
+    old_qdq = compile_sm70(
+        rope._qdq, qdq_t, dict(GROUP=128, FP4=False, E4M3_SCALE=False)
+    )
+    prep_t = dict(
+        q=p16, kv=p16, kv_weight=p32, positions=pi64, table=p32, q_out=p16,
+        normed=p16, roped=p16, window=p16, LENGTH="i32",
+    )  # fmt: skip
+    prep = compile_sm70(
+        attn._attn_prep,
+        prep_t,
+        dict(HEADS=16, H=512, EPS=1e-20, BLOCK=512, GROUP=128),
+    )
+    ok &= _check_adds(
+        "attn_prep", [old_rot_q, old_rms, old_rot_kv, old_qdq], prep, report
+    )
+
+    # VLLM_V41_FUSE_ATTN_POST: _ring_insert, _rotate(inverse), _qdq.
+    old_rot_inv = compile_sm70(
+        rope._rotate, rot_t, dict(HEADS=16, D=512, INVERSE=True, BLOCK=512)
+    )
+    old_ring = compile_sm70(
+        ops._ring_insert,
+        dict(values=p16, positions=pi64, valid_tokens=pb, ring=p16, FIRST="i32"),
+        dict(RING=ops.WINDOW_RING),
+    )
+    post_t = dict(
+        x=p16, positions=pi64, table=p32, roped=p16, out=p16, values=p16,
+        valid_tokens=pb, ring=p16, LENGTH="i32",
+    )  # fmt: skip
+    for do_ring in (True, False):
+        post = compile_sm70(
+            attn._attn_post,
+            post_t,
+            dict(
+                HEADS=16,
+                H=512,
+                BLOCK=512,
+                GROUP=128,
+                RING=ops.WINDOW_RING,
+                DO_RING=do_ring,
+            ),
+        )
+        ok &= _check_adds(
+            f"attn_post ring={do_ring}", [old_rot_inv, old_qdq, old_ring], post, report
+        )
+    report["ok"] = bool(ok)
+    print(json.dumps(report, indent=1))
+    return 0 if ok else 1
+
+
+def _ptxas_targets_sm70():
+    ptxas = Path(triton.__file__).parent / "backends" / "nvidia" / "bin" / "ptxas"
+    version = subprocess.run([str(ptxas), "--version"], capture_output=True, text=True)
+    release = re.search(r"release (\d+)\.", version.stdout)
+    return release is not None and int(release.group(1)) <= 12  # 13 dropped Volta
+
+
+if __name__ == "__main__":
+    if not _ptxas_targets_sm70():
+        print(json.dumps({"ok": None, "skip": "Triton's ptxas cannot target sm_70"}))
+        sys.exit(2)
+    sys.exit(main())
diff --git a/benchmarks/deepseek_v41/tools/pp2_m1.py b/benchmarks/deepseek_v41/tools/pp2_m1.py
new file mode 100644
index 0000000000..31746d764a
--- /dev/null
+++ b/benchmarks/deepseek_v41/tools/pp2_m1.py
@@ -0,0 +1,269 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""PP2 milestone M1: PP2xTP4 logits are bit-identical to TP4 with a simulated
+layer-20 boundary.
+
+record: one engine load (eager, no drafter, synchronous scheduling), the
+128-token counting prompt and 65 greedy steps (prefill + 64 decode). The last
+pipeline stage's TP rank 0 saves every ``compute_logits`` output as it came
+from the model; the boundary tap (``DeepseekV41Model.pp_boundary_tap``, when
+the model has one) saves ``hidden``/``pre`` at the stage boundary, real on PP2
+and simulated on TP4.
+
+    # reference: TP4 with VLLM_V41_PP_BOUNDARY_SIM=20 (set by this tool)
+    pp2_m1.py record --pp 1 --offload 0.30 --output state/m1-ref
+    # PP2xTP4, every expert resident
+    pp2_m1.py record --pp 2 --offload 0 --output state/m1-pp2
+    pp2_m1.py compare state/m1-ref state/m1-pp2
+
+compare exits 0 only if both runs have the same number of steps, the same
+tokens and the same bits in every logits row. Boundary tensors are a
+diagnostic (they place a failure before or after the hop); they do not decide
+the verdict.
+"""
+
+import argparse
+import json
+import os
+import sys
+import time
+from pathlib import Path
+
+STEPS = 65  # prefill + 64 decode steps; one compute_logits call each
+
+
+def install(worker, output):
+    """Worker side: wrap compute_logits (last stage, TP rank 0) and the tap."""
+    import torch
+
+    from vllm.distributed import get_pp_group, get_tp_group
+
+    pp, tp = get_pp_group(), get_tp_group()
+    worker._m1 = state = {
+        "output": output,
+        "pp_rank": pp.rank_in_group,
+        "tp_rank": tp.rank_in_group,
+        "logits": [],
+        "boundary": [],
+        "originals": [],
+    }
+    if tp.rank_in_group != 0:
+        return None
+    model = worker.model_runner.model
+    if pp.is_last_rank:
+        original = model.compute_logits
+
+        def compute_logits(*args, **kwargs):
+            logits = original(*args, **kwargs)
+            value = logits[0] if isinstance(logits, tuple) else logits
+            if value is not None:
+                state["logits"].append(value.detach().to("cpu", copy=True))
+            return logits
+
+        state["originals"].append((model, "compute_logits", original))
+        model.compute_logits = compute_logits
+    inner = getattr(model, "model", None)
+    if inner is not None and hasattr(inner, "pp_boundary_tap"):
+
+        def tap(hidden, pre):
+            if torch.cuda.is_current_stream_capturing():
+                return
+            state["boundary"].append(
+                (
+                    hidden.detach().to("cpu", copy=True),
+                    pre.detach().to("cpu", copy=True),
+                )
+            )
+
+        state["originals"].append((inner, "pp_boundary_tap", inner.pp_boundary_tap))
+        inner.pp_boundary_tap = tap
+    return {"pp_rank": pp.rank_in_group, "tap": inner is not None}
+
+
+def drain(worker):
+    """Worker side: save what this rank recorded, undo the wraps."""
+    import torch
+
+    state = getattr(worker, "_m1", None)
+    if state is None:
+        return None
+    for owner, name, original in reversed(state["originals"]):
+        setattr(owner, name, original)
+    out = Path(state["output"])
+    saved = {"pp_rank": state["pp_rank"], "tp_rank": state["tp_rank"]}
+    if state["logits"]:
+        torch.save(state["logits"], out / "logits.pt")
+        saved["logits_steps"] = len(state["logits"])
+    if state["boundary"]:
+        torch.save(state["boundary"], out / "boundary.pt")
+        saved["boundary_steps"] = len(state["boundary"])
+    worker._m1 = None
+    return saved
+
+
+def memory_report(worker):
+    import torch
+
+    from vllm.distributed import get_pp_group, get_tp_group
+
+    free, total = torch.cuda.mem_get_info()
+    return {
+        "pp_rank": get_pp_group().rank_in_group,
+        "tp_rank": get_tp_group().rank_in_group,
+        "device": torch.cuda.current_device(),
+        "used_gib": round((total - free) / 2**30, 3),
+        "allocated_gib": round(torch.cuda.memory_allocated() / 2**30, 3),
+        "max_reserved_gib": round(torch.cuda.max_memory_reserved() / 2**30, 3),
+    }
+
+
+def record(args):
+    out = args.output.resolve()
+    out.mkdir(parents=True, exist_ok=True)
+    if args.pp == 1 and not args.no_sim:
+        os.environ["VLLM_V41_PP_BOUNDARY_SIM"] = "20"
+    elif args.pp == 2:
+        os.environ.pop("VLLM_V41_PP_BOUNDARY_SIM", None)
+    os.environ["V41_BENCH_PP"] = str(args.pp)
+    os.environ["V41_BENCH_OFFLOAD"] = str(args.offload)
+    from benchmarks.deepseek_v41.main_smoke import create_llm
+    from benchmarks.deepseek_v41.performance import make_prompt
+    from vllm import SamplingParams
+
+    started = time.monotonic()
+    llm = create_llm(
+        args.model_root,
+        args.chunk,
+        None,
+        args.offload,
+        kv_cache_mib=args.kv_mib,
+        decode_graph=False,
+        draft_graph=False,
+        custom_allreduce=not args.nccl,
+    )
+    load_seconds = time.monotonic() - started
+    try:
+        prompt = make_prompt(llm.get_tokenizer(), args.prompt_len)
+        installed = llm.collective_rpc(install, args=(str(out),))
+        begin = time.monotonic()
+        result = llm.generate(
+            [{"prompt_token_ids": prompt}],
+            SamplingParams(temperature=0, max_tokens=STEPS, ignore_eos=True),
+            use_tqdm=False,
+        )
+        seconds = time.monotonic() - begin
+        saved = llm.collective_rpc(drain)
+        memory = llm.collective_rpc(memory_report)
+    finally:
+        del llm
+    meta = {
+        "pp": args.pp,
+        "offload": args.offload,
+        "custom_allreduce": not args.nccl,
+        "prompt_len": len(prompt),
+        "prompt_ids": list(prompt),
+        "token_ids": list(result[0].outputs[0].token_ids),
+        "load_seconds": round(load_seconds, 1),
+        "generate_seconds": round(seconds, 2),
+        "installed": installed,
+        "saved": saved,
+        "memory_by_rank": memory,
+        "env": {
+            k: v
+            for k, v in sorted(os.environ.items())
+            if k.startswith(("VLLM_V41", "V41_BENCH", "CUDA_VISIBLE"))
+        },
+    }
+    (out / "meta.json").write_text(json.dumps(meta, indent=1) + "\n")
+    counts = [s.get("logits_steps") for s in saved if s and "logits_steps" in s]
+    print(f"recorded {counts} logits steps, tokens {len(meta['token_ids'])}, {out}")
+    return 0 if counts == [STEPS] else 1
+
+
+def _bits(t):
+    import torch
+
+    width = {2: torch.int16, 4: torch.int32, 8: torch.int64}[t.element_size()]
+    return t.contiguous().view(width)
+
+
+def compare(args):
+    import torch
+
+    ref, run = args.reference, args.candidate
+    meta_ref = json.loads((ref / "meta.json").read_text())
+    meta_run = json.loads((run / "meta.json").read_text())
+    a = torch.load(ref / "logits.pt")
+    b = torch.load(run / "logits.pt")
+    report = {
+        "steps": [len(a), len(b)],
+        "prompt_equal": meta_ref["prompt_ids"] == meta_run["prompt_ids"],
+        "tokens_equal": meta_ref["token_ids"] == meta_run["token_ids"],
+        "first_bit_diff_step": None,
+        "argmax_diff_steps": [],
+        "max_abs_diff": 0.0,
+    }
+    for step, (x, y) in enumerate(zip(a, b)):
+        if x.shape != y.shape or x.dtype != y.dtype:
+            if report["first_bit_diff_step"] is None:
+                report["first_bit_diff_step"] = step
+            report["shape_or_dtype"] = [str(x.shape), str(y.shape), str(x.dtype)]
+            break
+        if not torch.equal(_bits(x), _bits(y)):
+            if report["first_bit_diff_step"] is None:
+                report["first_bit_diff_step"] = step
+            diff = (x.float() - y.float()).abs().max().item()
+            report["max_abs_diff"] = max(report["max_abs_diff"], diff)
+        if not torch.equal(x.float().argmax(-1), y.float().argmax(-1)):
+            report["argmax_diff_steps"].append(step)
+    if (ref / "boundary.pt").is_file() and (run / "boundary.pt").is_file():
+        ba, bb = torch.load(ref / "boundary.pt"), torch.load(run / "boundary.pt")
+        first = None
+        for step, ((ha, pa), (hb, pb)) in enumerate(zip(ba, bb)):
+            same = (
+                ha.shape == hb.shape
+                and pa.shape == pb.shape
+                and torch.equal(_bits(ha), _bits(hb))
+                and torch.equal(_bits(pa), _bits(pb))
+            )
+            if not same:
+                first = step
+                break
+        report["boundary"] = {"steps": [len(ba), len(bb)], "first_diff_step": first}
+    else:
+        report["boundary"] = "not recorded (no pp_boundary_tap on one side)"
+    passed = (
+        len(a) == len(b) == STEPS
+        and report["prompt_equal"]
+        and report["tokens_equal"]
+        and report["first_bit_diff_step"] is None
+    )
+    report["verdict"] = "PASS" if passed else "FAIL"
+    print(json.dumps(report, indent=1))
+    return 0 if passed else 1
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    sub = p.add_subparsers(dest="cmd", required=True)
+    r = sub.add_parser("record")
+    r.add_argument("--pp", type=int, choices=(1, 2), required=True)
+    r.add_argument("--offload", type=float, required=True)
+    r.add_argument("--output", type=Path, required=True)
+    r.add_argument("--model-root", type=Path, default=Path("/path/to/ds41-models"))
+    r.add_argument("--prompt-len", type=int, default=128)
+    r.add_argument("--chunk", type=int, default=512)
+    r.add_argument("--kv-mib", type=int, default=384)
+    r.add_argument("--nccl", action="store_true", help="disable custom all-reduce")
+    r.add_argument(
+        "--no-sim", action="store_true", help="TP4 without the simulated boundary"
+    )
+    c = sub.add_parser("compare")
+    c.add_argument("reference", type=Path)
+    c.add_argument("candidate", type=Path)
+    args = p.parse_args()
+    return record(args) if args.cmd == "record" else compare(args)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
