+    decoded = dequantize(layer.gguf_w2[0].numpy(), 42)
+    expected = dequantize(raw, 42)[:, rank * 160 : (rank + 1) * 160]
+    np.testing.assert_array_equal(decoded[:, left : left + 160], expected)
