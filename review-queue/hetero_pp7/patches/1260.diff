+        (MixedPrefillTiming(0, 1, 32, 1, is_pipeline=True), "no_prefill"),
+        (
+            MixedPrefillTiming(32, 0, 32, 100, is_pipeline=False),
+            "non_pipeline_without_decode",
+        ),
+        (MixedPrefillTiming(32, 1, 32, float("nan")), "invalid_elapsed"),
