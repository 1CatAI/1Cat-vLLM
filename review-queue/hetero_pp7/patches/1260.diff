+def marlin_padded_nk(size_n: int, size_k: int, group_size: int = -1) -> tuple[int, int]:
+    """Pad a dense Marlin weight to the smaller valid thread-tile family."""
+    def round_up(value: int, multiple: int) -> int:
+        return (value + multiple - 1) // multiple * multiple
+
+    group = group_size if group_size > 0 else 1
+    candidates = (
+        (round_up(size_n, 64), round_up(size_k, math.lcm(128, group))),
+        (round_up(size_n, 128), round_up(size_k, math.lcm(64, group))),
+    )
+    padded = min(candidates, key=lambda shape: (shape[0] * shape[1], sum(shape)))
+    if padded != (size_n, size_k):
+        logger.warning_once(
+            "Marlin padded a non-tile-aligned linear layer; the output is "
+            "sliced back to its original width."
+        )
+    return padded
