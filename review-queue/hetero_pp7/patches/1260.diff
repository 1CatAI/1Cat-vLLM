+
+
+@pytest.mark.parametrize(
+    "sample,reason",
+    [
+        (None, "missing_sample"),
+        (MixedPrefillTiming(768, 0, 0, 500, is_pipeline=True), "standalone_no_budget"),
+        (MixedPrefillTiming(8, 0, 32, 100, is_pipeline=True), "small_fast_tail"),
+        (
