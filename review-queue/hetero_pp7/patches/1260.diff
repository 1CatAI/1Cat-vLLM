new file mode 100644
index 0000000000000000000000000000000000000000..b78cfd71aae3285551db6a5572c829ae015447f3
--- /dev/null
+++ b/vllm/profiler/scheduler.py
@@ -0,0 +1,32 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+"""Host-only scheduler metadata for joining pipeline profiler scopes."""
+
+from typing import TYPE_CHECKING
+from urllib.parse import quote
+
+if TYPE_CHECKING:
+    from vllm.v1.core.sched.output import SchedulerOutput
+
+
+def scheduler_step_annotation(output: "SchedulerOutput") -> str:
+    """Identify request positions without recording prompt or generated tokens."""
+    offsets = {
+        request.req_id: request.num_computed_tokens
+        for request in output.scheduled_new_reqs
+    }
+    cached = output.scheduled_cached_reqs
+    offsets.update(zip(cached.req_ids, cached.num_computed_tokens))
+    scheduled = output.num_scheduled_tokens
+    request_ids = sorted(offsets.keys() | scheduled.keys())
+    # Some Kineto exporters do not JSON-escape record_function names. Encode
+    # request IDs so quotes, backslashes and control characters cannot corrupt
+    # a trace. Keep positions readable: id@computed+scheduled, '?' if unknown.
+    kind = "model" if output.total_num_scheduled_tokens else "zero_token_control"
+    requests = ",".join(
+        f"{quote(request_id, safe='')}@{offsets.get(request_id, '?')}"
+        f"+{scheduled.get(request_id, 0)}"
+        for request_id in request_ids
+    )
+    return f"kind={kind};requests={requests}"
