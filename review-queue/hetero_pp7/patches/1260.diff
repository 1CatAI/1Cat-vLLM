+        monkeypatch.setattr(module, "get_tensor_model_parallel_world_size", lambda: 1)
+    model = Glm5NextModel.__new__(Glm5NextModel)
+    torch.nn.Module.__init__(model)
+    model.config = copy.copy(config)
