+    tokens[0, :5] = [11, 12, 13, 14, 15]
+    tokens[1, :3] = [21, 22, 23]
+    runner.input_batch = SimpleNamespace(req_ids=["r0", "r1", None, None], token_ids_cpu=tokens,
+                                         num_computed_tokens_cpu=np.array([4, 2, 0, 0]))
