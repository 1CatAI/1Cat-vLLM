+def test_warm_runs_no_collective_and_leaves_drafts_exact():
+    g = torch.Generator().manual_seed(19)
+    head, embed = _weights(6)
+    logits = _rows(g)
+    anchor = torch.tensor([33])
+    want = FUSED.MarkovGreedy(head, embed)(logits, anchor)
+    group = Group()
