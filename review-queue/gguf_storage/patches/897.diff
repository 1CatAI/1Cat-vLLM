+                len(bb),
+            )
+        )
+        cache_bands.extend(cb)
+        blas_bands.extend(bb)
+    return torch.ops.vllm.prepared_gguf_mixed_projection(
+        x, codes, stats, caches, descriptors, cache_bands, blas_bands
+    )
