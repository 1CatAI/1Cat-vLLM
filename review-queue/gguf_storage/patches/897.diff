+            else "planar_shape_has_no_calibration"
+        )
+    return (
+        GGUFOperatorCapability(
+            decoder_family(source_type),
+            quant_type_name(source_type),
+            operator,
+            True,
+            min_m=512,
+            max_m=512,
+            reason=reason,
+        ),
+    )
