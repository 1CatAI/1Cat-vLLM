+    for natural in (False, True):
+        scratch = torch.empty(
+            (n, k) if natural else (k, n), device="cuda", dtype=torch.float16
+        )
+        for algorithm, dtype in [
+            (algo, dtype)
+            for algo in (99, 102)
+            for dtype in (torch.float16, torch.float32)
