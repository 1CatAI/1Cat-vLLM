+    ]
+    out = dict(cfg.dequantize_dense(iter(weights)))
+    assert set(out) == {"model.norm.weight", expert, p + ".weight"}
+    ref = exl3_reconstruct(trellis.cuda(), suh.cuda(), svh.cuda(), "mcg", order)
