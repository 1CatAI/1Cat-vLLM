+    tensors = {"token_embd.weight": tensor}
+    entries = dict(
+        adapter.weights(tensors, adapter.build_name_map(tensors), torch.float16)
+    )
+    assert entries["model.embed_tokens.qweight_type"].item() == 23
+    packed = entries["model.embed_tokens.qweight"]
