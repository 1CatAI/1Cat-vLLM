+        ({"experts": 256}, "original_prefill_shape_or_source_unmeasured"),
+        ({"k": 320}, "original_prefill_shape_or_source_unmeasured"),
+        ({"source_type": 20}, "original_prefill_shape_or_source_unmeasured"),
