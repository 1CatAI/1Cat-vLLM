+  __device__ static float dot(const uint8_t* row, int group, const Q8_1& x,
+                              const uint32_t*, const uint32_t*) {
+    return OriginalIntegerDot<20>::dot(row, group, x);
+  }
+};
+
+template <bool BankAware>
