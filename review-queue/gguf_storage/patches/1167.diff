+        k=2560,
+        n=160,
+        experts=512,
+        dtype=torch.float16,
+        is_sm70=True,
+    )
+    args.update(changes)
+    assert original_moe_prefill_capability(**args).reason == reason
+
+
+def test_missing_prefill_operator_retains_fallback(monkeypatch):
+    monkeypatch.setattr(torch.ops, "_C_gguf", SimpleNamespace())
