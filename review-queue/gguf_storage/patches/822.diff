+    assert (
+        sm70.sm70_ops.has_qpn2_activation_pack("qpn2_pack_abi_test") == native_argument
+    )
+    assert sm70.sm70_ops._qpn2_pack_args("qpn2_pack_abi_test", True) == (
+        [True] if native_argument else []
