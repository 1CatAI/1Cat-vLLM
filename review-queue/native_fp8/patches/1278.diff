+# One CTA of the M <= 8 QPN8 GEMM covers this many output columns.
+_QPN8_COLUMNS_PER_CTA = 32
+# fp8_qpn8_occupancy_split_k was measured for the M <= 8 QPN8 GEMM only.
+QPN8_OCCUPANCY_MAX_M = 8
+
