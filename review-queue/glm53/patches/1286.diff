+        _TC_PRENORM_SPLITS, num_tokens, dtype=torch.float32, device=x.device
+    )
+    grid = (
+        triton.cdiv(n, _TC_PRENORM_BLOCK_N),
+        triton.cdiv(num_tokens, _TC_PRENORM_BLOCK_M),
+        _TC_PRENORM_SPLITS,
+    )
