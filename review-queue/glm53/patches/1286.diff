+    x_ptr,
+    codes_ptr,
+    scales_ptr,
+    global_scales_ptr,
+    perm_ptr,
+    gids_ptr,
+    goff_ptr,
+    y_ptr,
+    N,
+    K,
+    TOP_K,
+    x_stride,
+    y_stride,
+    GROUPS,
+    LOW,
+    HIGH,
+    GROUPS_P2: tl.constexpr,
+    X_SLOT_MAJOR: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_N: tl.constexpr,
+    BLOCK_K: tl.constexpr,
