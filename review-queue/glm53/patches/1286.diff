+      for (int kk = 0; kk < 2; kk++)
+#pragma unroll
+        for (int nt = 0; nt < 4; nt++)
+          mma_m16n8k8(s[nt], qa[ks + kk][0], qa[ks + kk][1],
+                      f[nt >> 1][(nt & 1) * 2 + kk]);
+    }
+
+    if (prefetch) {
+#pragma unroll
+      for (int i = 0; i < 2; i++) {
+        fetch.store(next, i, pk[i], pv[i]);
+        fetch.load(j0 + kBlockN, 2 + i, pk[i], pv[i]);
+      }
+    }
