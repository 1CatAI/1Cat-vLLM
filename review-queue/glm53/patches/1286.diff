diff --git a/csrc/sm70_turbomind/ops/csf32_expand_sm70.cu b/csrc/sm70_turbomind/ops/csf32_expand_sm70.cu
new file mode 100644
index 0000000000..b287cc4e10
--- /dev/null
+++ b/csrc/sm70_turbomind/ops/csf32_expand_sm70.cu
@@ -0,0 +1,207 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+//
+// Expansion of csf_32x2_v1 expert scales into the skinny QPN scale raster
+// ([expert][tile N/32][group K/16][position 32] bytes, see
+// vllm/model_executor/layers/quantization/utils/csf32_expand.py).
+//
+// A CSF block is 32 rows x 2 column groups; a code byte holds one row's two
+// scales (low nibble first group, high nibble second), the scale is the row's
+// base plus the nibble. The raster stores a block's 32 row scales for one
+// group as a 32-byte line, permuted by the card's fragment order. A thread
+// owns four neighbouring raster positions, so it reads the four rows' code
+// bytes (one 32-byte line of the codes, served from L1 after the first
+// thread) and writes two 32-bit words. Several tile pairs are loaded before
+// any is stored: the byte-per-lane Triton walk spent about twenty
+// instructions per scale and ran at a third of the memory bandwidth. The
+// scales the four-bit codes cannot express (exception records, sorted by
+// block) are written by the same thread that owns the row, so no second pass
+// over the raster is needed.
+
+#include <torch/all.h>
+
+#include <ATen/cuda/CUDAContext.h>
+#include <c10/cuda/CUDAException.h>
+#include <c10/cuda/CUDAGuard.h>
+
+namespace {
+
+constexpr int kBlocksPerTile = 8;   // 4 block rows x 2 column pairs
+constexpr int kLinesPerBlock = 32;  // raster positions = rows of a block
+constexpr int kQuadsPerLine = 8;    // 4 positions per thread
+constexpr int kThreadsX = kBlocksPerTile * kQuadsPerLine;  // 64
+constexpr int kPairLanes = 4;  // tile pairs a block works on at once
+constexpr int kUnroll = 2;     // loads in flight per thread and lane
+
+__global__ void csf32_expand_kernel(
+    uint8_t* __restrict__ out, int64_t out_expert_stride,
+    const int32_t* __restrict__ gids, const int32_t* __restrict__ goff,
+    int32_t num_slots, const uint8_t* __restrict__ bases,
+    const uint8_t* __restrict__ codes, const int32_t* __restrict__ entries,
+    const int32_t* __restrict__ offsets, const int32_t* __restrict__ page_bases,
+    const int32_t* __restrict__ exceptions,
+    const int64_t* __restrict__ exception_start, int num_pages, int rows,
+    int groups, int projections, int pairs_per_program) {
+  const int slot = blockIdx.x;
+  if (goff[slot] >= num_slots) return;
+  const int64_t expert = gids[slot];
+  const int row_tiles_per_projection = rows / 128;
+  const int projection = blockIdx.y / row_tiles_per_projection;
+  const int tile_row = blockIdx.y % row_tiles_per_projection;
+  const int tile_pairs = groups / 4;
+  const int64_t matrix = expert * projections + projection;
+
+  // Row at each raster position: the inverse of the entries table.
+  __shared__ uint8_t row_at_position[kLinesPerBlock];
+  if (threadIdx.y == 0 && threadIdx.x < kLinesPerBlock) {
+    row_at_position[entries[threadIdx.x]] = static_cast<uint8_t>(threadIdx.x);
+  }
+  __syncthreads();
+
+  const int at = threadIdx.x / kQuadsPerLine;
+  const int quad = threadIdx.x % kQuadsPerLine;
+  const int block_row = tile_row * 4 + (at & 3);
+  int rows_of[4];
+  int base_of[4];
+#pragma unroll
+  for (int k = 0; k < 4; ++k) {
+    rows_of[k] = row_at_position[quad * 4 + k];
+    base_of[k] = bases[matrix * rows + block_row * 32 + rows_of[k]];
+  }
+  const uint8_t* code_block =
+      codes + matrix * (static_cast<int64_t>(rows) * groups / 2) +
+      static_cast<int64_t>(tile_row) * tile_pairs * 256 + at * 32;
+  // Exceptions of this matrix: the offsets row holds 257 entries per page of
+  // 256 blocks, a block's records start at the page origin plus its prefix.
+  const int num_blocks = (rows / 32) * (groups / 2);
+  const int32_t* matrix_offsets = offsets + matrix * (num_blocks + num_pages);
+  const int32_t* matrix_pages = page_bases + matrix * num_pages;
+  const int32_t* matrix_records = exceptions + exception_start[matrix];
+  const int out_tile = projection * (rows / 32) + block_row;
+  uint8_t* out_tile_ptr = out + expert * out_expert_stride +
+                          static_cast<int64_t>(out_tile) * groups * 32 +
+                          quad * 4;
+
+  const int first = blockIdx.z * pairs_per_program;
+  const int end = first + pairs_per_program;
+  for (int step = first; step < end; step += kPairLanes * kUnroll) {
+    uint32_t code[kUnroll][4];
+    int record_first[kUnroll], record_last[kUnroll], record_origin[kUnroll];
+#pragma unroll
+    for (int u = 0; u < kUnroll; ++u) {
+      const int tile_pair = step + u * kPairLanes + threadIdx.y;
+      if (tile_pair < end) {
+        const uint8_t* line =
+            code_block + static_cast<int64_t>(tile_pair) * 256;
+#pragma unroll
+        for (int k = 0; k < 4; ++k) code[u][k] = line[rows_of[k]];
+        const int block =
+            (tile_row * tile_pairs + tile_pair) * kBlocksPerTile + at;
+        const int page = block >> 8;
+        record_first[u] = matrix_offsets[block + page];
+        record_last[u] = matrix_offsets[block + page + 1];
+        record_origin[u] = matrix_pages[page] >> 1;
+      }
+    }
+#pragma unroll
+    for (int u = 0; u < kUnroll; ++u) {
+      const int tile_pair = step + u * kPairLanes + threadIdx.y;
+      if (tile_pair < end) {
+        uint32_t low = 0, high = 0;
+#pragma unroll
+        for (int k = 0; k < 4; ++k) {
+          low |= ((base_of[k] + (code[u][k] & 0xF)) & 0xFF) << (8 * k);
+          high |= ((base_of[k] + (code[u][k] >> 4)) & 0xFF) << (8 * k);
+        }
+        // Scales the codes cannot express: a record names a row and a column
+        // of the block (low byte 2 * row + column) and carries the value.
+        for (int j = record_first[u]; j < record_last[u]; ++j) {
+          const int32_t record = matrix_records[record_origin[u] + j];
+          const int row = (record & 0xFF) >> 1;
+#pragma unroll
+          for (int k = 0; k < 4; ++k) {
+            if (rows_of[k] == row) {
+              uint32_t& word = (record & 1) ? high : low;
+              word = (word & ~(0xFFu << (8 * k))) |
+                     (static_cast<uint32_t>(record >> 8) << (8 * k));
+            }
+          }
+        }
+        // Group pair of this block: two tile pairs' worth per tile pair, the
+        // block's half selects which of the pair's two column pairs it is.
+        uint8_t* pair_ptr =
+            out_tile_ptr + static_cast<int64_t>(tile_pair * 2 + (at >> 2)) * 64;
+        *reinterpret_cast<uint32_t*>(pair_ptr) = low;
+        *reinterpret_cast<uint32_t*>(pair_ptr + 32) = high;
+      }
+    }
+  }
+}
+
+}  // namespace
+
+void csf32_expand_sm70(torch::Tensor out, torch::Tensor bases,
+                       torch::Tensor codes, torch::Tensor page_bases,
+                       torch::Tensor offsets, torch::Tensor exceptions,
+                       torch::Tensor exception_start, torch::Tensor entries,
+                       torch::Tensor gids, torch::Tensor goff, int64_t rows,
+                       int64_t groups, int64_t projections, int64_t group_rows,
+                       int64_t pairs_per_program, int64_t runs) {
+  TORCH_CHECK(out.is_cuda() && out.dtype() == torch::kUInt8 && out.dim() == 2 &&
+              out.stride(1) == 1);
+  const c10::cuda::CUDAGuard device_guard(out.device());
+  for (const auto& tensor : {bases, codes, page_bases, offsets, exceptions,
+                             exception_start, entries, gids, goff}) {
+    TORCH_CHECK(tensor.device() == out.device(), "CSF tensors share a device");
+    TORCH_CHECK(tensor.is_contiguous(), "CSF tensors must be contiguous");
+  }
+  TORCH_CHECK(bases.dtype() == torch::kUInt8 && codes.dtype() == torch::kUInt8);
+  TORCH_CHECK(page_bases.dtype() == torch::kInt &&
+              offsets.dtype() == torch::kInt &&
+              exceptions.dtype() == torch::kInt &&
+              exception_start.dtype() == torch::kLong);
+  TORCH_CHECK(entries.dtype() == torch::kInt && entries.numel() == 32);
+  TORCH_CHECK(gids.dtype() == torch::kInt && goff.dtype() == torch::kInt);
+  TORCH_CHECK(
+      rows > 0 && rows % 128 == 0 && groups > 0 && groups % 4 == 0,
+      "CSF expansion supports full tiles only (rows % 128, groups % 4)");
+  const int64_t tile_pairs = groups / 4;
+  TORCH_CHECK(runs > 0 && pairs_per_program > 0 &&
+                  pairs_per_program * runs == tile_pairs,
+              "runs must split the row's tile pairs evenly");
+  TORCH_CHECK(group_rows > 0 && group_rows <= gids.size(0) &&
+              goff.size(0) == gids.size(0) + 1);
+  TORCH_CHECK(out.stride(0) % 4 == 0 &&
+                  reinterpret_cast<uintptr_t>(out.data_ptr()) % 4 == 0,
+              "raster rows must be 4-byte aligned");
+  const int64_t matrices = bases.numel() / rows;
+  TORCH_CHECK(bases.numel() == matrices * rows &&
+                  codes.numel() == matrices * rows * groups / 2,
+              "CSF plane sizes");
+  TORCH_CHECK(out.size(0) * projections >= matrices &&
+                  out.size(1) >= projections * rows * groups,
+              "the raster holds every expert's projections");
+  const int64_t num_blocks = (rows / 32) * (groups / 2);
+  TORCH_CHECK(
+      page_bases.dim() == 2 && page_bases.size(0) == matrices &&
+          offsets.numel() == matrices * (num_blocks + page_bases.size(1)) &&
+          exception_start.numel() == matrices,
+      "CSF exception tables");
+  const int64_t row_tiles = projections * (rows / 128);
+  TORCH_CHECK(row_tiles <= 65535 && runs <= 65535 && group_rows <= 2147483647);
+
+  const dim3 grid(static_cast<unsigned>(group_rows),
+                  static_cast<unsigned>(row_tiles),
+                  static_cast<unsigned>(runs));
+  const dim3 block(kThreadsX, kPairLanes);
+  csf32_expand_kernel<<<grid, block, 0, at::cuda::getCurrentCUDAStream()>>>(
+      out.data_ptr<uint8_t>(), out.stride(0), gids.data_ptr<int32_t>(),
+      goff.data_ptr<int32_t>(), static_cast<int32_t>(gids.size(0)),
+      bases.data_ptr<uint8_t>(), codes.data_ptr<uint8_t>(),
+      entries.data_ptr<int32_t>(), offsets.data_ptr<int32_t>(),
+      page_bases.data_ptr<int32_t>(), exceptions.data_ptr<int32_t>(),
+      exception_start.data_ptr<int64_t>(), static_cast<int>(page_bases.size(1)),
+      static_cast<int>(rows), static_cast<int>(groups),
+      static_cast<int>(projections), static_cast<int>(pairs_per_program));
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
diff --git a/csrc/sm70_turbomind/ops/fp8_qpn8_codes_sm70.cuh b/csrc/sm70_turbomind/ops/fp8_qpn8_codes_sm70.cuh
new file mode 100644
index 0000000000..78b8cadfef
--- /dev/null
+++ b/csrc/sm70_turbomind/ops/fp8_qpn8_codes_sm70.cuh
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+//
+// QPN8 code layout shared by the SM70 packed GEMMs and the SM75 MMA GEMM.
+// Each 32-column tile and 16-deep K group is stored as 32 lanes x 16 bytes:
+// lane l holds column qpn8_col_from_lane(l), its 16 K values reordered so the
+// fast decoder yields the half2 pairs (k, k + 1) for k = 0, 2, ..., 14.
+// The layout derives from dnv2003/v100-skinny (MIT); see LICENSE.v100-skinny.
+#pragma once
+
+#include <cuda_fp16.h>
+
+namespace vllm::sm70 {
+
+// E4M3 bits placed into FP16 positions; the 2^8 exponent offset lives in the
+// prescaled group scales.
+__device__ __forceinline__ void fp8x8_to_half2x4_fast(uint2 q, half2 out[4]) {
+  constexpr unsigned kSign = 0x80008000u;
+  constexpr unsigned kExponentMantissa = 0x3f803f80u;
+  unsigned permuted[4];
+  permuted[0] = __byte_perm(q.x, q.y, 0x0400);
+  permuted[1] = __byte_perm(q.x, q.y, 0x0501);
+  permuted[2] = __byte_perm(q.x, q.y, 0x0602);
+  permuted[3] = __byte_perm(q.x, q.y, 0x0703);
+#pragma unroll
+  for (int i = 0; i < 4; ++i) {
+    const unsigned value =
+        ((permuted[i] << 8) & kSign) | ((permuted[i] << 7) & kExponentMantissa);
+    out[i] = *reinterpret_cast<const half2*>(&value);
+  }
+}
+
+__device__ __forceinline__ int qpn8_col_from_lane(int lane) {
+  return ((lane >> 2) & 3) * 8 + (lane & 3) + ((lane & 16) ? 4 : 0);
+}
+
+}  // namespace vllm::sm70
diff --git a/csrc/sm70_turbomind/ops/fp8_qpn8_mma_sm75.cu b/csrc/sm70_turbomind/ops/fp8_qpn8_mma_sm75.cu
new file mode 100644
index 0000000000..5c3669a38e
--- /dev/null
+++ b/csrc/sm70_turbomind/ops/fp8_qpn8_mma_sm75.cu
@@ -0,0 +1,429 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+//
+// Block-FP8 (or MXFP8 row-group) GEMM on the QPN8 packed codes with Turing's
+// m16n8k8 tensor-core MMA. Turing executes the Volta m8n8k4 MMA of the packed
+// GEMMs at half its tensor rate, and above M=8 the block-FP8 route otherwise
+// reconstructs the whole FP16 weight on every call. Here each CTA decodes and
+// block-scales its codes once while staging them into shared memory, exactly as
+// the dense reconstruction rounds them, and feeds both operands through
+// ldmatrix. No second weight layout is held. Split-K across CTAs writes FP32
+// partials that a second kernel sums in fixed split order.
+
+#include <torch/all.h>
+
+#include <ATen/cuda/CUDAContext.h>
+#include <c10/cuda/CUDAGuard.h>
+#include <cuda_fp16.h>
+#include <cuda_runtime.h>
+
+#include <algorithm>
+
+#include "fp8_qpn8_codes_sm70.cuh"
+#include "mma_fragments_sm70.cuh"
+
+namespace {
+
+using vllm::sm70::fp8x8_to_half2x4_fast;
+using vllm::sm70::ldmatrix_x4;
+using vllm::sm70::mma_m16n8k8;
+using vllm::sm70::qpn8_col_from_lane;
+using vllm::sm70::shared_address;
+
+constexpr int kBlockN = 128;
+constexpr int kBlockK = 32;
+constexpr int kThreads = 256;
+constexpr int kChunks = kBlockK / 8;  // 16-byte chunks per shared-memory row
+// Row tiles per raster group: concurrent CTAs share these A rows and a few B
+// column tiles, so both operands are reused from L2 instead of re-reading
+// every weight once per row tile.
+constexpr int kGroupRowTiles = 16;
+
+// 64-byte rows: XOR the chunk with (row / 2) so the eight rows one ldmatrix
+// phase reads land in distinct bank quads.
+__device__ __forceinline__ int swizzled(int row, int chunk) {
+  return row * kChunks + (chunk ^ ((row >> 1) & 3));
+}
+
+// RowGroupScales: MXFP8 scales laid out [K/32, N], one per column and K step
+// (kBlockK == 32); off, the 128 x 128 block scales [K/128, N/32].
+template <int BlockM, int WarpsM, int MinBlocks, bool RowGroupScales>
+__global__ __launch_bounds__(kThreads, MinBlocks) void fp8_qpn8_mma_sm75_kernel(
+    const half* __restrict__ input, const uint4* __restrict__ codes,
+    const half* __restrict__ group_scales, half* __restrict__ output,
+    float* __restrict__ partials, int m, int n, int k, int splits) {
+  constexpr int WarpsN = kThreads / 32 / WarpsM;
+  constexpr int WarpM = BlockM / WarpsM;
+  constexpr int WarpN = kBlockN / WarpsN;
+  constexpr int RowFrags = WarpM / 16;
+  constexpr int ColFrags = WarpN / 8;
+  constexpr int AChunks = BlockM * kChunks;
+  constexpr int ALoads = (AChunks + kThreads - 1) / kThreads;
+  static_assert(RowFrags >= 1 && ColFrags >= 2 && ColFrags % 2 == 0,
+                "warp tile must hold whole m16 rows and n8 column pairs");
+
+  __shared__ __align__(16) uint4 a_shared[2][BlockM * kChunks];
+  __shared__ __align__(16) uint4 b_shared[2][kBlockN * kChunks];
+
+  const int tid = threadIdx.x;
+  const int lane = tid & 31;
+  const int warp = tid >> 5;
+  const int warp_m = warp % WarpsM;
+  const int warp_n = warp / WarpsM;
+
+  const int row_tiles = (m + BlockM - 1) / BlockM;
+  const int per_group = kGroupRowTiles * (n / kBlockN);
+  const int first_row_tile = (blockIdx.x / per_group) * kGroupRowTiles;
+  const int group_rows = min(row_tiles - first_row_tile, kGroupRowTiles);
+  const int in_group = blockIdx.x % per_group;
+  const int m0 = (first_row_tile + in_group % group_rows) * BlockM;
+  const int n0 = (in_group / group_rows) * kBlockN;
+
+  // Split-K boundaries stay on 128-deep scale blocks.
+  const int k_blocks = k / 128;
+  const int split = blockIdx.z;
+  const int block_begin = split * k_blocks / splits;
+  const int block_end = (split + 1) * k_blocks / splits;
+  const int k_begin = block_begin * 128;
+  const int steps = (block_end - block_begin) * (128 / kBlockK);
+
+  // B staging: one 16-byte code word (16 K of one column) per thread.
+  const int b_tile = tid >> 6;
+  const int b_group = (tid >> 5) & 1;
+  const int b_row = b_tile * 32 + qpn8_col_from_lane(lane);
+  const uint4* b_source = codes +
+                          (static_cast<size_t>(n0 / 32 + b_tile) * (k >> 4) +
+                           k_begin / 16 + b_group) *
+                              32 +
+                          lane;
+  const half* scale_source = RowGroupScales ? group_scales + n0 + b_row
+                                            : group_scales + n0 / 32 + b_tile;
+  const int tiles_n32 = n >> 5;
+
+  // One K step held in registers on its way into shared memory. The scale is
+  // read together with the codes, so no global load sits between the MMAs and
+  // the shared-memory store. Two steps in flight measured slower for every
+  // tile height (more registers, fewer resident blocks).
+  struct Staged {
+    uint4 a[ALoads];
+    uint4 b;
+    half scale;
+  };
+
+  auto load_global = [&](int step, Staged& staged) {
+    const int k0 = k_begin + step * kBlockK;
+#pragma unroll
+    for (int i = 0; i < ALoads; ++i) {
+      const int index = tid + i * kThreads;
+      staged.a[i] = make_uint4(0, 0, 0, 0);
+      if (index < AChunks && m0 + index / kChunks < m) {
+        staged.a[i] = *reinterpret_cast<const uint4*>(
+            input + static_cast<size_t>(m0 + index / kChunks) * k + k0 +
+            (index % kChunks) * 8);
+      }
+    }
+    staged.b =
+        __ldcs(b_source + static_cast<size_t>(step) * (kBlockK / 16) * 32);
+    staged.scale =
+        RowGroupScales
+            ? scale_source[static_cast<size_t>(k0 / kBlockK) * n]
+            : scale_source[static_cast<size_t>(k0 / 128) * tiles_n32];
+  };
+
+  auto store_shared = [&](const Staged& staged, int stage) {
+#pragma unroll
+    for (int i = 0; i < ALoads; ++i) {
+      const int index = tid + i * kThreads;
+      if (index < AChunks) {
+        a_shared[stage][swizzled(index / kChunks, index % kChunks)] =
+            staged.a[i];
+      }
+    }
+    const half2 scale2 = __halves2half2(staged.scale, staged.scale);
+    half2 weights[8];
+    fp8x8_to_half2x4_fast(make_uint2(staged.b.x, staged.b.y), weights);
+    fp8x8_to_half2x4_fast(make_uint2(staged.b.z, staged.b.w), weights + 4);
+#pragma unroll
+    for (int i = 0; i < 8; ++i) {
+      weights[i] = __hmul2(weights[i], scale2);
+    }
+    const uint4* packed = reinterpret_cast<const uint4*>(weights);
+    b_shared[stage][swizzled(b_row, b_group * 2)] = packed[0];
+    b_shared[stage][swizzled(b_row, b_group * 2 + 1)] = packed[1];
+  };
+
+  float accum[RowFrags][ColFrags][4];
+#pragma unroll
+  for (int i = 0; i < RowFrags; ++i) {
+#pragma unroll
+    for (int j = 0; j < ColFrags; ++j) {
+#pragma unroll
+      for (int e = 0; e < 4; ++e) {
+        accum[i][j][e] = 0.0f;
+      }
+    }
+  }
+
+  Staged next;
+  load_global(0, next);
+  store_shared(next, 0);
+  __syncthreads();
+
+  for (int step = 0; step < steps; ++step) {
+    const int stage = step & 1;
+    if (step + 1 < steps) {
+      load_global(step + 1, next);
+    }
+#pragma unroll
+    for (int half_k = 0; half_k < kBlockK / 16; ++half_k) {
+      uint32_t a[RowFrags][4];
+#pragma unroll
+      for (int i = 0; i < RowFrags; ++i) {
+        const int row = warp_m * WarpM + i * 16 + (lane & 15);
+        const int chunk = half_k * 2 + (lane >> 4);
+        ldmatrix_x4(a[i],
+                    shared_address(&a_shared[stage][swizzled(row, chunk)]));
+      }
+      uint32_t b[ColFrags][2];
+#pragma unroll
+      for (int j = 0; j < ColFrags; j += 2) {
+        const int row =
+            warp_n * WarpN + j * 8 + (lane & 7) + ((lane >> 4) << 3);
+        const int chunk = half_k * 2 + ((lane >> 3) & 1);
+        uint32_t r[4];
+        ldmatrix_x4(r, shared_address(&b_shared[stage][swizzled(row, chunk)]));
+        b[j][0] = r[0];
+        b[j][1] = r[1];
+        b[j + 1][0] = r[2];
+        b[j + 1][1] = r[3];
+      }
+#pragma unroll
+      for (int i = 0; i < RowFrags; ++i) {
+#pragma unroll
+        for (int j = 0; j < ColFrags; ++j) {
+          mma_m16n8k8(accum[i][j], a[i][0], a[i][1], b[j][0]);
+          mma_m16n8k8(accum[i][j], a[i][2], a[i][3], b[j][1]);
+        }
+      }
+    }
+    if (step + 1 < steps) {
+      store_shared(next, stage ^ 1);
+    }
+    __syncthreads();
+  }
+
+  const int group = lane >> 2;
+  const int pair = lane & 3;
+#pragma unroll
+  for (int i = 0; i < RowFrags; ++i) {
+#pragma unroll
+    for (int half_row = 0; half_row < 2; ++half_row) {
+      const int row = m0 + warp_m * WarpM + i * 16 + group + half_row * 8;
+      if (row >= m) {
+        continue;
+      }
+#pragma unroll
+      for (int j = 0; j < ColFrags; ++j) {
+        const int col = n0 + warp_n * WarpN + j * 8 + pair * 2;
+        const float x = accum[i][j][half_row * 2];
+        const float y = accum[i][j][half_row * 2 + 1];
+        if (splits == 1) {
+          *reinterpret_cast<half2*>(output + static_cast<size_t>(row) * n +
+                                    col) = __floats2half2_rn(x, y);
+        } else {
+          *reinterpret_cast<float2*>(
+              partials + (static_cast<size_t>(split) * m + row) * n + col) =
+              make_float2(x, y);
+        }
+      }
+    }
+  }
+}
+
+__global__ void fp8_qpn8_split_reduce_sm75_kernel(
+    const float2* __restrict__ partials, half2* __restrict__ output, int pairs,
+    int splits) {
+  const int index = blockIdx.x * blockDim.x + threadIdx.x;
+  if (index >= pairs) {
+    return;
+  }
+  float2 sum = partials[index];
+  for (int s = 1; s < splits; ++s) {
+    const float2 value = partials[static_cast<size_t>(s) * pairs + index];
+    sum.x += value.x;
+    sum.y += value.y;
+  }
+  output[index] = __floats2half2_rn(sum.x, sum.y);
+}
+
+template <int BlockM, int WarpsM, int MinBlocks, bool RowGroupScales>
+void launch_fp8_qpn8_mma_sm75(torch::Tensor& out, const torch::Tensor& input,
+                              const torch::Tensor& codes,
+                              const torch::Tensor& group_scales, int splits,
+                              cudaStream_t stream) {
+  const int m = static_cast<int>(input.size(0));
+  const int k = static_cast<int>(input.size(1));
+  const int n = static_cast<int>(codes.size(1));
+  torch::Tensor partials;
+  if (splits > 1) {
+    partials =
+        torch::empty({splits, m, n}, input.options().dtype(torch::kFloat32));
+  }
+  const dim3 grid((n / kBlockN) * ((m + BlockM - 1) / BlockM), 1, splits);
+  fp8_qpn8_mma_sm75_kernel<BlockM, WarpsM, MinBlocks, RowGroupScales>
+      <<<grid, kThreads, 0, stream>>>(
+          reinterpret_cast<const half*>(input.data_ptr<at::Half>()),
+          reinterpret_cast<const uint4*>(codes.data_ptr<uint8_t>()),
+          reinterpret_cast<const half*>(group_scales.data_ptr<at::Half>()),
+          reinterpret_cast<half*>(out.data_ptr<at::Half>()),
+          splits > 1 ? partials.data_ptr<float>() : nullptr, m, n, k, splits);
+  if (splits > 1) {
+    const int pairs = m * n / 2;
+    constexpr int kReduceThreads = 256;
+    fp8_qpn8_split_reduce_sm75_kernel<<<(pairs + kReduceThreads - 1) /
+                                            kReduceThreads,
+                                        kReduceThreads, 0, stream>>>(
+        reinterpret_cast<const float2*>(partials.data_ptr<float>()),
+        reinterpret_cast<half2*>(out.data_ptr<at::Half>()), pairs, splits);
+  }
+}
+
+// Resident CTAs per SM of one kernel instance. Every SM75 device has the same
+// register file, shared memory and thread limits, so one answer per process
+// holds for all of them.
+template <int BlockM, int WarpsM, int MinBlocks>
+int resident_ctas_per_sm() {
+  static const int ctas = [] {
+    int blocks = 0;
+    AT_CUDA_CHECK(cudaOccupancyMaxActiveBlocksPerMultiprocessor(
+        &blocks, fp8_qpn8_mma_sm75_kernel<BlockM, WarpsM, MinBlocks, false>,
+        kThreads, 0));
+    return blocks;
+  }();
+  return ctas;
+}
+
+struct TileChoice {
+  int block_m;
+  int splits;
+};
+
+// Wave model: resident waves x K blocks per CTA x per-slot cost of one 128-deep
+// K block, plus the split-K partials' traffic. Per-tile costs (relative to
+// 16 rows) and the reduction weight were fitted on a Quadro RTX 8000 over the
+// Qwen3.8-27B TP2 projections at M=1..512 (2026-10-20): the choice is 1.9 %
+// behind the measured best tile and split on average, 15.7 % at worst. Ties
+// keep fewer splits, then fewer rows.
+TileChoice choose_tile(int64_t m, int64_t n, int64_t k, int sms) {
+  constexpr int kBlockMs[] = {16, 32, 64, 128};
+  constexpr double kSlotBlockCost[] = {1.0, 1.1, 1.5, 2.6};
+  constexpr double kReductionCost = 2.4;
+  const int resident[] = {
+      resident_ctas_per_sm<16, 1, 2>(), resident_ctas_per_sm<32, 2, 2>(),
+      resident_ctas_per_sm<64, 2, 2>(), resident_ctas_per_sm<128, 2, 2>()};
+  const int64_t k_blocks = k / 128;
+  const int64_t max_splits = std::min<int64_t>(16, k_blocks);
+  TileChoice best{16, 1};
+  double best_cost = -1.0;
+  for (int splits = 1; splits <= max_splits; ++splits) {
+    for (int i = 0; i < 4; ++i) {
+      const int block_m = kBlockMs[i];
+      if (block_m > std::max<int64_t>(16, 2 * m)) {
+        continue;
+      }
+      const int64_t slots = int64_t{resident[i]} * sms;
+      const int64_t ctas =
+          (n / kBlockN) * ((m + block_m - 1) / block_m) * splits;
+      const int64_t waves = (ctas + slots - 1) / slots;
+      const int64_t blocks_per_cta = (k_blocks + splits - 1) / splits;
+      double cost = static_cast<double>(waves * blocks_per_cta) *
+                    kSlotBlockCost[i] * static_cast<double>(slots) /
+                    resident[0];
+      if (splits > 1) {
+        cost += kReductionCost * (splits + 1) * static_cast<double>(m * n) /
+                (128.0 * 128.0);
+      }
+      if (best_cost < 0.0 || cost < best_cost) {
+        best_cost = cost;
+        best = TileChoice{block_m, splits};
+      }
+    }
+  }
+  return best;
+}
