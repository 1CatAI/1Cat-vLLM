+      for (int i = 0; i < 4; i++) {
+        float v = s[nt][i] * scale_log2;
+        if (masked) {
+          const int key = j0 + nt * 8 + 2 * quad + (i & 1);
+          if (key > qpos[i >> 1] || key >= seqlen_k) v = -INFINITY;
+        }
