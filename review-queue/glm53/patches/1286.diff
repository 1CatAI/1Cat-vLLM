@@ -0,0 +1,229 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""ModelOpt ``csf_32x2_v1`` NVFP4 block scales: lossless decode and encode.
+
+A scale matrix of R rows by C groups (C = K / 16) is stored as five tensors:
+``bases`` (u8 [R]), ``codes`` (u8 [R*C/2], four-bit offsets), ``page_bases``
+(u32 [P]), ``offsets`` (u16 [B+P]) and ``exceptions`` (u16 records). A block
+is 32 rows by one column pair, a tile 4 block rows by 2 column pairs, a page
+32 tiles. Blocks are streamed tile by tile (tiles row-major); inside a tile
+the first column pair's block rows come first. A scale byte is its row's base
+plus its offset unless an exception record (value << 8 | 2*row + column within
+the block) replaces it. Each block owns the records ``offsets[e]..offsets[e+1]``
+counted from its page's origin ``page_bases[page] / 2``; every page adds one
+terminal offset.
+
+Reference: local-inference-lab ``docs/csf-scale-blocks.md`` as implemented by
+TensorFold (Apache-2.0),
+https://github.com/ashhart/TensorFold/blob/main/zig/src/core/nvfp4_csf32.zig
+"""
+
+from dataclasses import dataclass
+from functools import lru_cache
+
+import numpy as np
+import torch
+
+BLOCK_ROWS = 32
+TILE_BLOCK_ROWS = 4
+TILE_PAIRS = 2
+PAGE_TILES = 32
+MAX_BASE = 240
+
+
+@dataclass(frozen=True)
+class Csf32Layout:
+    """Stream order of a scale matrix's blocks, shared by every matrix of a shape.
+
+    Arrays are indexed by the block's position in the stream.
+    """
+
+    rows: int
+    cols: int
+    block_row: np.ndarray  # first row / 32
+    block_pair: np.ndarray  # column pair
+    block_width: np.ndarray  # 2, or 1 for the last pair of an odd column count
+    block_page: np.ndarray
+    field_start: np.ndarray  # first four-bit field of the block in `codes`
+
+    @property
+    def num_blocks(self) -> int:
+        return int(self.block_row.shape[0])
+
+    @property
+    def num_pages(self) -> int:
+        return int(self.block_page[-1]) + 1
+
+
+@lru_cache(maxsize=16)
+def csf32_layout(rows: int, cols: int) -> Csf32Layout:
+    if rows <= 0 or rows % BLOCK_ROWS or cols <= 0:
+        raise ValueError(
+            f"csf_32x2_v1 needs rows % 32 == 0 and cols > 0, got {rows}x{cols}"
+        )
+    block_rows = rows // BLOCK_ROWS
+    pairs = (cols + 1) // 2
+    order_row, order_pair, order_tile = [], [], []
+    tile = 0
+    for tile_row in range(0, block_rows, TILE_BLOCK_ROWS):
+        height = min(TILE_BLOCK_ROWS, block_rows - tile_row)
+        for tile_pair in range(0, pairs, TILE_PAIRS):
+            width = min(TILE_PAIRS, pairs - tile_pair)
+            for at in range(height * width):
+                order_row.append(tile_row + at % height)
+                order_pair.append(tile_pair + at // height)
+                order_tile.append(tile)
+            tile += 1
+    block_row = np.asarray(order_row, dtype=np.int64)
+    block_pair = np.asarray(order_pair, dtype=np.int64)
+    block_width = np.minimum(2, cols - 2 * block_pair)
+    fields = BLOCK_ROWS * block_width
+    field_start = np.concatenate(([0], np.cumsum(fields)[:-1]))
+    return Csf32Layout(
+        rows,
+        cols,
+        block_row,
+        block_pair,
+        block_width,
+        np.asarray(order_tile, dtype=np.int64) // PAGE_TILES,
+        field_start,
+    )
+
+
+def _element_fields(layout: Csf32Layout) -> np.ndarray:
+    """Four-bit field index of every scale, row-major [R, C]."""
+    block_index = np.empty(
+        (layout.rows // BLOCK_ROWS, (layout.cols + 1) // 2), np.int64
+    )
+    block_index[layout.block_row, layout.block_pair] = np.arange(layout.num_blocks)
+    r = np.arange(layout.rows)[:, None]
+    c = np.arange(layout.cols)[None, :]
+    b = block_index[r // BLOCK_ROWS, c // 2]
+    return layout.field_start[b] + (r % BLOCK_ROWS) * layout.block_width[b] + c % 2
+
+
+@lru_cache(maxsize=16)
+def _element_fields_cached(rows: int, cols: int) -> np.ndarray:
+    return _element_fields(csf32_layout(rows, cols))
+
+
+def decode_csf32(
+    bases: torch.Tensor,
+    codes: torch.Tensor,
+    page_bases: torch.Tensor,
+    offsets: torch.Tensor,
+    exceptions: torch.Tensor,
+    rows: int,
+    cols: int,
+) -> torch.Tensor:
+    """Scale bytes [rows, cols] (row-major uint8) of one matrix, on its device.
+
+    Raises ValueError when the parts disagree with the geometry or index.
+    """
+    layout = csf32_layout(rows, cols)
+    device = codes.device
+    bases = bases.view(torch.uint8).reshape(-1)
+    codes = codes.view(torch.uint8).reshape(-1)
+    page_bases = page_bases.view(torch.int32).reshape(-1).long()
+    offsets = offsets.view(torch.int16).reshape(-1).long() & 0xFFFF
+    records = exceptions.view(torch.int16).reshape(-1).long() & 0xFFFF
+    if (
+        bases.numel() != rows
+        or codes.numel() != rows * cols // 2
+        or page_bases.numel() != layout.num_pages
+        or offsets.numel() != layout.num_blocks + layout.num_pages
+    ):
+        raise ValueError(f"csf_32x2_v1 parts disagree with a {rows}x{cols} matrix")
+    if int(bases.max()) > MAX_BASE:
+        raise ValueError("csf_32x2_v1 row base above 240")
+
+    fields = torch.from_numpy(_element_fields_cached(rows, cols)).to(device)
+    nibbles = (codes[fields // 2].long() >> (4 * (fields % 2))) & 0xF
+    out = (bases.long()[:, None] + nibbles).to(torch.uint8)
+
+    block_page = torch.from_numpy(layout.block_page).to(device)
+    entry = torch.arange(layout.num_blocks, device=device) + block_page
+    low, high = offsets[entry], offsets[entry + 1]
+    counts = high - low
+    if bool((counts < 0).any()):
+        raise ValueError("csf_32x2_v1 block prefixes decrease")
+    origin = page_bases[block_page] // 2
+    expected_start = torch.cumsum(counts, 0) - counts
+    if (
+        not torch.equal(origin + low, expected_start)
+        or int(counts.sum()) != records.numel()
+    ):
+        raise ValueError(
+            "csf_32x2_v1 exception index does not cover the records in order"
+        )
+    if records.numel() == 0:
+        return out
+    record_block = torch.repeat_interleave(
+        torch.arange(layout.num_blocks, device=device), counts
+    )
+    at = records & 0xFF
+    width = torch.from_numpy(layout.block_width).to(device)[record_block]
+    if bool(((at // 2 >= BLOCK_ROWS) | (at % 2 >= width)).any()):
+        raise ValueError("csf_32x2_v1 exception outside its block")
+    row = (
+        torch.from_numpy(layout.block_row).to(device)[record_block] * BLOCK_ROWS
+        + at // 2
+    )
+    col = torch.from_numpy(layout.block_pair).to(device)[record_block] * 2 + at % 2
+    out[row, col] = (records >> 8).to(torch.uint8)
+    return out
+
+
+def encode_csf32(scale: np.ndarray) -> dict[str, np.ndarray]:
+    """Parts of a uint8 [R, C] scale matrix, byte-identical to the reference encoder.
+
+    A row's base starts its most covering 16-wide window, the lowest on a tie.
+    Used by the tests; checkpoints arrive encoded.
+    """
+    rows, cols = scale.shape
+    layout = csf32_layout(rows, cols)
+    bases = np.zeros(rows, dtype=np.uint8)
+    for r in range(rows):
+        hist = np.bincount(scale[r], minlength=256)
+        cover = np.convolve(hist, np.ones(16, dtype=np.int64))[15 : 15 + MAX_BASE + 1]
+        bases[r] = int(np.argmax(cover))
+    codes = np.zeros(rows * cols // 2 + (rows * cols) % 2, dtype=np.uint8)
+    page_bases = np.zeros(layout.num_pages, dtype=np.uint32)
+    offsets = np.zeros(layout.num_blocks + layout.num_pages, dtype=np.uint16)
+    exceptions: list[int] = []
+    entry = 0
+    origin = 0
+    previous_page = -1
+    for b in range(layout.num_blocks):
+        page = int(layout.block_page[b])
+        if page != previous_page:
+            if previous_page >= 0:
+                entry += 1
+            origin = len(exceptions)
+            page_bases[page] = 2 * origin
+            offsets[entry] = 0
+            previous_page = page
+        row0 = int(layout.block_row[b]) * BLOCK_ROWS
+        col0 = int(layout.block_pair[b]) * 2
+        width = int(layout.block_width[b])
+        field = int(layout.field_start[b])
+        for r in range(BLOCK_ROWS):
+            base = int(bases[row0 + r])
+            for c in range(width):
+                value = int(scale[row0 + r, col0 + c])
+                if base <= value < base + 16:
+                    offset = value - base
+                else:
+                    exceptions.append(value << 8 | (2 * r + c))
+                    offset = 0
+                codes[field // 2] |= offset << (4 * (field % 2))
+                field += 1
+        entry += 1
+        offsets[entry] = len(exceptions) - origin
+    return {
+        "bases": bases,
+        "codes": codes,
+        "page_bases": page_bases,
+        "offsets": offsets,
+        "exceptions": np.asarray(exceptions, dtype=np.uint16),
+    }
diff --git a/vllm/model_executor/layers/quantization/utils/mxfp8_utils.py b/vllm/model_executor/layers/quantization/utils/mxfp8_utils.py
index a129182253..38adf6347a 100644
--- a/vllm/model_executor/layers/quantization/utils/mxfp8_utils.py
+++ b/vllm/model_executor/layers/quantization/utils/mxfp8_utils.py
@@ -1,6 +1,8 @@
 # SPDX-License-Identifier: Apache-2.0
 # SPDX-FileCopyrightText: Copyright contributors to the vLLM project
 
+from collections.abc import Callable, Iterable, Iterator
+
 import torch
 
 from vllm.utils.torch_utils import direct_register_custom_op
@@ -181,3 +183,103 @@ def xpu_mxfp8_quantize(
     x: torch.Tensor, dtype: torch.dtype | None = None
 ) -> tuple[torch.Tensor, torch.Tensor]:
     return torch.ops.vllm.xpu_mxfp8_quantize(x, dtype)
+
+
+def dequantize_mxfp8_weight_pairs(
+    weights: Iterable[tuple],
+    out_dtype: torch.dtype = torch.bfloat16,
+    keep_quantized: Callable[[str], bool] | None = None,
+) -> Iterator[tuple]:
+    """Yield checkpoint tensors with every MXFP8 weight dequantized.
+
+    An MXFP8 pair is an fp8-e4m3 ``<module>.weight`` and a uint8 E8M0
+    ``<module>.weight_scale`` of shape [N, K/32]; it becomes one
+    ``<module>.weight`` in ``out_dtype``. Other fp8 weights, e.g. block FP8
+    with float32 scales, pass through unchanged, so a model can keep those
+    quantized, and every other tensor passes through too. Items keep any extra
+    fields after (name, tensor). For hardware without MXFP8 kernels (before
+    SM80).
+
+    ``keep_quantized(module)`` names the modules the model holds as MXFP8: all
+    their tensors pass through unchanged, in stream order.
+
+    Every scale is handed on directly after its weight, whatever order the
+    shards store them in: model loaders pair the two inside one
+    ``load_weights`` call, and a split stream (``AutoWeightsLoader`` calls a
+    module once per run of its prefix) would otherwise part them. Apply it to
+    the whole stream, before any split.
+    """
+    pending_weights: dict[str, tuple] = {}
+    pending_scales: dict[str, tuple] = {}
+    # Modules whose unquantized weight already went by: a later scale of
+    # theirs has nothing to wait for.
+    passed: set[str] = set()
+    for item in weights:
+        name, tensor = item[0], item[1]
+        if name.endswith(".weight"):
+            module = name.removesuffix(".weight")
+            if keep_quantized is not None and keep_quantized(module):
+                yield item
+                continue
+            scale = pending_scales.pop(module, None)
+            if tensor.dtype != MXFP8_VALUE_DTYPE:
+                passed.add(module)
+                yield item
+                if scale is not None:
+                    yield scale
+            elif scale is None:
+                pending_weights[module] = item
+            elif scale[1].dtype == MXFP8_SCALE_DTYPE:
+                yield _dequantized_pair(item, scale[1], out_dtype)
+            else:
+                yield item
+                yield scale
+            continue
+        module = _scale_module(name, tensor)
+        if (
+            module is None
+            or module in passed
+            or (keep_quantized is not None and keep_quantized(module))
+        ):
+            yield item
+            continue
+        weight = pending_weights.pop(module, None)
+        if weight is None:
+            pending_scales[module] = item
+        elif tensor.dtype == MXFP8_SCALE_DTYPE:
+            yield _dequantized_pair(weight, tensor, out_dtype)
+        else:
+            yield weight
+            yield item
+    if pending_scales:
+        raise ValueError(
+            f"Weight scales without their weights: {sorted(pending_scales)[:4]}"
+        )
+    yield from pending_weights.values()
+
+
+def _scale_module(name: str, tensor: torch.Tensor) -> str | None:
+    """The module of a scale that belongs next to its weight: an MXFP8 E8M0
+    scale or a float32 (block or per-tensor) FP8 scale. NVFP4's E4M3 block
+    scales and every other tensor are not held."""
+    if tensor.dtype not in (MXFP8_SCALE_DTYPE, torch.float32):
+        return None
+    for suffix in (".weight_scale", ".weight_scale_inv"):
+        if name.endswith(suffix):
+            return name.removesuffix(suffix)
+    return None
+
+
+def _dequantized_pair(weight_item: tuple, scale: torch.Tensor, out_dtype) -> tuple:
+    name, weight = weight_item[0], weight_item[1]
+    if (
+        weight.dim() != 2
+        or scale.dim() != 2
+        or scale.shape[0] != weight.shape[0]
+        or scale.shape[1] * MXFP8_BLOCK_SIZE != weight.shape[1]
+    ):
+        raise ValueError(
+            f"MXFP8 {name}: weight {tuple(weight.shape)} and scale "
+            f"{tuple(scale.shape)} do not form 1x{MXFP8_BLOCK_SIZE} blocks"
+        )
+    return (name, dequant_mxfp8_to_bf16(weight, scale).to(out_dtype), *weight_item[2:])
diff --git a/vllm/model_executor/layers/quantization/utils/s5_scales.py b/vllm/model_executor/layers/quantization/utils/s5_scales.py
new file mode 100644
index 0000000000..24e133a714
--- /dev/null
+++ b/vllm/model_executor/layers/quantization/utils/s5_scales.py
@@ -0,0 +1,115 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Five-bit expert scales ("S5") that the skinny QPN MoE kernels read in place.
+
+A scale raster holds one fp8-e4m3 byte per (tile row, K group): ``[expert][tile
+N/32][group K/16][position 32]``, the layout `qpn_prepack` gives the checkpoint
+scales. The csf_32x2_v1 checkpoint planes are smaller, but a few scales per
+thousand fall outside a row's four-bit window and are patched from a record list,
+which a kernel cannot afford to look up in its loop (one block in six has a
+record). The scale bytes of a row do span a short range, though: outside the layers
+named below, the group scales of GLM-5.3 differ from their row's smallest by at most
+31, and the e4m3 bytes of positive scales order like integers. Five bits per scale
+therefore carry those scales without exceptions:
+
+    scale = base[expert][tile][position] + nibble + 16 * high
+
+``nibble`` is four bits, two groups per byte (``nib``: low nibble the even group),
+``high`` one bit per (group, position), a 32-bit word per (tile, group) (``hi``).
+Positions are the raster positions of the card's fragment order, so a lane
+reads the bytes it would read from the raster and decodes them with three integer
+operations. The planes take 5/8 of the raster, and no raster has to exist for the
+experts of a layer.
+
+Not every layer fits: the last MoE layers of GLM-5.3 have rows that span up to 56
+(layers 43 and 44; a few rows in layers 36, 40 to 42). `scale_spread` tells, and a
+projection that does not fit keeps its csf planes.
+"""
+
+from dataclasses import dataclass
+
+import torch
+
+S5_MAX_SPREAD = 31
+# Experts per encoding step: bounds the temporaries of the load-time conversion.
+_ENCODE_EXPERTS = 16
+
+
+@dataclass
+class S5Scales:
+    """One projection set's scale planes; ``tiles`` are N/32 tiles per expert."""
+
+    groups: int
+    base: torch.Tensor  # u8 [E, tiles, 32]
+    nib: torch.Tensor  # u8 [E, tiles, groups / 2, 32]
+    hi: torch.Tensor  # i32 [E, tiles, groups]
+
+    @property
+    def num_experts(self) -> int:
+        return self.base.shape[0]
+
+    @property
+    def tiles(self) -> int:
+        return self.base.shape[1]
+
+
+def scale_spread(raster: torch.Tensor, groups: int) -> int:
+    """The widest span, over all rows, between a row's largest and smallest scale
+    in a u8 scale raster [E, tiles * groups * 32] (kernel positions)."""
+    experts = raster.shape[0]
+    widest = 0
+    for first in range(0, experts, _ENCODE_EXPERTS):
+        r = raster[first : first + _ENCODE_EXPERTS].reshape(-1, groups, 32)
+        widest = max(widest, int((r.amax(dim=1) - r.amin(dim=1)).max()))
+    return widest
+
+
+def encode_s5(raster: torch.Tensor, groups: int) -> S5Scales:
+    """Encode a u8 scale raster [E, tiles * groups * 32] (kernel positions).
+
+    Raises if a row of any expert spans more than `S5_MAX_SPREAD` between its
+    smallest and largest scale: the five-bit code would not carry it.
+    """
+    if raster.dtype != torch.uint8 or groups % 2:
+        raise ValueError("S5 encodes a u8 raster with an even group count")
+    experts = raster.shape[0]
+    tiles = raster.numel() // (experts * groups * 32)
+    if tiles * groups * 32 * experts != raster.numel():
+        raise ValueError("raster size is not experts x tiles x groups x 32")
+    device = raster.device
+    base = torch.empty(experts, tiles, 32, dtype=torch.uint8, device=device)
+    nib = torch.empty(experts, tiles, groups // 2, 32, dtype=torch.uint8, device=device)
+    hi = torch.empty(experts, tiles, groups, dtype=torch.int32, device=device)
+    bit_weights = (1 << torch.arange(8, device=device)).to(torch.uint8)
+    widest = 0
+    for first in range(0, experts, _ENCODE_EXPERTS):
+        last = min(first + _ENCODE_EXPERTS, experts)
+        r = raster[first:last].reshape(last - first, tiles, groups, 32)
+        low = r.amin(dim=2)
+        delta = r - low[:, :, None, :]
+        widest = max(widest, int(delta.max()))
+        base[first:last] = low
+        nibbles = delta & 15
+        nib[first:last] = nibbles[:, :, 0::2] | (nibbles[:, :, 1::2] << 4)
+        # bit p of a (tile, group) word is position p's high bit
+        high = (delta >> 4).reshape(last - first, tiles, groups, 4, 8)
+        hi[first:last] = (
+            (high * bit_weights).sum(dim=-1, dtype=torch.uint8).view(torch.int32)
+        ).reshape(last - first, tiles, groups)
+    if widest > S5_MAX_SPREAD:
+        raise ValueError(
+            f"a scale row spans {widest} above its smallest scale, the five-bit "
+            f"code carries {S5_MAX_SPREAD}"
+        )
+    return S5Scales(groups=groups, base=base, nib=nib, hi=hi)
+
+
+def decode_s5(scales: S5Scales) -> torch.Tensor:
+    """The u8 raster [E, tiles, groups, 32] an `S5Scales` stands for."""
+    experts, tiles, groups = scales.num_experts, scales.tiles, scales.groups
+    device = scales.base.device
+    nibbles = torch.stack((scales.nib & 15, scales.nib >> 4), dim=3)
+    nibbles = nibbles.reshape(experts, tiles, groups, 32)
+    positions = torch.arange(32, device=device, dtype=torch.int32)
+    high = ((scales.hi[..., None] >> positions) & 1).to(torch.uint8)
+    return scales.base[:, :, None, :] + nibbles + 16 * high
