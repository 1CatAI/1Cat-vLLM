+    norm_weight = torch.randn((hidden_size,), device=device, dtype=torch.float16).mul_(
+        0.1
+    )
+    args = (x, residual, post_mix, comb_mix, fn, scale, base, 1e-6, 1e-6, 1e-6, 1.0, 20)
+    kwargs = dict(norm_weight=norm_weight, norm_eps=1e-6)
