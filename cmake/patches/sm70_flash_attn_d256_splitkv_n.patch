+                    && partial_max.numel() == 3 * rows
+                    && partial_sum.numel() == 3 * rows,
+                "split-KV3 workspace shapes are invalid");
+    return sm70_d256_splitd_dense_splitkv_fwd(
+        q, k, v, partial_out, partial_max, partial_sum, out, softmax_scale,
+        causal, 3);
+}
