+// Merges any number of KV splits. The split-KV3 route keeps its own merge
+// so its rounding order is unchanged.
+template <typename Element>
+__global__ __launch_bounds__(Sm70D256SplitDTraits::kHeadDim, 1)
+void sm70_d256_splitkv_merge_kernel(
+    const float *__restrict__ partial_out,
+    const float *__restrict__ partial_max,
+    const float *__restrict__ partial_sum,
+    Element *__restrict__ out,
+    int64_t rows,
+    int num_splits,
+    float softmax_scale_log2) {
+    const int64_t row = blockIdx.x;
+    const int d = threadIdx.x;
+    __shared__ float scales[Sm70D256SplitDTraits::kMaxKVSplits];
+    __shared__ float inv_denominator;
+    if (d == 0) {
+        float global_max = -INFINITY;
+        for (int split = 0; split < num_splits; ++split) {
+            global_max = fmaxf(global_max, partial_max[split * rows + row]);
+        }
+        float denominator = 0.0f;
+        for (int split = 0; split < num_splits; ++split) {
+            const float scale = exp2f(
+                (partial_max[split * rows + row] - global_max)
+                * softmax_scale_log2);
+            scales[split] = scale;
+            denominator += partial_sum[split * rows + row] * scale;
+        }
+        inv_denominator = 1.0f / denominator;
+    }
+    __syncthreads();
+
+    const int64_t element = row * Sm70D256SplitDTraits::kHeadDim + d;
+    const int64_t split_stride = rows * Sm70D256SplitDTraits::kHeadDim;
+    float numerator = 0.0f;
+    for (int split = 0; split < num_splits; ++split) {
+        numerator += partial_out[split * split_stride + element] * scales[split];
+    }
+    out[element] = Element(numerator * inv_denominator);
+}
